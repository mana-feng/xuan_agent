<template>
	<tm-app>
		<view class="app-shell">
			<yx-nav-header></yx-nav-header>
			<view class="app-main">
					<view class="page-shell">
					<view class="page-card history-card theme-card-glass">
						<view class="page-title-wrapper history-header">
							<view class="form-header-icon">
								<tm-icon name="tmicon-md-time" :font-size="40" color="#667eea"></tm-icon>
							</view>
							<view class="form-header-text">
								<h1 class="page-title">历史排盘</h1>
								<p class="page-subtitle">查看、筛选并管理已保存的排盘</p>
							</view>
							<view class="header-actions">
								<yx-teal-button
									size="small"
									:round="12"
									:padding="[18, 18]"
									icon="tmicon-md-refresh"
									label="刷新"
									@tap="fetchCharts"
								></yx-teal-button>
							</view>
						</view>

						<view class="section filters-card">
								<header class="section__header">
									<tm-icon name="tmicon-md-search" :font-size="26" color="#667eea"></tm-icon>
									<h2 class="section__title">筛选与排序</h2>
								</header>
								<view class="section__body filters-grid">
									<view class="filter-block search-block">
										<tm-input
											v-model="searchKeyword"
											prefix="tmicon-md-search"
											placeholder="搜索姓名..."
											clearable
											:round="12"
											:border="1"
											@input="onSearchInput"
										></tm-input>
									</view>
									<view class="filter-block">
										<tm-text :font-size="22" color="#666666" label="性别：" class="mb-6"></tm-text>
										<tm-radio-group v-model="genderFilter">
											<tm-radio label="全部" :value="''"></tm-radio>
											<tm-radio label="男" :value="'0'"></tm-radio>
											<tm-radio label="女" :value="'1'"></tm-radio>
										</tm-radio-group>
									</view>
									<view class="filter-block">
										<tm-text :font-size="22" color="#666666" label="排序：" class="mb-6"></tm-text>
										<tm-segtab
											v-model="sortByIndex"
											:list="[
												{ text: '时间' },
												{ text: '姓名' }
											]"
											:margin="[0, 0]"
											:width="260"
										></tm-segtab>
									</view>
									<view class="filter-actions">
										<yx-teal-button
											size="small"
											:padding="[16, 14]"
											:round="12"
											:label="sortOrder === 'DESC' ? '↓ 降序' : '↑ 升序'"
											@tap="toggleSortOrder"
										></yx-teal-button>
										<yx-teal-button
											v-if="searchKeyword || genderFilter"
											size="small"
											:padding="[16, 14]"
											:round="12"
											label="清除筛选"
											@tap="clearFilters"
										></yx-teal-button>
										<tm-text
											v-if="totalCount > 0"
											class="filters-count"
											:font-size="22"
											color="#999999"
											:label="`共找到${totalCount} 条记录`"
										></tm-text>
									</view>
								</view>
							</view>

							<view v-if="loading" class="py-20 text-center">
								<tm-text label="加载中..." color="#999999"></tm-text>
							</view>
							<view v-else-if="charts.length === 0" class="py-20 text-center">
								<tm-text 
									:label="searchKeyword || genderFilter ? '未找到符合条件的记录' : '暂无保存记录，可在排盘结果页点击「保存」哦'" 
									color="#999999"
								></tm-text>
							</view>
							<view v-else class="records-list">
								<tm-sheet
									v-for="item in charts"
									:key="(item.type || 'bazi') + ':' + item.id"
									:round="16"
									:shadow="2"
									:margin="[0, 0]"
									:padding="[24, 20]"
									class="record-card"
								>
									<view class="record-card__header">
										<view class="record-meta">
											<tm-text
												:bold="true"
												:font-size="30"
												color="#2d3748"
												:label="item.title || '未命名'"
												_class="text-overflow-1"
											></tm-text>
											<tm-text
												class="mt-6"
												:font-size="26"
												color="#718096"
												:label="formatBirth(item) || ''"
												_class="text-overflow-1"
											></tm-text>
											<view class="record-meta__row">
												<tm-text
													:font-size="22"
													color="#a0aec0"
													:label="getTypeLabel(item.type)"
												></tm-text>
												<tm-text
													:font-size="22"
													color="#a0aec0"
													:label="'保存时间：' + (item.createdAtLabel || '')"
												></tm-text>
												<tm-text
													v-if="item.gender !== null && item.gender !== undefined"
													class="ml-12"
													:font-size="22"
													color="#a0aec0"
													:label="getGenderDisplayLabel(item.gender)"
												></tm-text>
											</view>
										</view>
										<view class="record-actions">
											<yx-teal-button
												size="mini"
												:padding="[12, 16]"
												:round="12"
												label="查看"
												@tap="openChart(item)"
											></yx-teal-button>
											<yx-teal-button
												size="mini"
												:padding="[12, 16]"
												:round="12"
												label="删除"
												@tap="removeChart(item)"
											></yx-teal-button>
										</view>
									</view>
								</tm-sheet>
							</view>
							<view v-if="error" class="mt-10">
								<tm-text :label="error" color="red"></tm-text>
							</view>
					</view>
				</view>
			</view>
		</view>
	</tm-app>
</template>

<script lang="ts" setup>
import { ref, computed, onMounted, watch } from 'vue';
import { onShow } from '@dcloudio/uni-app';
import { useUserStore } from '@/store/user';
import { useBaziStore } from '@/store/bazi';
import { useLiuyaoStore } from '@/store/liuyao';
import { useZiweiStore } from '@/store/ziwei';
import { readChartRecords, removeChartRecord, type ChartType } from '@/utils/localChartRecords';
import { chartTimestamp } from '@/utils/chartContext';
import { compileNajia, buildDisplayData } from '@/features/liuyao/najiaCore';
import { Solar } from 'lunar-javascript';
import utils from '@/libs/utils/utils';

interface ChartItem {
	id: number;
	title: string;
	gender?: string | null;
	birthDatetime: string | number;
	createdAt: string;
	createdAtLabel?: string;
	type?: string;
	rawPayload?: any;
}

const user_store = useUserStore();
const bazi_store = useBaziStore();

const charts = ref<ChartItem[]>([]);
const loading = ref(false);
const error = ref('');
const totalCount = ref(0);

const searchKeyword = ref('');
const genderFilter = ref('');
const sortByIndex = ref(0); // 0: 时间, 1: 姓名
const sortBy = computed(() => (sortByIndex.value === 0 ? 'created_at' : 'name'));
const sortOrder = ref<'ASC' | 'DESC'>('DESC');

let searchTimer: any = null;

function getGenderDisplayLabel(gender: any): string {
	if (gender === '0' || gender === 0) {
		return '男';
	} else if (gender === '1' || gender === 1) {
		return '女';
	} else {
		return '未知';
	}
}

function getTypeLabel(type?: string): string {
	const map: Record<string, string> = { bazi: '八字', ziwei: '紫微', liuyao: '六爻' };
	return map[type || 'bazi'] || '八字';
}

watch([genderFilter, sortByIndex, sortOrder], () => {
	fetchCharts();
});

onMounted(() => {
	fetchCharts();
});

onShow(fetchCharts);

function onSearchInput() {
	if (searchTimer) {
		clearTimeout(searchTimer);
	}
	searchTimer = setTimeout(() => {
		fetchCharts();
	}, 500);
}

function toggleSortOrder() {
	sortOrder.value = sortOrder.value === 'DESC' ? 'ASC' : 'DESC';
}

function clearFilters() {
	searchKeyword.value = '';
	genderFilter.value = '';
	sortByIndex.value = 0;
	sortOrder.value = 'DESC';
	fetchCharts();
}

async function fetchCharts() {
	loading.value = true;
	error.value = '';

	try {
		const baziRecords = readChartRecords('bazi');
		const ziweiRecords = readChartRecords('ziwei');
		const liuyaoRecords = readChartRecords('liuyao');

		baziRecords.forEach(r => { if (!r.type) r.type = 'bazi'; });
		ziweiRecords.forEach(r => { r.type = 'ziwei'; });
		liuyaoRecords.forEach(r => { r.type = 'liuyao'; });

		let filtered = [...baziRecords, ...ziweiRecords, ...liuyaoRecords];

		if (searchKeyword.value) {
			const kw = searchKeyword.value.trim().toLowerCase();
			filtered = filtered.filter(r => (r.title || '').toLowerCase().includes(kw));
		}

		if (genderFilter.value) {
			filtered = filtered.filter(r => String(r.gender) === genderFilter.value);
		}

		if (sortBy.value === 'name') {
			filtered.sort((a, b) => (a.title || '').localeCompare(b.title || ''));
		} else {
			filtered.sort((a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime());
		}

		if (sortOrder.value === 'DESC') {
			filtered.reverse();
		}

		charts.value = filtered.map(it => ({
			...it,
			createdAtLabel: formatDateTime(it.createdAt || '')
		}));
		totalCount.value = charts.value.length;
	} catch (e: any) {
		console.error('获取历史记录失败:', e);
		error.value = '读取本地记录失败';
		charts.value = [];
		totalCount.value = 0;
	} finally {
		loading.value = false;
	}
}

/**
 * 公告缓存与拉取
 */
function formatDateTime(iso: string) {
	if (!iso) return '';
	try {
		const d = new Date(iso);
		if (isNaN(d.getTime())) {
			return '';
		}
		return utils.HideSecond(d.getTime()) || '';
	} catch (e) {
		return '';
	}
}

function formatBirth(item: ChartItem) {
	if (!item) return '';
	try {
		const timestamp = chartTimestamp(item.birthDatetime);
		if (timestamp === null) return '';
		const d = new Date(timestamp);
		if (isNaN(d.getTime())) {
			return '';
		}
		const result = utils.HideSecond(d.getTime());
		return result ? (item.type === 'liuyao' ? '起卦：' : '出生：') + result : '';
	} catch (e) {
		return '';
	}
}

function openChart(item: ChartItem) {
	try {
		if (item.type === 'ziwei') {
			openZiweiChart(item);
			return;
		}
		if (item.type === 'liuyao') {
			openLiuyaoChart(item);
			return;
		}
		openBaziChart(item);
	} catch (e: any) {
		uni.hideLoading();
		uni.showToast({
			title: '打开排盘记录失败：' + (e?.message || '未知错误'),
			icon: 'none',
			duration: 2000
		});
	}
}

function recordInput(item: ChartItem) {
	const timestamp = chartTimestamp(item.birthDatetime);
	if (timestamp === null) throw new Error('记录中的时间无效');
	return { realname: item.title || '佚名', gender: Number(item.gender) === 1 ? 1 : 0, timestamp, recordId: item.id };
}

function openZiweiChart(item: ChartItem) {
	const input = recordInput(item);
	useZiweiStore().pull(input);
	user_store.set(input);
	const selection = item.rawPayload?.selection;
	if (selection && ['origin', 'decadal', 'yearly', 'monthly', 'daily'].includes(selection.viewMode)) {
		useZiweiStore().setTimelineSelection({ mode: selection.viewMode, date: selection.targetDate });
	}
	uni.navigateTo({ url: '/pages/ziwei/result' });
}

function openLiuyaoChart(item: ChartItem) {
	const rp = item.rawPayload;
	if (!rp) throw new Error('该记录缺少排盘数据');
	const store = useLiuyaoStore();
	if (rp.lite && Array.isArray(rp.params) && rp.params.length === 6) {
		// Legacy saves used save time for options.date; profile retains the actual cast time.
		const timestamp = chartTimestamp(rp.profile?.timeLabel) ?? chartTimestamp(rp.options?.date) ?? chartTimestamp(item.birthDatetime);
		if (timestamp === null) throw new Error('起卦时间无效');
		const date = new Date(timestamp);
		const compiled = compileNajia(rp.params, { ...rp.options, date, solar: Solar.fromDate(date), guaci: true });
		const display = buildDisplayData(compiled);
		const profile = rp.profile || {
			title: item.title, gender: Number(item.gender) === 1 ? '女' : '男', method: '历史记录',
			dayGanZhi: compiled.dayGz, timeLabel: utils.HideSecond(timestamp), focus: item.title,
		};
		store.setResult({ compiled, display, profile, createdAt: rp.ts ?? Date.now(), recordId: item.id });
	} else if (rp.profile && rp.compiled && rp.display) {
		store.setResult({ compiled: rp.compiled, display: rp.display, profile: rp.profile, createdAt: rp.ts ?? Date.now(), recordId: item.id });
	} else throw new Error('该记录数据格式无法恢复');
	uni.navigateTo({ url: '/pages/liuyao/result' });
}

function openBaziChart(item: ChartItem) {
	const input = recordInput(item);
	// Recompute library objects and Yun data; serialized snapshots lose their methods.
	bazi_store.pull(input);
	user_store.set(input);
	uni.navigateTo({ url: '/pages/index/detail' });
}

function removeChart(item: ChartItem) {
	uni.showModal({
		title: '删除确认',
		content: '确定要删除这条排盘记录吗？',
		success(res) {
			if (res.confirm) {
				doRemove(item);
			}
		}
	});
}

async function doRemove(item: ChartItem) {
	try {
		const type = (item.type || 'bazi') as ChartType;
		removeChartRecord(type, item.id);
		charts.value = charts.value.filter(c => c.id !== item.id || (c.type || 'bazi') !== type);
		totalCount.value = charts.value.length;
		uni.showToast({ title: '已删除', icon: 'none', duration: 1500 });
	} catch (e: any) {
		console.error('删除失败:', e);
		error.value = '删除失败';
	}
}

function goToHome() {
	uni.reLaunch({
		url: '/pages/agent/index'
	});
}
</script>

