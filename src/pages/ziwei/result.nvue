.page-ziwei-result .palace-zoom-content :deep(.star-bright),
.page-ziwei-result .palace-zoom-content :deep(.star-mutagen-inline),
.page-ziwei-result .palace-zoom-content :deep(.scope-mutagen-tag) {
	font-size: 14px;
}

.page-ziwei-result .palace-zoom-content :deep(.center-col) {
	width: 132px;
	gap: 4px;
}

.page-ziwei-result .palace-zoom-content :deep(.dynamic-star-tag) {
	font-size: 12px;
	padding: 2px 6px;
}

.page-ziwei-result .palace-zoom-content :deep(.palace-name) {
	font-size: 28px;
	line-height: 1.2;
}

.page-ziwei-result .palace-zoom-content :deep(.palace-life),
.page-ziwei-result .palace-zoom-content :deep(.body-palace),
.page-ziwei-result .palace-zoom-content :deep(.palace-decade),
.page-ziwei-result .palace-zoom-content :deep(.palace-ages) {
	font-size: 14px;
}

.page-ziwei-result .palace-zoom-content :deep(.stem),
.page-ziwei-result .palace-zoom-content :deep(.branch),
.page-ziwei-result .palace-zoom-content :deep(.fly-text) {
	font-size: 18px;
}

@media (max-width: 719px) {
	.page-ziwei-result .palace-zoom-panel {
		width: 96vw;
		height: 82vh;
	}

	.page-ziwei-result .palace-zoom-content :deep(.star-name) {
		font-size: 14px;
	}

	.page-ziwei-result .palace-zoom-content :deep(.palace-name) {
		font-size: 22px;
	}
}

.page-ziwei-result {
	color: var(--x-body);
	font-family: var(--x-sans);
}
.page-ziwei-result .result-container {
	gap: 22px;
}
.page-ziwei-result .section {
	padding: 24px;
	border-color: var(--x-line);
	border-radius: 14px;
	box-shadow: none;
	background: var(--x-paper);
}
.page-ziwei-result .section__header {
	padding-bottom: 0;
	margin-bottom: 18px;
	border: 0;
}
.page-ziwei-result .section__title {
	font-family: var(--x-serif);
	font-size: 22px;
	font-weight: 500;
	color: var(--x-ink);
}
.page-ziwei-result .info-summary {
	background: var(--x-gradient-soft);
	padding: 20px 24px;
}
.page-ziwei-result .info-summary .section__header {
	display: none;
}
.page-ziwei-result .info-grid {
	display: grid;
	grid-template-columns: 1fr 1.2fr 1fr;
	gap: 20px;
}
.page-ziwei-result .info-group {
	min-width: 0;
	display: grid;
	grid-template-columns: max-content minmax(0, 1fr);
	align-content: start;
	align-items: baseline;
	gap: 10px 12px;
}
.page-ziwei-result .info-group + .info-group {
	padding-left: 20px;
	border-left: 1px solid var(--x-line);
}
.page-ziwei-result .summary-label {
	font-size: 12px;
	line-height: 22px;
	font-weight: 400;
	color: var(--x-muted);
	white-space: nowrap;
}
.page-ziwei-result .summary-value {
	min-width: 0;
	font-size: 14px;
	line-height: 22px;
	font-weight: 500;
	color: var(--x-ink);
	font-variant-numeric: tabular-nums;
	overflow-wrap: anywhere;
}
.page-ziwei-result .chart-grid {
	border-color: var(--x-line);
	border-radius: 10px;
	box-shadow: none;
}
.page-ziwei-result .chart-cell {
	border-color: var(--x-line);
}
.page-ziwei-result .cell-focused {
	border-color: var(--x-accent);
}
.page-ziwei-result .center-info {
	background: var(--x-gradient-soft);
	border-color: var(--x-line);
}
.page-ziwei-result .info-name {
	font-family: var(--x-serif);
	color: var(--x-ink);
}
.page-ziwei-result .scope-info {
	background: var(--x-tint);
}
.page-ziwei-result .palace-zoom-header {
	background: var(--x-gradient-soft);
}
.page-ziwei-result .palace-zoom-body {
	background: var(--x-paper);
}

.result-actions {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 8px;
}
.result-button {
	margin: 0;
	min-height: 40px;
	display: inline-flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	padding: 9px 17px;
	font-family: var(--x-sans);
	font-size: 12px;
	line-height: 1.5;
	color: var(--x-body);
	border: 1px solid var(--x-line);
	border-radius: 8px;
	background: var(--x-paper);
	cursor: pointer;
}
.result-button::after {
	border: 0;
}
.result-button.primary {
	background: var(--x-gradient);
	border-color: transparent;
	color: #fff;
}
.result-button:disabled {
	opacity: 0.5;
	cursor: default;
}
.result-button:focus-visible {
	outline: 2px solid var(--x-accent);
	outline-offset: 3px;
}
.result-reading {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 16px;
	padding: 28px;
	border: 1px solid var(--x-line);
	border-radius: 14px;
	background: var(--x-gradient-soft);
}
.result-eyebrow {
	color: var(--x-muted);
	font-size: 10px;
	letter-spacing: 0.12em;
}
.result-reading h2 {
	margin: 0;
	font-family: var(--x-serif);
	font-weight: 500;
	font-size: 25px;
	line-height: 1.6;
	color: var(--x-ink);
}
.result-reading p {
	margin: 0;
	font-size: 12px;
	line-height: 1.9;
	color: var(--x-muted);
}
.result-reading .result-button {
	width: 100%;
	box-sizing: border-box;
}
.result-note {
	color: var(--x-muted);
	font-size: 11px;
	line-height: 1.8;
}
@media (max-width: 600px) {
	.result-actions {
		width: 100%;
	}
	.result-actions .result-button {
		flex: 1;
		padding: 9px 11px;
		font-size: 11px;
		white-space: nowrap;
	}
	.result-reading {
		padding: 22px;
	}
	.result-reading h2 {
		font-size: 23px;
	}
}

.page-ziwei-result .result-reading {
	display: grid;
	grid-template-columns: minmax(0, 1fr) auto;
	gap: 10px 32px;
}
.page-ziwei-result .result-reading h2,
.page-ziwei-result .result-reading p {
	grid-column: 1;
}
.page-ziwei-result .result-reading .result-button {
	grid-column: 2;
	grid-row: 2;
}
.page-ziwei-result .result-reading .result-note {
	grid-column: 2;
	grid-row: 3;
	text-align: center;
}
@media (max-width: 720px) {
	.page-ziwei-result .section {
		padding: 18px 12px;
	}
	.page-ziwei-result .info-grid {
		grid-template-columns: minmax(0, 1fr);
		gap: 12px;
	}
	.page-ziwei-result .info-summary {
		padding: 16px 18px;
	}
	.page-ziwei-result .info-group {
		grid-template-columns: 76px minmax(0, 1fr);
		gap: 6px 12px;
	}
	.page-ziwei-result .info-group + .info-group {
		padding: 12px 0 0;
		border-left: 0;
		border-top: 1px solid var(--x-line);
	}
	.page-ziwei-result .result-reading {
		display: flex;
		flex-direction: column;
	}
	.page-ziwei-result .section__title {
		font-size: 20px;
	}
}

/* Responsive overview: fixed palace order, readable summaries, full detail on demand. */
.overview-heading { display:flex; flex-direction:row; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:18px; }
.overview-heading h2 { font-family:var(--x-serif,serif); font-size:21px; font-weight:500; margin:0; color:var(--x-ink); }
.overview-heading > text { font-size:11px; color:var(--x-muted); }
.overview-layout { display:grid; grid-template-columns:minmax(0,1fr) 250px; gap:24px; align-items:start; }
.overview-main { min-width:0; }
.palace-board { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); grid-template-rows:repeat(4,minmax(158px,auto)); gap:5px; padding:5px; background:var(--x-tint,#eef5f7); border:1px solid var(--x-line); border-radius:12px; }
.overview-cell { min-width:0; background:var(--x-paper,#fff); border:1px solid var(--x-line); border-radius:7px; cursor:pointer; }
.overview-cell.is-related { background:#f4faf8; border-color:#b4d5cb; }
.overview-cell.is-selected { border-color:var(--x-accent,#167c8d); box-shadow:inset 0 0 0 1px var(--x-accent,#167c8d); background:var(--x-tint,#eef7f8); }
.overview-center { grid-row:2 / 4; grid-column:2 / 4; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:9px; padding:18px 10px; min-width:0; text-align:center; color:var(--x-ink); }
.center-kicker { color:var(--x-muted); font-size:10px; letter-spacing:.1em; }
.center-symbol { color:var(--x-accent); font-size:34px; line-height:1.4; }
.center-person { font-family:var(--x-serif,serif); font-size:19px; line-height:1.5; overflow-wrap:anywhere; max-width:100%; }
.center-date,.center-class { font-size:12px; line-height:1.7; color:var(--x-body); font-variant-numeric:tabular-nums; }
.center-focus { display:flex; flex-direction:row; gap:10px; font-size:11px; padding-top:12px; margin-top:3px; border-top:1px solid var(--x-line); }
.center-focus > text:first-child { color:var(--x-muted); }
.center-help { color:var(--x-muted); font-size:10px; line-height:1.8; }
.overview-legend { display:flex; flex-direction:row; flex-wrap:wrap; gap:16px; font-size:10px; color:var(--x-muted); padding:15px 2px 0; }
.overview-legend > text { display:flex; align-items:center; gap:6px; }
.legend-dot { display:inline-block; width:6px; height:6px; border-radius:50%; }
.selected-dot { background:var(--x-accent); }.related-dot { background:#b4d5cb; }
.overview-details { border:1px solid var(--x-line); border-radius:12px; padding:22px 18px; background:var(--x-paper); min-width:0; }
.detail-eyebrow { display:block; color:var(--x-muted); font-size:10px; margin-bottom:16px; letter-spacing:.12em; }
.overview-relations { display:flex; flex-direction:column; gap:10px; padding-top:16px; margin-top:18px; border-top:1px solid var(--x-line); font-size:11px; line-height:1.8; color:var(--x-muted); }
.overview-relations > view { display:flex; flex-direction:row; gap:12px; }.overview-relations .active { color:var(--x-accent); font-weight:600; }
.selected-detail-button { display:none; }
.overview-dialog-mask { position:fixed; inset:0; z-index:1100; background:#18333f66; display:flex; align-items:center; justify-content:center; padding:20px; }
.overview-dialog { width:480px; max-width:100%; max-height:85vh; overflow-y:auto; min-width:0; border-radius:16px; padding:22px; background:var(--x-paper,#fff); box-shadow:0 20px 60px #18333f33; }
.overview-dialog-header { display:flex; flex-direction:row; align-items:center; justify-content:space-between; margin-bottom:20px; color:var(--x-muted); font-size:11px; }
.overview-close { margin:0; padding:0; width:34px; height:34px; line-height:32px; font-size:24px; color:var(--x-body); background:var(--x-tint); border-radius:50%; }.overview-close::after{border:0;}
.overview-close:focus-visible,.selected-detail-button:focus-visible { outline:2px solid var(--x-accent); outline-offset:3px; }
.page-ziwei-result .info-summary { padding:18px 22px; }
.page-ziwei-result .calculation-note { font-size:11px; margin-top:12px; gap:3px; }
.calculation-caption { display:flex; flex-direction:row; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:6px 12px; }
.rules-toggle { display:inline-flex; margin:0; padding:4px 0; min-height:28px; background:transparent; font-size:11px; line-height:1.7; color:var(--x-accent); }.rules-toggle::after { border:0; }
@media(max-width:1180px) { .overview-layout { grid-template-columns:minmax(0,1fr); gap:18px; }.overview-details { display:none; }.selected-detail-button { display:flex; flex-direction:row; align-items:center; justify-content:space-between; margin:14px 0 0; padding:11px 14px; width:100%; font-size:12px; line-height:1.7; border:1px solid var(--x-line); border-radius:8px; background:var(--x-tint); color:var(--x-accent); }.selected-detail-button::after{border:0;} }
@media(max-width:600px) { .page-ziwei-result .chart-section { padding:16px 8px; }.overview-heading { padding:0 4px; margin-bottom:12px; }.overview-heading h2{font-size:19px;}.overview-heading>text{font-size:9px;}.palace-board { gap:3px; padding:3px; grid-template-rows:repeat(4,minmax(144px,auto)); border-radius:9px; }.overview-center { gap:8px; padding:12px 6px; }.center-symbol{font-size:27px;}.center-person{font-size:16px;}.center-date,.center-class{font-size:10px;}.center-help{font-size:9px;}.center-focus { font-size:10px; gap:6px; }.overview-legend { gap:10px; font-size:9px; padding-left:4px; }.overview-dialog-mask{padding:14px;}.overview-dialog{padding:20px 18px;}.page-ziwei-result .summary-value{font-size:13px;}.page-ziwei-result .info-group { gap:4px 8px; grid-template-columns:68px minmax(0,1fr); }.page-ziwei-result .info-group+.info-group {padding-top:8px;}.page-ziwei-result .info-grid{gap:8px;} }
@media(max-width:720px) { .page-ziwei-result .info-grid { grid-template-columns:repeat(2,minmax(0,1fr));gap:10px; }.page-ziwei-result .info-group { grid-template-columns:max-content minmax(0,1fr); gap:4px 8px; }.page-ziwei-result .info-group:nth-child(1){order:0;}.page-ziwei-result .info-group:nth-child(3){order:1;border:0;padding:0;}.page-ziwei-result .info-group:nth-child(2){order:2;grid-column:1 / -1;padding:8px 0 0;}.page-ziwei-result .summary-label{font-size:10px;}.page-ziwei-result .summary-value{font-size:12px;}.page-ziwei-result .info-summary {padding:16px;}.page-ziwei-result .calculation-note {margin-top:8px;}.calculation-caption{font-size:10px;} }

</style>
