<template>
	<tm-app>
		<PageScaffold
			class="page-ziwei-result"
			card-class="detail-card ziwei-card"
			title="紫微命盘"
			subtitle="十二宫之间，探索生活的不同面向。"
		>
			<template #header-extra>
				<view v-if="astrolabe" class="result-actions">
					<button v-bind="h5Button(editZiwei)" class="result-button" @tap="editZiwei">
						修改信息
					</button>
					<button v-bind="h5Button(exportToon)" class="result-button" @tap="exportToon">
						导出 TOON
					</button>
					<button
						v-bind="h5Button(saveToAccount, saving)"
						class="result-button primary"
						:disabled="saving"
						@tap="saveToAccount"
					>
						{{ saving ? '保存中…' : ziweiStore.input.recordId ? '更新本地记录' : '保存到本机' }}
					</button>
				</view>
			</template>
			<view v-if="astrolabe" class="result-container">
				<view class="section info-summary">
					<header class="section__header">
						<tm-icon name="tmicon-md-person" :font-size="26" color="#1672b1"></tm-icon>
						<h2 class="section__title">&#x57FA;&#x7840;&#x4FE1;&#x606F;</h2>
					</header>
					<view class="section__body">
						<view class="info-grid">
							<view v-for="group in summaryGroups" :key="group[0].label" class="info-group">
								<template v-for="item in group" :key="item.label">
									<text class="summary-label">{{ item.label }}</text>
									<text class="summary-value">{{ item.value }}</text>
								</template>
							</view>
						</view>

						<view v-if="ziweiStore.calculation" class="calculation-note">
							<view class="calculation-caption"><text>{{ ziweiStore.calculation.birthCivil.slice(11,16) }} · {{ ziweiStore.input.timeZone }}</text><button v-bind="h5Button(() => rulesOpen = !rulesOpen)" class="rules-toggle" :aria-expanded="rulesOpen" @tap="rulesOpen = !rulesOpen">排盘规则 {{ rulesOpen ? '−' : '+' }}</button></view>
							<text v-if="rulesOpen">按出生地民用钟表时间排盘；23 点换日，闰月十五／十六分界，正月初一换年，不校正真太阳时。</text>
							<text v-if="rulesOpen">亮度采用《紫微斗数全书》表，已修正旧版酉宫三项数据；四化采用戊右弼化科、庚太阴化科、壬左辅化科。</text>
							<text v-if="ziweiStore.calculation.lateZiRollover">晚子时按 {{ ziweiStore.calculation.calculationDate }} 子时排盘；上方阴历为排盘历日。</text>
							<text v-if="ziweiStore.input.timeZoneSource === 'legacy-device'">旧记录未保存出生时区，暂按当前设备时区解释，请通过“修改信息”确认。</text>
						</view>
						<view v-if="saveError" class="export-error">
							<text class="export-error-text">{{ saveError }}</text>
						</view>
						<view v-if="exportError" class="export-error">
							<text class="export-error-text">{{ exportError }}</text>
						</view>
					</view>
				</view>


        <view class="section chart-section">
          <header class="overview-heading"><h2>命盘总览</h2><text>{{ currentScopeLabel || '本命十二宫' }} · 主星与四化</text></header>
          <text v-if="ziweiStore.viewMode !== 'origin' && !currentHoroscope" class="calculation-note">选定时间超出可用运限范围，请从下方时间轴选择大限。当前显示本命盘。</text>
          <view class="overview-layout">
            <view class="overview-main">
              <view class="palace-board" aria-label="紫微十二宫">
                <view v-for="cell in boardCells" :key="cell.original.index" class="overview-cell" :class="{ 'is-selected': selectedCell?.original.index === cell.original.index, 'is-related': highlightedIndices.includes(cell.original.index) }" :style="palacePosition(cell.original.earthlyBranch)" @tap="handleCellClick(cell)">
                  <PalaceContent :active-scope="ziweiStore.viewMode" :palace="cell.original" :display-jiangqian12="cell.displayJiangqian12" :display-suiqian12="cell.displaySuiqian12" :dynamic-labels="cell.dynamicLabels" :dynamic-stars="cell.dynamicStars" :fly-mutagens="cell.flyMutagens" :scope-mutagens="cell.scopeMutagens" :is-highlighted="highlightedIndices.includes(cell.original.index)" @expand="openCellZoom(cell)" />
                </view>
                <view class="overview-center">
                  <text class="center-kicker">{{ currentScopeLabel || '本命 · 十二宫' }}</text>
                  <text class="center-symbol" aria-hidden="true">✳</text>
                  <text class="center-person">{{ ziweiStore.input.realname || '匿名命盘' }}</text>
                  <text class="center-date">{{ ziweiStore.calculation?.birthCivil.slice(0,10) || astrolabe.solarDate }}</text>
                  <text class="center-class">{{ astrolabe.fiveElementsClass }} · {{ ziweiStore.calculation?.lateZiRollover ? '晚子时' : astrolabe.time }}</text>
                  <view class="center-focus"><text>当前宫位</text><text>{{ displayPalaceName(selectedCell?.original.name || '') }}</text></view>
                  <text class="center-help">轻点宫位看关联<br />点击「详情」展开</text>
                </view>
              </view>
              <view class="overview-legend"><text><i class="legend-dot selected-dot"></i> 当前宫位</text><text><i class="legend-dot related-dot"></i> 三方四正</text><text>禄 · 权 · 科 · 忌</text></view>
              <button v-if="selectedCell" class="selected-detail-button" v-bind="h5Button(() => openCellZoom(selectedCell))" @tap="openCellZoom(selectedCell)">查看{{ displayPalaceName(selectedCell.original.name) }}完整信息 <text>↗</text></button>
            </view>
            <view v-if="selectedCell" class="overview-details" aria-label="宫位详情">
              <text class="detail-eyebrow">宫位详情</text>
              <PalaceContent :active-scope="ziweiStore.viewMode" expanded :palace="selectedCell.original" :display-jiangqian12="selectedCell.displayJiangqian12" :display-suiqian12="selectedCell.displaySuiqian12" :dynamic-labels="selectedCell.dynamicLabels" :dynamic-stars="selectedCell.dynamicStars" :fly-mutagens="selectedCell.flyMutagens" :scope-mutagens="selectedCell.scopeMutagens" />
              <view v-if="focusSummary" class="overview-relations"><text>三方四正 · 本命四化</text><view><text v-for="item in focusSummary.surroundMutagens" :key="item.name" :class="{ active: item.active }">{{ item.name }}</text></view><text v-if="focusSummary.flyText">飞化：{{ focusSummary.flyText }}</text></view>
            </view>
          </view>
          <!-- #ifdef H5 -->
          <Teleport to="body">
          <!-- #endif -->
          <view v-if="zoomedCell" class="overview-dialog-mask" @tap="closeCellZoom">
            <view ref="palaceDialogRoot" class="overview-dialog" role="dialog" aria-modal="true" aria-label="宫位完整信息" @tap.stop>
              <view class="overview-dialog-header"><text>宫位完整信息</text><button v-bind="h5Button(closeCellZoom)" class="overview-close" aria-label="关闭宫位放大" @tap="closeCellZoom">×</button></view>
              <PalaceContent :active-scope="ziweiStore.viewMode" expanded :palace="zoomedCell.original" :display-jiangqian12="zoomedCell.displayJiangqian12" :display-suiqian12="zoomedCell.displaySuiqian12" :dynamic-labels="zoomedCell.dynamicLabels" :dynamic-stars="zoomedCell.dynamicStars" :fly-mutagens="zoomedCell.flyMutagens" :scope-mutagens="zoomedCell.scopeMutagens" />
              <view v-if="focusSummary" class="overview-relations"><text>三方四正 · 本命四化</text><view><text v-for="item in focusSummary.surroundMutagens" :key="item.name" :class="{ active: item.active }">{{ item.name }}</text></view><text v-if="focusSummary.flyText">飞化：{{ focusSummary.flyText }}</text></view>
            </view>
          </view>
          <!-- #ifdef H5 -->
          </Teleport>
          <!-- #endif -->
        </view>

				<view class="result-reading">
					<text class="result-eyebrow">EXPLORE A LITTLE DEEPER</text>
					<h2>看见结构，再聊细节。</h2>
					<p>把盘面与自己的生活经验放在一起，从一个关心的问题开始。当前命盘会随对话一起带入。</p>
					<button v-bind="h5Button(goToChat)" class="result-button primary" @tap="goToChat">
						带着这张盘，问问 AI ↗
					</button>
					<text class="result-note">传统文化探索 · 供交流与参考</text>
				</view>
				<view class="section timeline-section">
					<header class="section__header">
						<tm-icon name="tmicon-md-time" :font-size="26" color="#1672b1"></tm-icon>
						<h2 class="section__title">&#x8FD0;&#x9650;&#x65F6;&#x95F4;&#x8F74;</h2>
					</header>
					<view class="section__body">
						<Timeline
							:astrolabe="astrolabe"
							:view-mode="ziweiStore.viewMode"
							:target-date="ziweiStore.targetDate"
							@update:selection="handleTimelineSelectionUpdate"
						/>
					</view>
				</view>
			</view>

			<view v-else class="section empty-state">
				<tm-icon name="tmicon-md-time" :font-size="72" color="#cbd5e0"></tm-icon>
				<tm-text
					:font-size="26"
					color="#718096"
					label="&#x6682;&#x65E0;&#x6392;&#x76D8;&#x6570;&#x636E;&#xFF0C;&#x8BF7;&#x5148;&#x8FD4;&#x56DE;&#x6392;&#x76D8;&#x4E3B;&#x9875;&#x751F;&#x6210;&#x547D;&#x76D8;&#x3002;"
				></tm-text>
				<tm-button
					v-bind="h5Button(goStart)"
					type="primary"
					:round="12"
					:padding="[22, 16]"
					label="&#x8FD4;&#x56DE;&#x6392;&#x76D8;"
					@tap="goStart"
				></tm-button>
			</view>
		</PageScaffold>
	</tm-app>
</template>

<script lang="ts" setup>
import { computed, ref } from 'vue';
import { onShow } from '@dcloudio/uni-app';
import PageScaffold from '@/components/layout/PageScaffold.vue';
import { useZiweiStore } from '@/store/ziwei';
import { useUserStore } from '@/store/user';
import { request } from '@/services/localRecords';
import { downloadTextFile } from '@/utils/downloadTextFile';
import { encodeTOON } from '@/utils/toon';
import { h5Button } from '@/utils/keyboard';
import { useModalFocus } from '@/utils/useModalFocus';
import { buildZiweiExportPayload } from '@/utils/ziweiExport';
import PalaceContent from './components/PalaceContent.nvue';
import Timeline from './components/Timeline.nvue';

const ziweiStore = useZiweiStore();
const userStore = useUserStore();
ziweiStore.restoreInput();
ziweiStore.ensureComputed();
onShow(() => {
	ziweiStore.restoreInput();
	ziweiStore.ensureComputed();
});
const saving = ref(false);
const saveError = ref('');
const exportError = ref('');
const rulesOpen = ref(false);
const zoomedPalaceIndex = ref<number | null>(null);
const lastClickTs = ref(0);
const lastClickPalaceIndex = ref<number | null>(null);

const astrolabe = computed(() => ziweiStore.astrolabe);
const currentHoroscope = computed(() => ziweiStore.currentHoroscope);

const formatTimestampForFilename = (timestamp: number | null | undefined): string => {
	if (typeof timestamp !== 'number' || !Number.isFinite(timestamp)) return '';
	const date = new Date(timestamp);
	if (!Number.isFinite(date.getTime())) return '';
	const pad = (value: number) => String(value).padStart(2, '0');
	return `${date.getFullYear()}${pad(date.getMonth() + 1)}${pad(date.getDate())}${pad(date.getHours())}${pad(date.getMinutes())}`;
};

const exportToon = () => {
	exportError.value = '';
	if (!astrolabe.value) {
		uni.showToast({
			title: '\u6682\u65E0\u6392\u76D8\u6570\u636E\uFF0C\u65E0\u6CD5\u5BFC\u51FA',
			icon: 'none',
			duration: 2000,
		});
		return;
	}

	let payload: Record<string, unknown> | null = null;
	try {
		payload = buildZiweiExportPayload(ziweiStore.input, ziweiStore);
	} catch (e: any) {
		exportError.value = `\u751F\u6210\u5BFC\u51FA\u6570\u636E\u5931\u8D25\uFF1A${e?.message || e}`;
		return;
	}

	if (!payload) {
		exportError.value = '\u5BFC\u51FA\u6570\u636E\u4E3A\u7A7A\uFF0C\u65E0\u6CD5\u751F\u6210 TOON \u6587\u4EF6';
		return;
	}

	let toonStr = '';
	try {
		toonStr = encodeTOON(payload);
	} catch (e: any) {
		exportError.value = `TOON \u5E8F\u5217\u5316\u5931\u8D25\uFF1A${e?.message || e}`;
		return;
	}

	const filename = `ziwei-${formatTimestampForFilename(ziweiStore.input.timestamp) || 'export'}.toon`;

	// #ifdef H5
	try {
		downloadTextFile(toonStr, filename);
		uni.showToast({
			title: '已请求浏览器下载 TOON 文件',
			icon: 'none',
			duration: 2000,
		});
		return;
	} catch (e) {
		// fallback to clipboard
	}
	// #endif

	uni.setClipboardData({
		data: toonStr,
		success() {
			uni.showToast({
				title: 'TOON \u5DF2\u590D\u5236\uFF0C\u8BF7\u7C98\u8D34\u4FDD\u5B58',
				icon: 'none',
				duration: 2000,
			});
		},
		fail(err) {
			exportError.value = `\u5BFC\u51FA\u5931\u8D25\uFF1A${err?.errMsg || '\u526A\u8D34\u677F\u4E0D\u53EF\u7528'}`;
		},
	});
};

const buildZiweiLitePayload = () => {
	const chart = astrolabe.value;
	if (!chart) return null;

	const palaces = (chart.palaces || []).map((palace: any) => ({
		index: palace?.index,
		name: palace?.name || '',
		heavenlyStem: palace?.heavenlyStem || '',
		earthlyBranch: palace?.earthlyBranch || '',
	}));

	return {
		lite: true,
		module: 'ziwei',
		user: {
			...ziweiStore.input,
			realname: ziweiStore.input.realname || '',
			gender: ziweiStore.input.gender,
			timestamp: ziweiStore.input.timestamp,
		},
		selection: {
			viewMode: ziweiStore.viewMode,
			targetDate:
				ziweiStore.targetDate instanceof Date
					? ziweiStore.targetDate.toISOString()
					: new Date(ziweiStore.targetDate as any).toISOString(),
			focusPalaceIndex: ziweiStore.focusPalaceIndex,
		},
		summary: {
			solarDate: chart.solarDate || '',
			lunarDate: chart.lunarDate || '',
			time: chart.time || '',
			fiveElementsClass: chart.fiveElementsClass || '',
			soul: chart.soul || '',
			body: chart.body || '',
			palaces,
		},
	};
};

const saveToAccount = async () => {
	saveError.value = '';

	if (!userStore.isLoggedIn) {
		uni.showToast({
			 title: '\u8BF7\u5148\u767B\u5F55',
			icon: 'none',
			duration: 2000,
		});
		return;
	}

	if (!astrolabe.value || !ziweiStore.input.timestamp) {
		uni.showToast({
			 title: '\u6392\u76D8\u6570\u636E\u4E0D\u5B8C\u6574',
			icon: 'none',
			duration: 2000,
		});
		return;
	}

	if (saving.value) return;
	saving.value = true;
	const savingInput = ziweiStore.input;
	const recordId = ziweiStore.input.recordId;
	const isUpdate = !!recordId;

	try {
		const rawPayload = buildZiweiLitePayload();
		const res = await request(isUpdate ? `/records/ziwei/${recordId}` : '/records/ziwei', {
			method: isUpdate ? 'PUT' : 'POST',
			data: {
				name: (ziweiStore.input.realname || '').trim() || '\u533F\u540D',
				gender:
					ziweiStore.input.gender !== undefined && ziweiStore.input.gender !== null
						? String(ziweiStore.input.gender)
						: null,
				birthDatetime: Number(ziweiStore.input.timestamp),
				calendarType: 'solar',
				rawPayload,
			},
		});
		const responseData = res?.data || res;
		if (responseData?.id && ziweiStore.input === savingInput) {
			ziweiStore.input.recordId = responseData.id;
			ziweiStore.persistInput();
		}

		uni.showToast({
			 title: isUpdate ? '\u8BB0\u5F55\u5DF2\u66F4\u65B0' : '已保存到本机',
			icon: 'success',
			duration: 1500,
		});
	} catch (e: any) {
		if (isUpdate && e?.code === 'NOT_FOUND' && ziweiStore.input === savingInput) {
			ziweiStore.input.recordId = null;
			ziweiStore.persistInput();
		}
		const message = e?.error || e?.message || '\u4FDD\u5B58\u5931\u8D25\uFF0C\u8BF7\u91CD\u8BD5';
		saveError.value = message;
		uni.showToast({
			title: message,
			icon: 'none',
			duration: 2000,
		});
	} finally {
		saving.value = false;
	}
};

function editZiwei() {
	if (!ziweiStore.input.timestamp) {
		uni.showToast({
			 title: '\u7F3A\u5C11\u51FA\u751F\u65F6\u95F4',
			icon: 'none',
			duration: 2000,
		});
		return;
	}

	const editData = {
		...ziweiStore.input,
		realname: ziweiStore.input.realname || '',
		gender:
			ziweiStore.input.gender !== undefined && ziweiStore.input.gender !== null
				? Number(ziweiStore.input.gender)
				: 0,
		timestamp: Number(ziweiStore.input.timestamp),
		recordId: ziweiStore.input.recordId || null,
		isEdit: true,
	};

	try {
		uni.setStorageSync('edit_ziwei_data', JSON.stringify(editData));
		uni.showToast({
			 title: '\u8DF3\u8F6C\u4E2D...',
			icon: 'loading',
			duration: 900,
		});
		setTimeout(() => {
			uni.reLaunch({
				url: '/pages/ziwei/index',
			});
		}, 300);
	} catch (e) {
		console.error('\u51C6\u5907\u7F16\u8F91\u6570\u636E\u5931\u8D25:', e);
		uni.showToast({
			title: '\u8F7D\u5165\u5931\u8D25\uFF0C\u8BF7\u91CD\u8BD5',
			icon: 'none',
			duration: 2000,
		});
	}
}

function goToChat() {
	if (!astrolabe.value) {
		uni.showToast({
			title: '\u6682\u65E0\u6392\u76D8\u6570\u636E',
			icon: 'none',
			duration: 2000,
		});
		return;
	}

	uni.navigateTo({
		url: '/pages/chat/index?from=ziwei',
	});
}

function goStart() {
	uni.reLaunch({
		url: '/pages/ziwei/index',
	});
}

const currentScopeLabel = computed(() => {
    const h = currentHoroscope.value;
    if (!h) return '';

    if (ziweiStore.viewMode === 'decadal' && h.decadal) {
		return `${h.decadal.heavenlyStem}${h.decadal.earthlyBranch}\u5927\u9650`;
    } else if (ziweiStore.viewMode === 'yearly' && h.yearly) {
		return `${h.yearly.heavenlyStem}${h.yearly.earthlyBranch}\u6D41\u5E74`;
    } else if (ziweiStore.viewMode === 'monthly' && h.monthly) {
		return `${h.monthly.heavenlyStem}${h.monthly.earthlyBranch}\u6D41\u6708`;
    } else if (ziweiStore.viewMode === 'daily' && h.daily) {
		return `${h.daily.heavenlyStem}${h.daily.earthlyBranch}\u6D41\u65E5`;
    }
    return '';
});

const summaryTiles = computed(() => {
	if (!astrolabe.value) return [];
	const tiles = [
		{ label: '\u59D3\u540D', value: (ziweiStore.input.realname || '').trim() || '\u533F\u540D' },
		{ label: '\u6027\u522B', value: Number(ziweiStore.input.gender) === 0 ? '\u7537' : '\u5973' },
		{ label: '\u9633\u5386', value: ziweiStore.calculation?.birthCivil.slice(0, 10) || astrolabe.value.solarDate || '-' },
		{ label: '\u9634\u5386', value: astrolabe.value.lunarDate || '-' },
		{ label: '\u4E94\u884C\u5C40', value: astrolabe.value.fiveElementsClass || '-' },
		{ label: '\u547D\u4E3B / \u8EAB\u4E3B', value: `${astrolabe.value.soul || '-'} / ${astrolabe.value.body || '-'}` },
	];
	return tiles;
});
const summaryGroups = computed(() => [summaryTiles.value.slice(0, 2), summaryTiles.value.slice(2, 4), summaryTiles.value.slice(4, 6)].filter(group => group.length));

const handleTimelineSelectionUpdate = (payload: any) => {
	const mode = payload?.mode;
	const value = payload?.date;
	if (!mode) return;
	const date = value instanceof Date ? new Date(value.getTime()) : new Date(value || ziweiStore.targetDate);
	if (!Number.isFinite(date.getTime())) return;
	ziweiStore.setTimelineSelection({ mode, date });
};

type DynamicScope = 'decadal' | 'age' | 'yearly' | 'monthly' | 'daily';
type MutagenName = '禄' | '权' | '科' | '忌';
type HoroscopeScope = 'hourly' | 'daily' | 'monthly' | 'yearly' | 'decadal' | 'age';

const SCOPE_PREFIX: Record<DynamicScope, string> = {
	decadal: '\u5927',
	age: '\u5C0F',
	yearly: '\u5E74',
	monthly: '\u6708',
	daily: '\u65E5',
};

const MUTAGEN_NAMES: MutagenName[] = ['\u7984', '\u6743', '\u79D1', '\u5FCC'];
const DYNAMIC_LABEL_SCOPE_ORDER: HoroscopeScope[] = ['hourly', 'daily', 'monthly', 'yearly', 'decadal', 'age'];
const DYNAMIC_STAR_SCOPE_ORDER: Array<Exclude<HoroscopeScope, 'age'>> = ['hourly', 'daily', 'monthly', 'yearly', 'decadal'];
const DYNAMIC_LABEL_PREFIX: Record<HoroscopeScope, string> = {
	hourly: '\u65F6',
	daily: '\u65E5',
	monthly: '\u6708',
	yearly: '\u5E74',
	decadal: '\u5927',
	age: '\u5C0F',
};
const displayPalaceName = (name: string) => (name === '\u4EC6\u5F79' ? '\u4EA4\u53CB' : name);

const palaceStarNameSet = computed(() => {
	const sets = new Map<number, Set<string>>();
	if (!astrolabe.value) return sets;
	astrolabe.value.palaces.forEach((palace) => {
		const names = new Set<string>();
		[...(palace.majorStars || []), ...(palace.minorStars || [])].forEach((star: any) => {
			const name = star?.name;
			if (typeof name === 'string' && name) names.add(name);
		});
		sets.set(palace.index, names);
	});
	return sets;
});

const focusedSurroundedPalaces = computed(() => {
	const focusIndex = ziweiStore.focusPalaceIndex;
	if (focusIndex === null || !astrolabe.value) return null;

	const focusPalace = astrolabe.value.palaces[focusIndex];
	if (!focusPalace) return null;

	try {
		// Selection is a physical palace index. Its natal name can refer to a
		// different physical palace when looked up in a horoscope scope.
		return astrolabe.value.surroundedPalaces(focusPalace.index);
	} catch (e) {
		console.warn('Failed to load surrounded palaces:', e);
		return null;
	}
});

const highlightedIndices = computed(() => {
	const surrounded = focusedSurroundedPalaces.value;
	if (!surrounded) return [];

	return Array.from(
        new Set(
            [surrounded.target?.index, surrounded.opposite?.index, surrounded.wealth?.index, surrounded.career?.index].filter(
                (idx): idx is number => typeof idx === 'number',
            ),
        ),
    );
});

const focusSummary = computed(() => {
    const focusIndex = ziweiStore.focusPalaceIndex;
    if (focusIndex === null || !astrolabe.value) return null;

	const focusPalace = astrolabe.value.palaces[focusIndex];
	if (!focusPalace) return null;

	const surrounded = focusedSurroundedPalaces.value;
	const surroundMutagens = MUTAGEN_NAMES.map((name) => ({
		name,
		active: surrounded ? surrounded.haveMutagen(name) : false,
    }));

    const flyParts: string[] = [];
	    astrolabe.value.palaces.forEach((targetPalace) => {
	        const hits = MUTAGEN_NAMES.filter((mutagen) => {
	            try {
	                return focusPalace.fliesTo(targetPalace.index, mutagen);
	            } catch (e) {
	                return false;
	            }
	        });
	        if (hits.length) {
	            flyParts.push(`${displayPalaceName(targetPalace.name)}${hits.join('')}`);
	        }
	    });

	    return {
	        name: displayPalaceName(focusPalace.name),
	        surroundMutagens,
	        flyText: flyParts.join('\u3001'),
	    };
	});

const sortedCells = computed(() => {
    if (!astrolabe.value) return { top: [], left: [], right: [], bottom: [] };

    const cellsMap = new Map();
    
	// 1. Initialize with Original Palaces
	astrolabe.value.palaces.forEach(p => {
		cellsMap.set(p.earthlyBranch, {
			original: p,
			dynamicLabels: [],
			dynamicStars: [],
			flyMutagens: [],
			scopeMutagens: {},
			displayJiangqian12: undefined,
			displaySuiqian12: undefined,
		});
	});

	// 2. Add Dynamic Info (Horoscope)
	if (ziweiStore.viewMode !== 'origin' && currentHoroscope.value) {
		const mode = ziweiStore.viewMode;
		const horoscope = currentHoroscope.value;

		if (mode === 'yearly') {
			const yearlyDecStar = (horoscope as any)?.yearly?.yearlyDecStar;
			const yearlySuiqian12 = Array.isArray(yearlyDecStar?.suiqian12) ? yearlyDecStar.suiqian12 : [];
			const yearlyJiangqian12 = Array.isArray(yearlyDecStar?.jiangqian12) ? yearlyDecStar.jiangqian12 : [];

			astrolabe.value.palaces.forEach((basePalace, palaceIndex) => {
				const cell = cellsMap.get(basePalace.earthlyBranch);
				if (!cell) return;
				const suiqianValue = yearlySuiqian12[palaceIndex];
				const jiangqianValue = yearlyJiangqian12[palaceIndex];
				if (typeof suiqianValue === 'string' && suiqianValue) {
					cell.displaySuiqian12 = suiqianValue;
				}
				if (typeof jiangqianValue === 'string' && jiangqianValue) {
					cell.displayJiangqian12 = jiangqianValue;
				}
			});
		}

		// Keep only current scope to avoid information overload.
		const activeScopesByMode: Record<string, DynamicScope[]> = {
            decadal: ['decadal'],
            yearly: ['yearly'],
            monthly: ['monthly'],
            daily: ['daily'],
        };
        const activeScopes: DynamicScope[] = activeScopesByMode[mode] || [];

		DYNAMIC_LABEL_SCOPE_ORDER.forEach((scope) => {
			const scopeData = (horoscope as any)?.[scope];
			if (!scopeData) return;
			const prefix = DYNAMIC_LABEL_PREFIX[scope];

			const palaceNames = Array.isArray(scopeData.palaceNames) ? scopeData.palaceNames : [];

			// 2.1 Overlay dynamic palace labels for all available scopes.
			palaceNames.forEach((palaceName: string, palaceIndex: number) => {
				const basePalace = astrolabe.value?.palaces?.[palaceIndex];
				if (!basePalace) return;

                const cell = cellsMap.get(basePalace.earthlyBranch);
                if (!cell) return;

					if (!cell.dynamicLabels) cell.dynamicLabels = [];
					cell.dynamicLabels.push({
						text: `${prefix}${displayPalaceName(String(palaceName || ''))}`,
						type: scope,
					});
				});
		});

		DYNAMIC_STAR_SCOPE_ORDER.forEach((scope) => {
			const scopeData = (horoscope as any)?.[scope];
			if (!scopeData) return;
			const starsByPalace = Array.isArray(scopeData.stars) ? scopeData.stars : [];
			starsByPalace.forEach((stars: any[], palaceIndex: number) => {
				if (!Array.isArray(stars) || !stars.length) return;
				const basePalace = astrolabe.value?.palaces?.[palaceIndex];
				if (!basePalace) return;
				const cell = cellsMap.get(basePalace.earthlyBranch);
				if (!cell) return;
				if (!Array.isArray(cell.dynamicStars)) cell.dynamicStars = [];
				stars.forEach((star: any) => {
					const starName = star?.name;
					if (typeof starName !== 'string' || !starName) return;
					if (!cell.dynamicStars.includes(starName)) {
						cell.dynamicStars.push(starName);
					}
				});
			});
		});

		activeScopes.forEach((scope) => {
			const prefix = SCOPE_PREFIX[scope];
			const scopeData = (horoscope as any)?.[scope];
			if (!scopeData) return;
			// 2.2 Apply scope mutagens to natal stars (iztro hasHoroscopeMutagen logic).
			const scopeMutagenList = Array.isArray(scopeData.mutagen) ? scopeData.mutagen : [];
			for (const cell of cellsMap.values()) {
				const starSet = palaceStarNameSet.value.get(cell.original.index);

				scopeMutagenList.forEach((starName: string, idx: number) => {
					if (!starName) return;
                    const mutagenName = MUTAGEN_NAMES[idx];
                    if (!mutagenName) return;
					// Scope transformations attach to the actual natal star. Passing a
					// natal palace name to the horoscope API would look up another cell.
					if (!starSet?.has(starName)) return;

                    const mutagenLabel = prefix + mutagenName;
                    if (!mutagenLabel) return;

                    if (!cell.scopeMutagens) cell.scopeMutagens = {};
                    if (!cell.scopeMutagens[starName]) cell.scopeMutagens[starName] = [];
                    cell.scopeMutagens[starName].push({
                        scope,
                        label: mutagenLabel,
                    });
                });
            }
        });
    }

    // 3. Add Flying Mutagen (Focus)
    if (ziweiStore.focusPalaceIndex !== null) {
        const focusPalace = astrolabe.value.palaces[ziweiStore.focusPalaceIndex];
        if (focusPalace) {
            astrolabe.value.palaces.forEach((targetPalace) => {
                const cell = cellsMap.get(targetPalace.earthlyBranch);
                if (!cell) return;

                MUTAGEN_NAMES.forEach((mutagenName) => {
                    try {
                        if (focusPalace.fliesTo(targetPalace.index, mutagenName)) {
                            if (!Array.isArray(cell.flyMutagens)) {
                                cell.flyMutagens = [];
                            }
                            if (!cell.flyMutagens.includes(mutagenName)) {
                                cell.flyMutagens.push(mutagenName);
                            }
                        }
                    } catch (e) {
                        // Ignore single mutagen check error and continue.
                    }
                });
            });
        }
    }

	for (const cell of cellsMap.values()) {
		if (!Array.isArray(cell.flyMutagens)) {
			cell.flyMutagens = [];
		}
		if (!Array.isArray(cell.dynamicStars)) {
			cell.dynamicStars = [];
		}
	}

	return {
			top: ['\u5DF3', '\u5348', '\u672A', '\u7533'].map((b) => cellsMap.get(b)),
			left: ['\u8FB0', '\u536F'].map((b) => cellsMap.get(b)),
			right: ['\u9149', '\u620C'].map((b) => cellsMap.get(b)),
			bottom: ['\u5BC5', '\u4E11', '\u5B50', '\u4EA5'].map((b) => cellsMap.get(b)),
	};
});

const boardCells = computed(() => [...sortedCells.value.top, ...sortedCells.value.left, ...sortedCells.value.right, ...sortedCells.value.bottom].filter(Boolean));
const zoomedCell = computed(() => zoomedPalaceIndex.value === null ? null : boardCells.value.find(cell => cell.original.index === zoomedPalaceIndex.value) || null);
const selectedCell = computed(() => boardCells.value.find(cell => cell.original.index === ziweiStore.focusPalaceIndex) || boardCells.value.find(cell => cell.original.name === '命宫') || boardCells.value[0]);
const palacePosition = (branch: string) => {
  const positions: Record<string, [number, number]> = {巳:[1,1],午:[1,2],未:[1,3],申:[1,4],辰:[2,1],卯:[3,1],酉:[2,4],戌:[3,4],寅:[4,1],丑:[4,2],子:[4,3],亥:[4,4]};
  const [row,column] = positions[branch] || [1,1]; return {gridRow:row,gridColumn:column};
};

const getCellClass = (cell: any) => {
    const isFocus = ziweiStore.focusPalaceIndex === cell.original.index;
	const isMing = cell.original.name === '\u547D\u5BAB';
    
    return {
        'cell-focused': isFocus,
        'cell-highlight': isMing && !isFocus
    };
};

const DOUBLE_CLICK_WINDOW_MS = 280;

const closeCellZoom = () => {
	zoomedPalaceIndex.value = null;
};

const palaceDialogRoot = ref<any>(null);
const palaceDialogOpen = computed(() => Boolean(zoomedCell.value));
useModalFocus(palaceDialogOpen, palaceDialogRoot, closeCellZoom);

const openCellZoom = (cell: any) => {
	if (!cell?.original) return;
	ziweiStore.focusPalaceIndex = cell.original.index;
	zoomedPalaceIndex.value = cell.original.index;
	lastClickPalaceIndex.value = null;
	lastClickTs.value = 0;
};

const handleCellClick = (cell: any) => {
	if (!cell?.original) return;

	const palaceIndex = cell.original.index;
	ziweiStore.focusPalaceIndex = palaceIndex;

	const now = Date.now();
	const isSamePalace = lastClickPalaceIndex.value === palaceIndex;
	const isDoubleClick = isSamePalace && now - lastClickTs.value <= DOUBLE_CLICK_WINDOW_MS;

	lastClickPalaceIndex.value = palaceIndex;
	lastClickTs.value = now;

	if (isDoubleClick) {
		zoomedPalaceIndex.value = palaceIndex;
		lastClickPalaceIndex.value = null;
		lastClickTs.value = 0;
	}
};
</script>

