<template>
	<tm-app>
		<PageScaffold title="带着命盘，继续探索" :subtitle="contextSummary ? '结合原盘和你的问题，让思路一点点清晰。' : contextCaption"><view class="chat-page-shell">
			<view v-if="contextSummary" class="chart-context" role="group" :aria-label="contextCaption">
				<view class="chart-context-details">
					<text class="chart-context-type">已关联{{ contextSummary.type }}</text>
					<text class="chart-context-title">{{ contextSummary.title }}</text>
					<text class="chart-context-time">{{ contextSummary.time }} · {{ contextSummary.zone }}</text>
				</view>
				<button class="chart-context-open" v-bind="h5Button(openOriginalChart)" @tap="openOriginalChart">查看原盘 ↗</button>
			</view>
			<view class="archive-toolbar">
				<view class="archive-copy">
					<text class="archive-description">下载为 JSON 文件，导入会替换当前对话。</text>
					<button
						v-if="canChooseArchiveLocation"
						class="archive-location-btn"
						v-bind="h5Button(handleSaveArchive, archiveBusy || sending)"
						:disabled="archiveBusy || sending"
						@tap="handleSaveArchive"
					>选择位置保存</button>
				</view>
				<view class="archive-btns">
					<button class="archive-btn" v-bind="h5Button(handleDownloadArchive, archiveBusy || sending)" :disabled="archiveBusy || sending" @tap="handleDownloadArchive">下载档案</button>
					<button class="archive-btn archive-btn-secondary" v-bind="h5Button(handleImportArchive, archiveBusy || sending)" :disabled="archiveBusy || sending" @tap="handleImportArchive">导入档案</button>
				</view>
			</view>
			<chat-panel
				ref="panelRef"
				class="chat-panel-wrapper"
				:disable-auto-restore="shouldDisableRestore"
				:session-identity="sessionIdentity"
				:session-account="sessionAccount"
				@session-reset="resetChatRequest"
				@send="handleSend"
			/>
		</view></PageScaffold>
	</tm-app>
</template>

<script lang="ts" setup>
import { computed, nextTick, onMounted, onUnmounted, ref } from 'vue';
import { onLoad } from '@dcloudio/uni-app';
import { callAi } from '@/services/ai';
import { hasAiConfig } from '@/config/aiConfig';
import ChatPanel from '@/chat/ChatPanel.vue';
import PageScaffold from '@/components/layout/PageScaffold.vue';
import { encodeTOON } from '@/utils/toon';
import { civilString, zonedParts } from '@/utils/chartTime';
import { h5Button } from '@/utils/keyboard';
import { useUserStore } from '@/store/user';
import { useBaziStore } from '@/store/bazi';
import { useYunStore } from '@/store/yun';
import { useLiuyaoStore } from '@/store/liuyao';
import { useZiweiStore } from '@/store/ziwei';
import { useQimenStore } from '@/store/qimen';
import { buildBaziExportPayload } from '@/utils/baziExport';
import { buildLiuyaoExportPayload } from '@/utils/liuyaoExport';
import { buildZiweiExportPayload } from '@/utils/ziweiExport';
import { buildQimenExportPayload } from '@/utils/qimenExport';

type ChatContext = 'bazi' | 'liuyao' | 'ziwei' | 'qimen';
type ChatRole = 'system' | 'user' | 'assistant';
type ChatMessage = {
	role: ChatRole;
	content: string;
};
type ParsedHttpError = {
	message: string;
	code?: string;
};

const panelRef = ref<any>(null);
const chatContext = ref<ChatContext | null>('bazi');
const shouldDisableRestore = ref(false);
let activeRequest: AbortController | null = null;
let disposed = false;
const sending = ref(false);
onUnmounted(() => { disposed = true; activeRequest?.abort(); });

const userStore = useUserStore();
const sessionAccount = computed(() => 'local-device');
const baziStore = useBaziStore();
const yunStore = useYunStore();
const liuyaoStore = useLiuyaoStore();
const ziweiStore = useZiweiStore();
const qimenStore = useQimenStore();
// Use original inputs, not a changing presentation/export or the shared profile.
const sessionIdentity = computed(() => {
	if (!chatContext.value) return null;
	const base = { account: sessionAccount.value, chartType: chatContext.value };
	if (chatContext.value === 'liuyao') {
		if (!liuyaoStore.profile || liuyaoStore.compiled?.params?.length !== 6) return null;
		return { ...base, recordId: liuyaoStore.recordId, chart: {
			profile: liuyaoStore.profile, params: liuyaoStore.compiled.params,
			calculation: liuyaoStore.calculation,
			castingAt: liuyaoStore.castingAt ?? liuyaoStore.createdAt,
		} };
	}
	const store = { bazi: baziStore, ziwei: ziweiStore, qimen: qimenStore }[chatContext.value];
	const { recordId, ...chart } = store.input;
	if (typeof chart.timestamp !== 'number' || !Number.isFinite(chart.timestamp)) return null;
	return { ...base, recordId, chart };
});

function resetChatRequest() {
	activeRequest?.abort();
}
// The visible summary and every request read one export, so they cannot describe
// different chart identities or clocks. Vue invalidates it when that chart changes.
const exportedContext = computed(buildExportedContext);
const contextSummary = computed(() => exportedContext.value?.summary || null);
const contextCaption = computed(() => {
	const summary = contextSummary.value;
	return summary
		? `已关联${summary.type} · ${summary.title} · ${summary.time} · ${summary.zone}`
		: '从你关心的问题开始，让思路一点点清晰。';
});

onLoad((options: Record<string, unknown> = {}) => {
	const from = String(options?.from || '').toLowerCase();
	if (from === 'bazi' || from === 'liuyao' || from === 'ziwei' || from === 'qimen') {
		chatContext.value = from as ChatContext;
		shouldDisableRestore.value = true;
		// Direct links and reloads start with empty stores. Restore only the
		// requested chart; the store guards preserve an already active result.
		if (from === 'bazi') {
			baziStore.restoreInput();
			baziStore.ensureComputed();
		} else if (from === 'ziwei') {
			ziweiStore.restoreInput();
			ziweiStore.ensureComputed();
		} else if (from === 'qimen') {
			qimenStore.restoreInput();
			qimenStore.ensureComputed();
		} else {
			liuyaoStore.restoreLastResult();
		}
	} else if (from) {
		chatContext.value = null;
	}
});

onMounted(() => {
	canChooseArchiveLocation.value = typeof window !== 'undefined' && typeof (window as any).showSaveFilePicker === 'function';
	// The child panel ref is available at mount. Add the context hint before a
	// user can start streaming; a delayed ready message would end its sending state.
	if (chatContext.value === 'liuyao') {
		panelRef.value?.appendAssistant(contextSummary.value
			? '已为您加载六爻排盘结果，您可以让 AI 为您解读卦象。'
			: '当前尚未关联六爻卦象。您可以先完成起卦，也可以直接提出问题。', 'ready');
	} else if (chatContext.value === 'ziwei') {
		panelRef.value?.appendAssistant(contextSummary.value
			? '已为您加载紫微排盘结果，您可以让 AI 为您解答命盘重点。'
			: '当前尚未关联紫微命盘。您可以先完成排盘，也可以直接提出问题。', 'ready');
	} else if (chatContext.value === 'qimen') {
		panelRef.value?.appendAssistant(contextSummary.value
			? '已为您加载奇门盘局，您可以结合所问之事，让 AI 为您解读九宫、星门与时机。'
			: '当前尚未关联奇门盘局。您可以先完成起局，也可以直接提出问题。', 'ready');
	}
});

function handleSend(text: string) {
	void sendToLLM(text);
}

function openOriginalChart() {
	if (!contextSummary.value || !chatContext.value) return;
	const routes: Record<ChatContext, string> = {
		bazi: '/pages/index/detail', ziwei: '/pages/ziwei/result',
		liuyao: '/pages/liuyao/result', qimen: '/pages/qimen/result',
	};
	// Keep this chat mounted, including its messages and any response in progress.
	// Result pages read the same active chart store; no re-cast or input reset.
	uni.navigateTo({ url: routes[chatContext.value] });
}

const archiveBusy = ref(false);
const canChooseArchiveLocation = ref(false);
async function handleDownloadArchive() {
	if (archiveBusy.value || sending.value) return;
	archiveBusy.value = true;
	try {
		await panelRef.value?.handleDownloadArchive?.();
	} finally {
		archiveBusy.value = false;
	}
}

async function handleImportArchive() {
	if (archiveBusy.value || sending.value) return;
	archiveBusy.value = true;
	try {
		await panelRef.value?.handleImportArchive?.();
	} finally {
		archiveBusy.value = false;
	}
}

async function handleSaveArchive() {
	if (archiveBusy.value || sending.value) return;
	archiveBusy.value = true;
	try {
		await panelRef.value?.handleSaveArchive?.();
	} finally {
		archiveBusy.value = false;
	}
}

function stripHtml(value: unknown): string {
	const raw = String(value ?? '');
	const stripped = raw.replace(/<[^>]+>/g, '');
	return stripped || raw;
}

function normalizeError(value: unknown): string {
	const raw = String(
		(value as any)?.error || (value as any)?.message || (value as any)?.errMsg || value || '调用失败',
	);
	const stripped = stripHtml(raw).trim();
	if (!stripped) return '调用失败';
	if (
		stripped.toLowerCase().includes('generativelanguage.googleapis.com') ||
		(stripped.toLowerCase().includes('request to') && stripped.toLowerCase().includes('failed'))
	) {
		return '模型连接异常，请检查 API 配置';
	}
	return stripped;
}

function buildExportedContext() {
	try {
		if (!chatContext.value) return null;
		if (chatContext.value !== 'liuyao') {
			const input = { bazi: baziStore, ziwei: ziweiStore, qimen: qimenStore }[chatContext.value].input;
			if (typeof input.timestamp !== 'number' || !Number.isFinite(new Date(input.timestamp).getTime())) return null;
		}
		if (chatContext.value === 'qimen') {
			if (!qimenStore.chart) return null;
			const payload = buildQimenExportPayload(qimenStore);
			return {
				prompt: `User Qimen chart (TOON):\n${encodeTOON(payload)}`,
				summary: { type: '奇门盘局', title: payload.input.question || '未填写问题',
					time: civilString(zonedParts(payload.input.timestamp, payload.input.timeZone)), zone: payload.input.timeZone },
			};
		}

		if (chatContext.value === 'liuyao') {
			if (!Array.isArray(liuyaoStore.compiled?.params) || liuyaoStore.compiled.params.length !== 6) return null;
			const payload = buildLiuyaoExportPayload(liuyaoStore);
			return payload ? {
				prompt: `User Liuyao result:\n${payload}`,
				summary: { type: '六爻卦象', title: liuyaoStore.profile?.title || '未填写问题',
					time: payload.split('\n')[0].trim() || '时间未记录', zone: liuyaoStore.calculation?.timeZone || '原时区未记录' },
			} : null;
		}

		if (chatContext.value === 'ziwei') {
			const payload = buildZiweiExportPayload(ziweiStore.input, ziweiStore);
			if (!payload) return null;
			const profile = payload.profile as { name: string; birthTimestamp: number; birthSolarISO: string; timeZone: string | null; timeZoneSource: string };
			return {
				prompt: `User Ziwei profile (TOON):\n${encodeTOON(payload)}`,
				summary: { type: '紫微命盘', title: profile.name,
					time: profile.timeZone ? civilString(zonedParts(profile.birthTimestamp, profile.timeZone)) : profile.birthSolarISO || '时间未记录',
					zone: !profile.timeZone ? '时区未记录' : profile.timeZoneSource === 'legacy-device' ? `${profile.timeZone}（原时区未记录）` : profile.timeZone },
			};
		}

		if (!baziStore.sizhu.year || !baziStore.sizhu.month || !baziStore.sizhu.day || !baziStore.sizhu.time) return null;
		const payload = buildBaziExportPayload(baziStore.input, baziStore, yunStore);
		return payload ? {
			prompt: `User Bazi profile (TOON):\n${encodeTOON(payload)}`,
			summary: { type: '八字命盘', title: payload.basic.name || '未填写姓名',
				time: payload.basic.solarString || '时间未记录', zone: baziStore.input.calculation?.timeZone || '时区未记录' },
		} : null;
	} catch (err) {
		console.error('build context prompt failed:', err);
		return null;
	}
}

function buildContextSystemPrompt(): string | null {
	return exportedContext.value?.prompt || null;
}

function buildMessages(inputText: string): ChatMessage[] {
	const messages: ChatMessage[] = [];
	const text = inputText.trim();
	if (!text) return messages;

	// Each backend request is stateless; chart context belongs in every request,
	// once, without appending it to the user's visible conversation history.
	const systemPrompt = buildContextSystemPrompt();
	if (systemPrompt) {
		messages.push({ role: 'system', content: systemPrompt });
	}

	const historyMessages = panelRef.value?.getMessages?.() || [];
	for (const msg of historyMessages) {
		if (msg?.id === 'm-1') continue;
		if (msg?.status === 'waiting' || msg?.status === 'stream' || msg?.status === 'error') continue;
		const historyText = String(msg?.text || '').trim();
		if (!historyText) continue;

		messages.push({
			role: msg?.role === 'user' ? 'user' : 'assistant',
			content: historyText,
		});
	}

	const lastHistory = messages[messages.length - 1];
	const hasSameLatestUser =
		lastHistory?.role === 'user' && lastHistory.content === text;
	if (!hasSameLatestUser) {
		messages.push({ role: 'user', content: text });
	}

	return messages;
}

async function sendToLLM(text: string) {
	const panel = panelRef.value?.captureSession?.() || panelRef.value;
	if (!panel || sending.value || disposed || !text.trim()) return;
	sending.value = true;
	const controller = new AbortController();
	activeRequest = controller;

	panel.setSending(true);
	panel.createWaitingMessage();

	try {
		if (panel.flushSession) await panel.flushSession();
		if (disposed || controller.signal.aborted || panel.isCurrent?.() === false) return;
		const messages = buildMessages(text);
		if (!messages.length) {
			throw new Error('消息不能为空');
		}

		if (!hasAiConfig()) {
			throw new Error('请先在设置页面配置 AI API');
		}

		let streamedReply = '';
		const returnedReply = await callAi(messages, {
			onThinking: (thinking: string) => {
				if (disposed || controller.signal.aborted || panel.isCurrent?.() === false) return;
				panel.appendThinking?.(thinking);
			},
			onChunk: (chunk: string) => {
				if (disposed || controller.signal.aborted || panel.isCurrent?.() === false) return;
				streamedReply += chunk;
				panel.appendAssistant(chunk, 'stream');
			},
		}, { signal: controller.signal });
		if (disposed || controller.signal.aborted || panel.isCurrent?.() === false) return;

		// Some compatible endpoints return a complete JSON response to a stream request.
		if (!streamedReply.trim() && String(returnedReply || '').trim()) {
			panel.appendAssistant(returnedReply, 'stream');
		}

		const fullReply = streamedReply.trim() ? streamedReply : String(returnedReply || '');
		if (!fullReply.trim()) {
			throw new Error('回复为空，请检查 API 配置');
		}

		panel.finishStreaming();
	} catch (err: any) {
		if (disposed || controller.signal.aborted || panel.isCurrent?.() === false) return;
		const errorText = normalizeError(err);
		panel.appendAssistant(`调用失败：${errorText}`, 'error');
	} finally {
		sending.value = false;
		if (activeRequest === controller) activeRequest = null;
		if (!disposed) panel.setSending(false);
	}
}
</script>
<style scoped>
.chat-panel-wrapper { width:100%; flex:1; min-height:0; }
.chart-context { display:flex; flex-direction:row; align-items:center; gap:16px; padding:16px 20px; border-bottom:1px solid var(--x-line); background:var(--x-tint-end); flex-shrink:0; }
.chart-context-details { display:flex; flex-direction:column; gap:4px; flex:1; min-width:0; }
.chart-context-type { color:var(--x-teal, #287e73); font-size:11px; font-weight:600; }
.chart-context-title { color:var(--x-ink); font-size:15px; font-weight:600; overflow-wrap:anywhere; }
.chart-context-time { color:var(--x-muted); font-size:11px; line-height:1.6; overflow-wrap:anywhere; }
.chart-context-open { flex-shrink:0; margin:0; padding:9px 12px; min-height:40px; border:1px solid var(--x-line); border-radius:8px; background:var(--x-paper); color:var(--x-teal, #287e73); font-size:12px; line-height:20px; }
.chart-context-open::after { border:0; }
.chart-context-open:focus-visible { outline:2px solid var(--x-teal, #287e73); outline-offset:3px; }
.chat-page-shell { display:flex; flex-direction:column; height:calc(100dvh - 230px); min-height:490px; max-height:900px; border:1px solid var(--x-line); border-radius:16px; overflow:hidden; background:var(--x-paper); }
@media(max-width:760px) { .chat-page-shell { height:calc(100dvh - 246px); min-height:430px; } .chart-context { padding:12px 14px; gap:10px; } .chart-context-title { font-size:14px; } }

.archive-toolbar { display:flex; flex-flow:row wrap; align-items:center; justify-content:space-between; gap:10px; padding:12px; border:1px solid var(--x-line); border-radius:12px; color:var(--x-muted); font-size:12px; }
.archive-copy,.archive-btns { display:flex; flex-flow:row wrap; align-items:center; gap:8px; }
.archive-btn,.archive-location-btn { margin:0; min-height:36px; display:flex; align-items:center; padding:0 12px; font-size:12px; border:1px solid var(--x-line); border-radius:8px; color:var(--x-accent); background:var(--x-paper); }
</style>
