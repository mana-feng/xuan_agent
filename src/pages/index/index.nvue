<template>
	<tm-app>
		<PageScaffold
			class="page-bazi-input"
			title="八字排盘"
			subtitle="从出生时刻出发，了解你的四柱、五行与人生节律。"
			tag="BAZI · FOUR PILLARS"
		>
			<view class="form-steps" aria-label="排盘流程">
				<view class="form-step current"
					><text class="step-number">1</text><text>填写信息</text></view
				>
				<view class="form-step"><text class="step-number">2</text><text>查看命盘</text></view>
				<view class="form-step"><text class="step-number">3</text><text>深入解读</text></view>
			</view>
			<view class="birth-form-layout">
				<view class="birth-form-panel">
					<view class="form-section">
						<view class="form-section-heading"
							><text class="section-mark">人</text
							><text class="form-section-title">基本信息</text></view
						>
						<view class="birth-field-grid">
							<view class="birth-field">
								<text class="field-label">称呼<text class="field-optional">选填</text></text>
								<input
									v-model="realname"
									class="birth-name-input"
									placeholder="怎么称呼你？"
									:maxlength="30"
									aria-label="称呼"
								/>
							</view>
							<view class="birth-field">
								<text class="field-label">性别</text>
								<view class="birth-segmented" role="group" aria-label="性别">
									<button
										v-bind="h5Button(() => (gender = 0))"
										class="birth-segment"
										:class="{ selected: Number(gender) === 0 }"
										:aria-pressed="Number(gender) === 0"
										@tap="gender = 0"
									>
										男
									</button>
									<button
										v-bind="h5Button(() => (gender = 1))"
										class="birth-segment"
										:class="{ selected: Number(gender) === 1 }"
										:aria-pressed="Number(gender) === 1"
										@tap="gender = 1"
									>
										女
									</button>
								</view>
							</view>
						</view>
					</view>
					<view class="form-section">
						<TimeCard label="出生时间" :zone="timeZone" :date="birthDisplayDate" :clock="birthDisplayClock"
							:status="model === 0 ? '公历日期 · 精确到分钟' : '农历日期 · 精确到分钟'"
							:alternate-label="model === 0 ? '对应农历' : '对应公历'" :alternate="lunar_label || ''"
							hint="请按所选历法填写出生日期，并核对对应日期。" @edit="SelectTime">
							<template #before>
								<view class="birth-field full">
								<text class="field-label">历法</text>
								<view class="birth-segmented" role="group" aria-label="出生日期历法">
									<button
										v-bind="h5Button(() => (model = 0))"
										class="birth-segment"
										:class="{ selected: model === 0 }"
										:aria-pressed="model === 0"
										@tap="model = 0"
									>
										阳历（公历）
									</button>
									<button
										v-bind="h5Button(() => (model = 1))"
										class="birth-segment"
										:class="{ selected: model === 1 }"
										:aria-pressed="model === 1"
										@tap="model = 1"
									>
										阴历（农历）
									</button>
								</view>
							</view>
							</template>
						</TimeCard>
						<CalendarSettings :time-zone="timeZone" v-model:rules="rules" v-model:overlap-choice="overlapChoice" @update:time-zone="changeTimeZone" />
						<view v-if="bazi_label" class="birth-summary">
							<view class="birth-summary-row"><text class="birth-summary-label">四柱预览</text>
								<view class="pillar-preview"><text v-for="(pillar, i) in bazi_label.split(' ')" :key="i" class="pillar-chip">{{ pillar }}</text></view>
							</view>
						</view>
					</view>
					<view class="birth-form-bottom">
						<text class="birth-time-hint">确认信息后生成命盘，再结合 AI 对话逐步解读。</text>
						<button
							v-bind="h5Button(Sumbit, !canSubmit)"
							class="birth-submit"
							:disabled="!canSubmit"
							@tap="Sumbit"
						>
							开始排盘　→
						</button>
					</view>
				</view>
				<view class="form-help">
					<text class="help-decoration">✧</text>
					<text class="help-title">每个时刻，都有来处</text>
					<text class="help-copy"
						>准确的出生时间，是理解命盘的起点。你可以先向家人确认，或查看出生证明。</text
					>
					<view class="help-list">
						<text class="help-item">01　先确认使用的是阳历还是阴历。</text>
						<text class="help-item">02　出生时间不确定时，请先核对，不必急于填写。</text>
						<text class="help-item">03　排盘后可以保存记录，日后继续查看与提问。</text>
					</view>
					<navigator class="help-link" url="/pages/agent/index">不确定怎么填？问问 AI　→</navigator>
				</view>
			</view>
		</PageScaffold>
		<DateTimeDialog v-if="birthEditorOpen" :date="birthDateDraft" :clock="birthClockDraft" :lunar="model === 1" :leap="birthLeapDraft" :title="model === 0 ? '公历出生时间' : '农历出生时间'" :subtitle="timeZone + ' · 按该时区钟表时间填写'" :external-error="birthEditorError" @edit="birthEditorError = ''" @confirm="confirmBirthTime" @close="birthEditorOpen = false" />
	</tm-app>
</template>
<script lang="ts" setup>
import { h5Button } from '@/utils/keyboard';
import { ref, computed, watch, nextTick } from 'vue';
import { onLoad, onShow } from '@dcloudio/uni-app';
import PageScaffold from '@/components/layout/PageScaffold.vue';
import DateTimeDialog from '@/components/form/DateTimeDialog.vue';
import TimeCard from '@/components/form/TimeCard.vue';
import { deviceTimeZone, type Disambiguation } from '@/utils/chartTime';
import { calendarCivil, calendarTimestamp, calendarValues, resolveCalendar, DEFAULT_CALENDAR_RULES, type CalendarContext } from '@/utils/calendarContext';
import CalendarSettings from '@/components/form/CalendarSettings.vue';
import { lunarCivilToSolar } from '@/utils/ziweiCalendarInput';

import { useUserStore } from '@/store/user';
import { useBaziStore } from '@/store/bazi';

const realname = ref('');
const gender = ref(0);
const model = ref(0);
const timestamp = ref<number | null>(null);
const timeZone = ref(deviceTimeZone());
const rules = ref({ ...DEFAULT_CALENDAR_RULES });
const overlapChoice = ref<Disambiguation>('reject');
const editCalculation = ref<CalendarContext | undefined>();
const datetime_label = ref('');
const lunar_label = ref<string | null>(null);
const birthDisplayDate = computed(() => datetime_label.value.split(' ')[0]?.replace(/[/\-]/g, ' / ') || '');
const birthDisplayClock = computed(() => timestamp.value === null ? '' : calendarCivil(timestamp.value,timeZone.value).slice(11,16) || '');
const bazi_label = ref('');

const user_store = useUserStore();
const bazi_store = useBaziStore();
const recordId = ref<number | null>(null);

const canSubmit = computed(() => timestamp.value !== null);

const birthEditorOpen = ref(false);
const birthDateDraft = ref(''), birthClockDraft = ref('');
const birthLeapDraft = ref(false), birthEditorError = ref('');

watch(model, PullDatatimeLabel);
watch(timestamp, PullDatatimeLabel);
watch(rules, PullDatatimeLabel, { deep: true });
watch(overlapChoice, () => changeTimeZone(timeZone.value));

function initCurrentTime() {
	timestamp.value = new Date().getTime();
	PullDatatimeLabel();
}

let editDataProcessed = false;

onLoad((options: any) => {
	user_store.restoreAuth();

	const editDataStr = uni.getStorageSync('edit_bazi_data');

	if (editDataStr) {
		try {
			const editData = JSON.parse(editDataStr);

			if (editData.isEdit && editData.timestamp) {
				realname.value = editData.realname === '佚名' ? '' : editData.realname || '';
				gender.value =
					editData.gender !== undefined && editData.gender !== null ? editData.gender : 0;
				timeZone.value = editData.calculation?.timeZone || editData.timeZone || deviceTimeZone();
				rules.value = { ...DEFAULT_CALENDAR_RULES, ...editData.calculation?.rules, ...editData.rules };
				editCalculation.value = editData.calculation;
				timestamp.value = editData.timestamp;

				recordId.value = editData.recordId ?? null;

				editDataProcessed = true;

				uni.removeStorageSync('edit_bazi_data');

				nextTick(() => {
					PullDatatimeLabel();
					uni.showToast({
						title: '已加载数据，可进行编辑',
						icon: 'success',
						duration: 2000,
					});
				});
				return;
			}
		} catch (e) {
			console.warn('解析编辑数据失败:', e);
			uni.removeStorageSync('edit_bazi_data');
		}
	}

	realname.value = '';
	gender.value = 0;
	recordId.value = null;
	initCurrentTime();
});

onShow(() => {
	if (editDataProcessed) {
		editDataProcessed = false;
		return;
	}

	const editDataStr = uni.getStorageSync('edit_bazi_data');
	if (editDataStr) {
		try {
			const editData = JSON.parse(editDataStr);
			if (editData.isEdit && editData.timestamp) {
				realname.value = editData.realname === '佚名' ? '' : editData.realname || '';
				gender.value =
					editData.gender !== undefined && editData.gender !== null ? editData.gender : 0;
				timeZone.value = editData.calculation?.timeZone || editData.timeZone || deviceTimeZone();
				rules.value = { ...DEFAULT_CALENDAR_RULES, ...editData.calculation?.rules, ...editData.rules };
				editCalculation.value = editData.calculation;
				timestamp.value = editData.timestamp;
				recordId.value = editData.recordId ?? null;
				uni.removeStorageSync('edit_bazi_data');
				nextTick(() => {
					PullDatatimeLabel();
				});
				return;
			}
		} catch (e) {
			console.warn('解析编辑数据失败:', e);
			uni.removeStorageSync('edit_bazi_data');
		}
	}
});

function changeTimeZone(zone: string) {
  try {
    const civil = calendarCivil(timestamp.value ?? Date.now(), timeZone.value);
    const next = calendarTimestamp(civil,zone,overlapChoice.value);
    timeZone.value = zone; timestamp.value = next; PullDatatimeLabel();
  } catch (error: any) { uni.showToast({ title:error.message, icon:'none' }); }
}
function SelectTime() {
  uni.hideKeyboard();
  const context = resolveCalendar(timestamp.value ?? Date.now(),'bazi',{timeZone:timeZone.value,rules:rules.value});
  const { lunar } = calendarValues(context);
  const pad = (n:number) => String(n).padStart(2,'0');
  birthDateDraft.value = model.value === 1 ? `${lunar.getYear()}-${pad(Math.abs(lunar.getMonth()))}-${pad(lunar.getDay())}` : context.civil.slice(0,10);
  birthClockDraft.value = context.civil.slice(11,16);
  birthLeapDraft.value = lunar.getMonth() < 0; birthEditorError.value = ''; birthEditorOpen.value = true;
}
function confirmBirthTime(value: { date: string; clock: string; leap: boolean }) {
  try {
    const civil = model.value === 1 ? lunarCivilToSolar(value.date,value.clock,value.leap) : `${value.date} ${value.clock}`;
    timestamp.value = calendarTimestamp(civil,timeZone.value,overlapChoice.value); birthEditorOpen.value = false;
  } catch (error:any) { birthEditorError.value = error.message; }
}
function PullDatatimeLabel() {
  if (timestamp.value === null) return;
  const context = resolveCalendar(timestamp.value,'bazi',{timeZone:timeZone.value,rules:rules.value});
  const { lunar, eightChar:bazi } = calendarValues(context);
  bazi_label.value = [bazi.getYear(),bazi.getMonth(),bazi.getDay(),bazi.getTime()].join(' ');
  const civil = context.civil.slice(0,16).replace(/-/g,'/');
  const lunarStr = `${lunar.toString()} ${lunar.getTimeZhi()}时`;
  datetime_label.value = model.value === 0 ? civil : lunarStr;
  lunar_label.value = model.value === 0 ? lunarStr : civil;
}

function Sumbit() {
	const datetime = timestamp.value;
	if (datetime === null) {
		uni.showToast({
			title: '请先选择出生日期和时间',
			icon: 'none',
			duration: 2000,
		});
		SelectTime();
		return;
	}

	const params = {
		realname: (realname.value || '').trim(),
		timestamp: datetime,
		gender: Number(gender.value),
		recordId: recordId.value,
		timeZone: timeZone.value,
		rules: rules.value,
		calculation: editCalculation.value?.timestamp === datetime && editCalculation.value?.timeZone === timeZone.value && JSON.stringify(editCalculation.value.rules) === JSON.stringify(rules.value) ? editCalculation.value : undefined,
	};
	uni.showLoading({
		title: '排盘中，请稍后！',
	});

	try {
		bazi_store.pull(params);

		setTimeout(() => {
			uni.hideLoading();

			if (!bazi_store.solar || !bazi_store.solar.year) {
				uni.showToast({
					title: '排盘数据不完整，请重试',
					icon: 'none',
					duration: 2000,
				});
				return;
			}

			uni.navigateTo({
				url: '/pages/index/detail',
				fail: (err) => {
					console.error('跳转失败:', err);
					uni.showToast({
						title: '跳转失败，请重试',
						icon: 'none',
						duration: 2000,
					});
				},
			});
		}, 200);
	} catch (error: any) {
		uni.hideLoading();
		console.error('排盘失败:', error);
		uni.showToast({
			title: '排盘计算失败：' + (error?.message || '未知错误'),
			icon: 'none',
			duration: 2000,
		});
	}
}
</script>
<style scoped>
.form-steps {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 18px;
	align-items: center;
	margin: 3px 0 25px;
	color: var(--x-muted, #667d82);
	font-size: 12px;
}
.form-step {
	display: flex;
	flex-direction: row;
	gap: 7px;
	align-items: center;
}
.step-number {
	display: inline-flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 23px;
	height: 23px;
	border: 1px solid var(--x-line, #dbe9ed);
	border-radius: 50%;
	font-size: 11px;
}
.form-step.current {
	color: var(--x-accent, #1672b1);
}
.current .step-number {
	background: var(--x-gradient, linear-gradient(120deg, #1672b1, #11785f));
	color: #fff;
	border-color: transparent;
}
