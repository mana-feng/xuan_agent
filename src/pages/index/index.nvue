	min-width: 0;
	background: var(--x-paper, #fff);
	border: 1px solid var(--x-line, #dbe9ed);
	border-radius: 16px;
	padding: 30px;
	box-shadow: 0 8px 32px #233e4905;
}
.form-section + .form-section {
	border-top: 1px solid var(--x-line, #dbe9ed);
	padding-top: 27px;
	margin-top: 27px;
}
.form-section,
.form-help {
	display: block;
}
.form-section-heading {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10px;
	margin-bottom: 23px;
}
.section-mark {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 27px;
	height: 27px;
	border-radius: 8px;
	background: var(--x-tint, #e7f4fc);
	color: var(--x-accent, #1672b1);
	font-size: 15px;
}
.form-section-title {
	font-family: var(--x-serif, 'Noto Serif SC', 'Songti SC', SimSun, serif);
	font-size: 21px;
	color: var(--x-ink, #233e49);
	font-weight: 500;
}
.birth-field-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 22px;
}
.birth-field {
	min-width: 0;
	display: flex;
	flex-direction: column;
	gap: 10px;
}
.birth-field.full {
	grid-column: 1 / -1;
}
.field-label {
	font-size: 13px;
	color: var(--x-body, #425d65);
}
.field-optional {
	font-size: 11px;
	color: var(--x-muted, #667d82);
	margin-left: 7px;
}
.birth-name-input {
	width: 100%;
	height: 45px;
	padding: 0 13px;
	border: 1px solid var(--x-line, #dbe9ed);
	border-radius: 8px;
	background: var(--x-paper, #fff);
	color: var(--x-ink, #233e49);
	box-sizing: border-box;
	font-size: 13px;
}
.birth-segmented {
	display: flex;
	flex-direction: row;
	padding: 3px;
	min-height: 45px;
	background: var(--x-tint, #e7f4fc);
	border: 1px solid var(--x-line, #dbe9ed);
	border-radius: 8px;
	box-sizing: border-box;
	gap: 4px;
}
.birth-segment {
	flex: 1;
	margin: 0;
	padding: 7px 8px;
	line-height: 23px;
	border: 0;
	border-radius: 5px;
	background: transparent;
	color: var(--x-muted, #667d82);
	font-size: 12px;
}
.birth-segment.selected {
	background: var(--x-paper, #fff);
	color: var(--x-accent, #1672b1);
	box-shadow: 0 1px 5px #233e4910;
}
button::after {
	border: 0;
}
.birth-time-control {
	width: 100%;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	margin: 0;
	padding: 15px 16px;
