	font-size: 11px;
	color: var(--x-muted, #667d82);
	line-height: 1.85;
}
.birth-summary {
	padding: 16px;
	border: 1px solid var(--x-line, #dbe9ed);
	border-radius: 10px;
	background: var(--x-gradient-soft, linear-gradient(125deg, #e7f4fc, #fff, #e6f6ed));
	display: flex;
	flex-direction: column;
	gap: 15px;
	margin-top: 20px;
}
.birth-summary-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	gap: 16px;
}
.birth-summary-label {
	font-size: 11px;
	color: var(--x-muted, #667d82);
	flex-shrink: 0;
}
.birth-summary-value {
	font-size: 13px;
	color: var(--x-body, #425d65);
	text-align: right;
}
.pillar-preview {
	display: flex;
	flex: 1;
	min-width: 0;
	justify-content: flex-end;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 9px;
}
.pillar-chip {
	border: 1px solid var(--x-line, #dbe9ed);
	padding: 6px 11px;
	border-radius: 7px;
	color: var(--x-accent, #1672b1);
	background: var(--x-paper, #fff);
	font-family: var(--x-serif, SimSun, serif);
	font-size: 19px;
}
.birth-form-bottom {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	gap: 18px;
	padding-top: 24px;
	margin-top: 27px;
	border-top: 1px solid var(--x-line, #dbe9ed);
}
.birth-form-bottom .birth-time-hint {
	max-width: 240px;
}
.birth-submit {
	flex-shrink: 0;
	min-width: 140px;
	margin: 0;
	border-radius: 9px;
	padding: 12px 22px;
	line-height: 23px;
	font-size: 13px;
	color: #fff;
	background: var(--x-gradient, linear-gradient(120deg, #1672b1, #11785f));
}
.birth-submit[disabled] {
	opacity: 0.45;
	color: #fff;
}
.form-help {
	border: 1px solid var(--x-line, #dbe9ed);
	border-radius: 14px;
	padding: 25px 23px;
	background: var(--x-gradient-soft, linear-gradient(125deg, #e7f4fc, #fff, #e6f6ed));
}
