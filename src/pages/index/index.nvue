}
.help-copy {
	display: block;
	font-size: 12px;
	line-height: 1.95;
	color: var(--x-muted, #667d82);
	margin-top: 12px;
}
.help-list {
	display: flex;
	flex-direction: column;
	gap: 13px;
	margin-top: 20px;
	padding-top: 17px;
	border-top: 1px solid var(--x-line, #dbe9ed);
}
.help-item {
	font-size: 11px;
	line-height: 1.85;
	color: var(--x-body, #425d65);
}
.help-link {
	display: block;
	font-size: 12px;
	color: var(--x-accent, #1672b1);
	margin-top: 21px;
	padding-top: 14px;
	border-top: 1px solid var(--x-line, #dbe9ed);
}
@media (max-width: 1080px) {
	.birth-form-layout {
		grid-template-columns: minmax(0, 1fr) 210px;
		gap: 17px;
	}
	.birth-form-panel {
		padding: 25px;
	}
	.form-help {
		padding: 22px 18px;
	}
}
@media (max-width: 800px) {
	.birth-form-layout {
		grid-template-columns: 1fr;
	}
	.form-help {
		margin-top: 0;
	}
	.help-list {
		margin-top: 12px;
	}
}
@media (max-width: 520px) {
	.birth-form-panel {
		padding: 21px 17px;
		border-radius: 12px;
	}
	.birth-field-grid {
		grid-template-columns: 1fr;
		gap: 19px;
	}
