.user-actions { display: flex; flex-direction: column; gap: 12px; margin-top: 28px; }
.error-message { display: flex; flex-direction: row; align-items: center; gap: 6px; padding: 12px; border: 1px solid #f1dcd6; border-radius: 10px; background: #fff5f2; }
@media (max-width: 900px) {
	.admin-auth-page { padding: 24px; }
	.auth-shell { min-height: 640px; }
