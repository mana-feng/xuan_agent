.auth-welcome-footer { color: #7d938c; font-size: 11px; letter-spacing: 1px; }
.auth-panel { min-width: 0; padding: 56px 48px 24px; display: flex; flex-direction: column; justify-content: center; }
.auth-card { display: flex; flex-direction: column; width: 100%; max-width: 370px; margin: auto; }
.auth-card-kicker { display: block; color: var(--admin-accent, #177b7b); font-size: 12px; font-weight: 600; letter-spacing: 1px; }
.auth-card-title { display: block; margin-top: 12px; color: var(--admin-ink, #203c39); font: 30px/1.5 'Noto Serif SC', 'Songti SC', 'STSong', serif; }
.auth-card-description { display: block; margin-top: 12px; color: var(--admin-muted, #7d8e8c); font-size: 13px; line-height: 1.8; }
.form-content { margin-top: 34px; display: flex; flex-direction: column; gap: 22px; }
.input-wrapper { width: 100%; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
.input-label { font-size: 13px; font-weight: 600; color: var(--admin-body, #425a58); }
.login-input { width:100%!important; }
.login-input :deep(input) { font-size: 14px !important; }
.input-wrapper :deep(.tm-input), .input-wrapper :deep(.tm-input__wrap) { width: 100% !important; }
.auth-primary { margin-top: 6px !important; border-radius: 12px !important; background: var(--admin-gradient, linear-gradient(125deg, #4a8aaf, #479981)) !important; box-shadow: 0 7px 18px rgba(39, 119, 111, .14) !important; }
.auth-primary :deep(.button) { min-height: 44px; }
.auth-primary :deep(text), .auth-primary :deep(uni-text) { color: #fff !important; }
.auth-secondary, .auth-logout { border-radius: 12px !important; box-shadow: none !important; }
.auth-card-note { margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--admin-line, #dfe9e6); display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 7px; color: var(--admin-muted, #7d8e8c); font-size: 11px; line-height: 1.7; }
.auth-panel-footer { display: block; padding-top: 32px; text-align: center; color: #98a6a1; font-size: 11px; }
