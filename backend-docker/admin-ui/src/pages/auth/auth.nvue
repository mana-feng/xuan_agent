<template>
	<tm-app>
		<view class="page-wrapper admin-auth-page">
			<view class="auth-shell">
				<view class="auth-welcome">
					<view class="auth-brand"><view class="auth-brand-mark">玄</view><text class="auth-brand-name">玄学 AI</text><text class="auth-brand-tag">管理端</text></view>
					<view class="auth-welcome-copy">
						<text class="auth-eyebrow">ADMIN WORKSPACE</text>
						<text class="auth-title">玄学 AI
管理工作台</text>
						<text class="auth-description">在一个工作台中管理用户、排盘记录
与 AI 服务配置。</text>
						<view class="auth-scope-list">
							<view class="auth-scope"><text class="auth-scope-number">01</text><view><text class="auth-scope-title">用户与记录</text><text class="auth-scope-copy">查看账号状态，管理排盘记录</text></view></view>
							<view class="auth-scope"><text class="auth-scope-number">02</text><view><text class="auth-scope-title">AI 与额度</text><text class="auth-scope-copy">配置模型服务，维护使用额度</text></view></view>
							<view class="auth-scope"><text class="auth-scope-number">03</text><view><text class="auth-scope-title">站点与服务</text><text class="auth-scope-copy">发布公告，管理邮件与访问统计</text></view></view>
						</view>
					</view>
					<text class="auth-welcome-footer">玄学 AI · 后台管理工作台</text>
				</view>

				<view class="auth-panel">
					<view v-if="isLoggedIn" class="auth-card user-info-card">
						<view class="auth-card-topline"><text class="auth-card-kicker">账号状态</text><text class="auth-state">已登录</text></view>
						<view class="user-avatar"><tm-icon name="tmicon-user-circle" :font-size="64" color="#177b7b"></tm-icon></view>
						<text class="auth-card-title">欢迎回来</text>
						<tm-text class="user-name" :font-size="30" :bold="true" :label="'你好，' + (user_store.username || user_store.email || '已登录用户')" :margin="[0, 0, 0, 0]"></tm-text>
						<text class="auth-card-description">当前登录账号会自动保存排盘记录。</text>
						<view class="user-actions">
							<tm-button v-if="user_store.isAdmin" class="admin-control auth-primary" type="primary" color="#177b7b" font-color="#ffffff" :follow-theme="false" block :margin="[0, 0, 0, 0]" :round="8" :height="88" :font-size="30" label="进入管理员后台" @tap="goToAdmin"></tm-button>
							<tm-button class="admin-control auth-secondary" type="primary" color="#eef6f5" font-color="#177b7b" :follow-theme="false" block :margin="[0, 0, 0, 0]" :round="8" :height="88" :font-size="30" label="返回上一页" @tap="goBack"></tm-button>
							<tm-button class="admin-control auth-logout" type="danger" color="#fff5f3" font-color="#ad5348" :follow-theme="false" block :margin="[0, 0, 0, 0]" :round="8" :height="88" :font-size="28" label="退出登录" @tap="logout"></tm-button>
						</view>
					</view>

					<view v-else class="auth-card login-card">
						<text class="auth-card-kicker">欢迎回来</text>
						<text class="auth-card-title">管理员登录</text>
						<text class="auth-card-description">使用管理员账号进入后台工作台。</text>
						<view class="form-content">
							<view class="input-wrapper"><text class="input-label">邮箱或用户名</text><yx-admin-input :height="88" v-model="loginIdentifier" @input="loginError = ''" placeholder="请输入邮箱或用户名" prefix="account" clearable :border="1" :round="8" :padding="[20, 20]" class="login-input"></yx-admin-input></view>
							<view class="input-wrapper"><text class="input-label">登录密码</text><yx-admin-input :height="88" v-model="loginPassword" @input="loginError = ''" type="password" placeholder="请输入密码" prefix="lock" clearable :border="1" :round="8" :padding="[20, 20]" class="login-input"></yx-admin-input></view>
							<view v-if="loginError" class="error-message"><tm-icon name="tmicon-times-circle" :font-size="22" color="#ad5348" :margin="[0, 8, 0, 0]"></tm-icon><tm-text :font-size="24" color="#ad5348" :label="loginError"></tm-text></view>
							<tm-button class="admin-control auth-primary" :margin="[0, 0, 0, 0]" type="primary" color="#177b7b" font-color="#ffffff" :follow-theme="false" block :loading="loginLoading" :disabled="loginLoading || !loginIdentifier || !loginPassword" label="登录管理后台" :round="8" :height="88" :font-size="30" :bold="true" @tap="submitLogin"></tm-button>
						</view>
						<view class="auth-card-note"><tm-icon name="tmicon-lock" :font-size="24" color="#7d8e8c"></tm-icon><text>仅限管理员账号访问后台功能</text></view>
					</view>
					<text class="auth-panel-footer">玄学 AI 管理端</text>
				</view>
			</view>
		</view>
	</tm-app>
</template>

<script lang="ts" setup>
import { ref, computed, onMounted } from 'vue';
import { useUserStore } from '@/store/user';
import { request } from '@/services/api/index';
import { getDeviceId } from '@/utils/device';
import { sanitizeInput } from '@/utils/sanitize';

const user_store = useUserStore();

const isLoggedIn = computed(() => user_store.isLoggedIn);
const loginIdentifier = ref('');
const loginPassword = ref('');
const loginLoading = ref(false);
const loginError = ref('');

onMounted(() => {
	user_store.restoreAuth();
	// 管理员已登录则跳后台
	if (user_store.isAdmin) {
		uni.reLaunch({ url: '/pages/admin/dashboard' });
		return;
	}
	// 非管理员已登录则保持状态
});

async function submitLogin() {
	if (!loginIdentifier.value || !loginPassword.value) {
		loginError.value = '请输入账号和密码';
		return;
	}
	loginLoading.value = true;
	loginError.value = '';

	const deviceId = getDeviceId();
	const safeIdentifier = sanitizeInput(loginIdentifier.value, 255);
	// 密码不应进行字符清理，只做长度截取
	const safePassword = loginPassword.value.slice(0, 128);

	try {
		const res = await request('/api/auth/login', {
			method: 'POST',
			data: { identifier: safeIdentifier, password: safePassword, device_id: deviceId }
		});

		if (!res.success) {
			loginError.value = res.message || res.error || '登录失败，请稍后重试';
			return;
		}

		const payload: any = res.data || {};
		if (!payload.access_token) {
			loginError.value = res.message || '登录失败，请稍后重试';
			return;
		}

		const user = payload.user || {};
		user_store.setAuth({
			username: user?.username || null,
			email: user?.email,
			access_token: payload.access_token,
			refresh_token: payload.refresh_token,
			role: user?.role || 'user'
		});

		uni.showToast({ title: '登录成功', icon: 'success', duration: 1500 });
		setTimeout(() => {
			if (user?.role === 'admin') {
				uni.reLaunch({ url: '/pages/admin/dashboard' });
			} else {
				uni.navigateBack();
			}
		}, 600);
	} catch (err: any) {
		loginError.value = err?.message || '网络错误，请检查后端是否已启动';
	} finally {
		loginLoading.value = false;
	}
}

function goBack() {
	uni.navigateBack();
}

function goToAdmin() {
	if (isLoggedIn.value && user_store.isAdmin) {
		uni.navigateTo({ url: '/pages/admin/dashboard' });
	} else {
		uni.navigateTo({ url: '/pages/auth/auth' });
	}
}

async function logout() {
	await user_store.logout();
	uni.showToast({ title: '已退出登录', icon: 'none', duration: 1200 });
}
</script>

<style scoped>
