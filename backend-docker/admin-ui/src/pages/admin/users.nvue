<template>
	<tm-app>
		<view class="page-wrapper theme-page-bg admin-workbench admin-page-users">
			<yx-nav-header></yx-nav-header>

			<view class="page-content theme-container" :style="pageContentStyle">
				<view class="page-heading">
					<text class="page-eyebrow">账户与权限</text>
					<h1 class="page-title">用户管理</h1>
					<text class="page-description">查找用户、维护账户资料与管理员权限。</text>
				</view>
				<view class="theme-card theme-card-glass">
					<!-- 顶部操作栏 -->
					<view class="filter-panel">
						<view class="top-bar">
							<view class="search-bar">
								<text class="field-label">邮箱 / 用户名</text>
								<yx-admin-input
:height="88"
									v-model="searchKeyword"
									placeholder="搜索邮箱或用户名"
									prefix="search"
									clearable
									@input="handleSearch"
								></yx-admin-input>
							</view>
							<view class="top-bar-buttons">
								<yx-teal-button
									class="admin-action-secondary"
									size="small"
									label="返回主页"
									icon="tmicon-md-home"
									@tap="goToHome"
									:margin="[0, 12, 0, 0]"
								></yx-teal-button>
								<yx-teal-button
									size="small"
									label="创建用户"
									@tap="handleCreateUser"
									:margin="[0, 0, 0, 0]"
								></yx-teal-button>
							</view>
						</view>

						<!-- 用户列表 -->
					</view>
					<view class="users-list-heading">
						<view class="users-list-title"><text>用户列表</text><text class="users-total">{{ total }} 位用户</text></view>
						<text class="users-list-caption">管理账户资料与访问权限</text>
					</view>
					<view class="users-panel">
						<view class="users-columns" aria-hidden="true">
							<text>账号资料</text><text>角色</text><text>排盘记录</text><text>注册时间</text><text class="users-column-actions">操作</text>
						</view>
						<view class="users-rows" role="list" aria-label="用户列表">
							<view v-for="user in userList" :key="user.id" class="users-row" role="listitem">
								<view class="users-account">
									<view class="users-avatar" aria-hidden="true">{{ (user.username || user.email || 'U').slice(0, 1).toUpperCase() }}</view>
									<view class="users-account-copy">
										<text class="users-name">{{ user.username || '未设置用户名' }}</text>
										<text class="users-email">{{ user.email }}</text>
									</view>
								</view>
								<view class="users-role-cell"><text class="users-role" :class="{ 'users-role-admin': user.role === 'admin' }">{{ user.role === 'admin' ? '管理员' : '普通用户' }}</text></view>
								<view class="users-records"><text class="users-mobile-label">排盘记录</text><text class="users-count">{{ user.recordCount || 0 }}<text class="users-count-unit"> 条</text></text></view>
								<view class="users-date"><text class="users-mobile-label">注册时间</text><text>{{ formatDate(user.created_at) || '—' }}</text></view>
								<view class="users-actions">
									<view class="users-action users-action-edit" :aria-label="'编辑用户 ' + (user.username || user.email)" v-bind="h5Button(() => handleEditUser(user))" @click="handleEditUser(user)">编辑</view>
									<view class="users-action" :aria-label="(user.role === 'admin' ? '取消管理员权限：' : '设为管理员：') + (user.username || user.email)" v-bind="h5Button(() => handleChangeRole(user.id, user.role === 'admin' ? 'user' : 'admin'))" @click="handleChangeRole(user.id, user.role === 'admin' ? 'user' : 'admin')">{{ user.role === 'admin' ? '取消管理员' : '设为管理员' }}</view>
									<view class="users-action users-action-delete" :aria-label="'删除用户 ' + (user.username || user.email)" v-bind="h5Button(() => handleDeleteUser(user.id))" @click="handleDeleteUser(user.id)">删除</view>
								</view>
							</view>
						</view>
						<view v-if="userList.length === 0 && !loading" class="users-empty"><text class="users-empty-title">暂无匹配用户</text><text>试试其他邮箱或用户名。</text></view>
					</view>

					<!-- 分页 -->
					<view class="pagination" v-if="totalPages > 1">
						<yx-teal-button
							class="admin-action-secondary"
							size="small"
							:disabled="currentPage === 1"
							label="上一页"
							@tap="handlePrevPage"
						></yx-teal-button>
						<tm-text :margin="[0, 20]" :label="`${currentPage} / ${totalPages}`"></tm-text>
						<yx-teal-button
							class="admin-action-secondary"
							size="small"
							:disabled="currentPage === totalPages"
							label="下一页"
							@tap="handleNextPage"
						></yx-teal-button>
					</view>
				</view>
			</view>

			<!-- 创建/编辑用户弹窗 -->
			<yx-admin-dialog v-model:show="showUserDialog" :title="editingUser ? '编辑用户' : '创建用户'" eyebrow="账户管理" description="请核对填写的信息后保存。">
				<view class="user-form">
					<yx-admin-input
:height="88"
						v-model="userForm.email"
						label="邮箱"
						placeholder="请输入邮箱"
						:margin="[0, 0, 20, 0]"
						required
					></yx-admin-input>

					<yx-admin-input
:height="88"
						v-model="userForm.username"
						label="用户名（可选）"
						placeholder="请输入用户名"
						:margin="[0, 0, 20, 0]"
					></yx-admin-input>

					<yx-admin-input
:height="88"
						v-model="userForm.password"
						label="密码"
						:placeholder="editingUser ? '留空则不修改密码' : '请输入密码'"
						type="password"
						:margin="[0, 0, 20, 0]"
						:required="!editingUser"
					></yx-admin-input>

					<view class="form-item">
						<tm-text :font-size="24" :margin="[0, 0, 10, 0]" label="角色"></tm-text>
						<tm-radio-group class="admin-choice-group" v-model="userForm.role" model="button">
							<tm-radio class="admin-choice" :class="{ 'is-selected': String(userForm.role) === 'user' }" label="普通用户" value="user"></tm-radio>
							<tm-radio class="admin-choice" :class="{ 'is-selected': String(userForm.role) === 'admin' }" label="管理员" value="admin"></tm-radio>
						</tm-radio-group>
					</view>

					<view v-if="userFormError" class="error-text">
						<tm-text :label="userFormError" color="#ff4d4f"></tm-text>
					</view>


				</view>

<template #footer>
<yx-teal-button
							class="admin-action-secondary"
							block
							size="small"
							label="取消"
							@tap="handleCancelUser"
							:margin="[20, 0, 0, 0]"
						></yx-teal-button>
<yx-teal-button
							block
							size="small"
							:loading="userFormLoading"
							:label="editingUser ? '保存' : '创建'"
							@tap="handleSubmitUser"
							:margin="[20, 0, 0, 0]"
						></yx-teal-button>
</template>
</yx-admin-dialog>
		</view>
	</tm-app>
</template>

<script setup lang="ts">
import { ref, onMounted, computed } from 'vue';
import { h5Button } from '@/utils/keyboard';
import { useUserStore } from '@/store/user';
import { getUserList, updateUserRole, deleteUser, createUser, updateUser, type UserInfo } from '@/services/api/admin';

const userStore = useUserStore();
const userList = ref<UserInfo[]>([]);
const searchKeyword = ref('');
const currentPage = ref(1);
const pageSize = ref(20);
const total = ref(0);
const totalPages = ref(0);
const loading = ref(false);

// navbar 高度（rpx），与 yx-nav-header 中的 navbarHeight 保持一致
const navbarHeight = 40;

// 计算页面内容的 padding-top，避免被 fixed 的 header 遮挡
const pageContentStyle = computed(() => {
	return {
		paddingTop: `${navbarHeight + 20}rpx` // navbar高度 + 原有padding
	};
});

// 用户表单相关
const showUserDialog = ref(false);
const editingUser = ref<UserInfo | null>(null);
const userForm = ref({
	email: '',
	username: '',
	password: '',
	role: 'user' as 'user' | 'admin'
});
const userFormError = ref('');
const userFormLoading = ref(false);

onMounted(() => {
	if (!userStore.isAdmin) {
		uni.reLaunch({
			url: '/pages/auth/auth'
		});
		return;
	}
	
	loadUsers();
});

async function loadUsers() {
	loading.value = true;
	try {
		const res = await getUserList({
			page: currentPage.value,
			pageSize: pageSize.value,
			search: searchKeyword.value || undefined
		});
		
		if (res.success && res.data) {
			const list = Array.isArray(res.data.list) ? res.data.list : [];
			userList.value = list;
			total.value = Number(res.data.total ?? list.length ?? 0);
			totalPages.value = Number(res.data.totalPages ?? Math.ceil((total.value || 0) / pageSize.value) ?? 0);
		} else {
			userList.value = [];
			total.value = 0;
			totalPages.value = 0;
		}
	} catch (err) {
		console.error('加载用户列表失败:', err);
		uni.showToast({
			title: '加载失败',
			icon: 'none'
		});
	} finally {
		loading.value = false;
	}
}

function handleSearch() {
	currentPage.value = 1;
	loadUsers();
}

function handlePrevPage() {
	if (currentPage.value > 1) {
		currentPage.value--;
		loadUsers();
	}
}

function handleNextPage() {
	if (currentPage.value < totalPages.value) {
		currentPage.value++;
		loadUsers();
	}
}

async function handleChangeRole(userId: number, role: 'user' | 'admin') {
	uni.showModal({
		title: '确认操作',
		content: `确定要将该用户${role === 'admin' ? '设为管理员' : '取消管理员权限'}吗？`,
		success: async (res) => {
			if (res.confirm) {
				try {
					const result = await updateUserRole(userId, role);
					if (result.success) {
						uni.showToast({
							title: '操作成功',
							icon: 'success'
						});
						loadUsers();
					} else {
						uni.showToast({
							title: result.error || '操作失败',
							icon: 'none'
						});
					}
				} catch (err: any) {
					uni.showToast({
						title: err.error || '操作失败',
						icon: 'none'
					});
				}
			}
		}
	});
}

async function handleDeleteUser(userId: number) {
	uni.showModal({
		title: '确认删除',
		content: '删除用户将同时删除该用户的所有八字记录，此操作不可恢复，确定要删除吗？',
		success: async (res) => {
			if (res.confirm) {
				try {
					const result = await deleteUser(userId);
					if (result.success) {
						uni.showToast({
							title: '删除成功',
							icon: 'success'
						});
						loadUsers();
					} else {
						uni.showToast({
							title: result.error || '删除失败',
							icon: 'none'
						});
					}
				} catch (err: any) {
					uni.showToast({
						title: err.error || '删除失败',
						icon: 'none'
					});
				}
			}
		}
	});
}

function goToHome() {
	uni.reLaunch({
		url: '/pages/admin/dashboard'
	});
}

function formatDate(dateStr: string) {
	if (!dateStr) return '';
	const date = new Date(dateStr);
	return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

function handleCreateUser() {
	editingUser.value = null;
	userForm.value = {
		email: '',
		username: '',
		password: '',
		role: 'user'
	};
	userFormError.value = '';
	showUserDialog.value = true;
}

function handleEditUser(user: UserInfo) {
	editingUser.value = user;
	userForm.value = {
		email: user.email,
		username: user.username || '',
		password: '',
		role: user.role
	};
	userFormError.value = '';
	showUserDialog.value = true;
}

function handleCancelUser() {
	showUserDialog.value = false;
	editingUser.value = null;
	userFormError.value = '';
}

async function handleSubmitUser() {
	userFormError.value = '';
	
	if (!userForm.value.email) {
		userFormError.value = '请输入邮箱';
		return;
	}
	
	if (!editingUser.value && !userForm.value.password) {
		userFormError.value = '请输入密码';
		return;
	}
	
	userFormLoading.value = true;
	try {
		if (editingUser.value) {
			// 编辑用户
			const params: any = {
				email: userForm.value.email,
				role: userForm.value.role
			};
			if (userForm.value.username !== editingUser.value.username) {
				params.username = userForm.value.username || null;
			}
			if (userForm.value.password) {
				params.password = userForm.value.password;
			}
			
			const result = await updateUser(editingUser.value.id, params);
			if (result.success) {
				uni.showToast({
					title: '保存成功',
					icon: 'success'
				});
				showUserDialog.value = false;
				loadUsers();
			} else {
				userFormError.value = result.error || '保存失败';
			}
		} else {
			// 创建用户
			const result = await createUser({
				email: userForm.value.email,
				username: userForm.value.username || undefined,
				password: userForm.value.password,
				role: userForm.value.role
			});
			if (result.success) {
				uni.showToast({
					title: '创建成功',
					icon: 'success'
				});
				showUserDialog.value = false;
				loadUsers();
			} else {
				userFormError.value = result.error || '创建失败';
			}
		}
	} catch (err: any) {
		userFormError.value = err.error || '操作失败';
	} finally {
		userFormLoading.value = false;
	}
}
</script>

<style scoped>
.page-heading {
	display: flex;
	flex-direction: column;
	gap: 8px;
	margin-bottom: 24px;
}
.page-eyebrow {
	color: var(--admin-accent, #169e9a);
