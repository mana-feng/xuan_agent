		gap: 6px;
		flex-direction: column;
	}
	.user-form,
	.record-form,
	.record-detail {
		padding: 16px;
	}
}

/* Compact account directory; mobile cards share the same data and actions. */
.users-list-heading, .users-list-title { display: flex; flex-direction: row; align-items: center; gap: 12px; }
.users-list-heading { justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; }
.users-list-title { color: var(--admin-ink, #20374a); font-size: 16px; font-weight: 600; }
.users-total { padding: 4px 10px; border-radius: 20px; background: var(--admin-soft, #f1f8f8); color: var(--admin-muted, #788c9d); font-size: 11px; font-weight: 500; }
.users-list-caption { color: var(--admin-muted, #788c9d); font-size: 12px; }
.users-panel { overflow: hidden; border: 1px solid var(--admin-line, #e5edf2); border-radius: 16px; background: var(--admin-paper, #fff); }
.users-columns, .users-row { display: grid; grid-template-columns: minmax(190px, 1fr) 96px 80px 112px 242px; align-items: center; gap: 18px; padding: 0 22px; }
.users-columns { min-height: 46px; background: var(--admin-soft, #f5fafb); color: var(--admin-muted, #788c9d); font-size: 11px; font-weight: 600; letter-spacing: .4px; }
.users-column-actions { text-align: right; }
.users-row { min-height: 92px; padding-top: 16px; padding-bottom: 16px; box-sizing: border-box; transition: background .15s; }
.users-row + .users-row { border-top: 1px solid var(--admin-line, #e5edf2); }
.users-row:hover { background: var(--admin-soft, #f5fafb); }
.users-account { display: flex; flex-direction: row; align-items: center; gap: 12px; min-width: 0; }
.users-avatar { display: flex; align-items: center; justify-content: center; flex: 0 0 38px; width: 38px; height: 38px; border: 1px solid var(--admin-line, #e5edf2); border-radius: 12px; background: var(--admin-soft, #f1f8f8); color: var(--admin-accent, #169e9a); font-size: 16px; font-weight: 600; }
.users-account-copy { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.users-name { color: var(--admin-ink, #20374a); font-size: 14px; font-weight: 600; line-height: 1.5; overflow-wrap: anywhere; }
.users-email { color: var(--admin-muted, #788c9d); font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
.users-role-cell { display: flex; flex-direction: row; }
.users-role { display: inline-flex; align-items: center; width: fit-content; padding: 5px 10px; border: 1px solid var(--admin-line, #e5edf2); border-radius: 20px; background: var(--admin-soft, #f5fafb); color: var(--admin-body, #50677b); font-size: 11px; line-height: 1.4; white-space: nowrap; }
.users-role-admin { background: var(--admin-active, #e7f5f1); border-color: transparent; color: var(--admin-accent, #169e9a); font-weight: 600; }
.users-records, .users-date { color: var(--admin-body, #50677b); font-size: 12px; }
.users-count { color: var(--admin-ink, #20374a); font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; }
.users-count-unit { color: var(--admin-muted, #788c9d); font-size: 11px; font-weight: 400; }
.users-mobile-label { display: none; }
.users-actions { display: flex; flex-direction: row; justify-content: flex-end; align-items: center; gap: 6px; }
.users-action { display: flex; flex-direction: row; align-items: center; justify-content: center; min-height: 36px; padding: 0 11px; box-sizing: border-box; border: 1px solid var(--admin-line, #e5edf2); border-radius: 9px; background: var(--admin-paper, #fff); color: var(--admin-body, #50677b); font-size: 12px; line-height: 1.4; white-space: nowrap; cursor: pointer; }
.users-action-edit { background: var(--admin-soft, #f1f8f8); color: var(--admin-accent, #169e9a); }
.users-action:hover { border-color: var(--admin-accent, #169e9a); color: var(--admin-accent, #169e9a); }
.users-action:focus-visible { outline: 2px solid var(--admin-accent, #169e9a); outline-offset: 3px; }
.users-action-delete { border-color: transparent; background: transparent; color: #b65e60; }
.users-action-delete:hover { border-color: #f1d9db; background: #fff3f3; color: #b64c51; }
.users-empty { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 48px 20px; color: var(--admin-muted, #788c9d); font-size: 12px; }
.users-empty-title { color: var(--admin-body, #50677b); font-size: 14px; font-weight: 600; }
@media (max-width: 1199px) {
 .users-columns { display: none; }
 .users-panel { border: 0; border-radius: 0; background: transparent; overflow: visible; }
 .users-rows { display: flex; flex-direction: column; gap: 12px; }
 .users-row { grid-template-columns: minmax(0, 1fr) auto; gap: 18px 14px; padding: 18px; border: 1px solid var(--admin-line, #e5edf2); border-radius: 14px; background: var(--admin-paper, #fff); }
 .users-row + .users-row { border-top: 1px solid var(--admin-line, #e5edf2); }
 .users-role-cell { justify-content: flex-end; align-self: start; }
 .users-records, .users-date { display: flex; flex-direction: column; gap: 6px; }
 .users-mobile-label { display: block; color: var(--admin-muted, #788c9d); font-size: 11px; font-weight: 400; }
 .users-actions { grid-column: 1 / -1; justify-content: flex-start; padding-top: 14px; border-top: 1px solid var(--admin-line, #e5edf2); }
 .users-action { min-height: 40px; }
 .users-action-delete { margin-left: auto; }
}
@media (max-width: 640px) {
 .users-list-heading { align-items: flex-start; flex-direction: column; gap: 6px; }
 .users-row { padding: 16px; gap: 16px 10px; }
 .users-account { gap: 9px; }
 .users-avatar { flex-basis: 32px; width: 32px; height: 32px; border-radius: 10px; font-size: 14px; }
 .users-name { font-size: 13px; }
 .users-email { font-size: 11px; }
 .users-role { padding: 4px 8px; font-size: 10px; }
 .users-action { min-height: 42px; padding: 0 10px; }
}

