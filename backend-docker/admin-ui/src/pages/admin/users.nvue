}
.user-form,
.record-form,
.record-detail {
	padding: 22px;
}
.form-item {
	margin-bottom: 20px;
}
.error-text {
	padding: 12px;
	margin-top: 16px;
	border-radius: 10px;
	background: #fff5f3;
}
.form-actions {
	margin-top: 24px;
}
.detail-item {
	display: flex;
	flex-direction: column;
	gap: 8px;
	margin-bottom: 18px;
	padding-bottom: 16px;
	border-bottom: 1px solid var(--admin-line, #e5edf2);
	overflow-wrap: anywhere;
}
.raw-payload {
	margin-top: 8px;
	padding: 16px;
	max-height: 300px;
	overflow: auto;
	border-radius: 12px;
	background: var(--admin-soft, #f5fafb);
	white-space: pre-wrap;
	overflow-wrap: anywhere;
}
@media (max-width: 1100px) {
	.user-header {
		flex-direction: column;
		gap: 14px;
	}
	.user-actions {
		justify-content: flex-start;
	}
}
@media (max-width: 640px) {
	.page-heading {
		margin-bottom: 18px;
	}
	.page-title {
		margin: 0;
		font-size: 26px;
	}
	.filter-panel {
		padding: 14px;
	}
	.top-bar {
		align-items: stretch;
	}
	.search-bar {
		flex-basis: 100%;
