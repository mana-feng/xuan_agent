	padding: 18px;
	margin-bottom: 24px;
	border: 1px solid var(--admin-line, #e5edf2);
	border-radius: 14px;
	background: var(--admin-soft, #f5fafb);
}
.top-bar,
.top-bar-buttons {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: flex-end;
	gap: 10px;
}
.search-bar {
	flex: 1;
	min-width: 220px;
}
.field-label {
	display: block;
	margin-bottom: 8px;
	color: var(--admin-body, #50677b);
	font-size: 12px;
	font-weight: 600;
}
.list-heading {
	display: flex;
	align-items: baseline;
	flex-wrap: wrap;
	gap: 12px;
	margin-bottom: 16px;
}
.list-title {
	color: var(--admin-ink, #20374a);
	font-size: 16px;
	font-weight: 600;
}
.list-caption {
	color: var(--admin-muted, #788c9d);
	font-size: 12px;
}
.responsive-list-container {
	display: flex;
	flex-direction: column;
	gap: 14px;
	margin-bottom: 20px !important;
}
.responsive-list-item {
	width: 100% !important;
	min-width: 0;
	box-sizing: border-box;
	padding: 20px !important;
	background: var(--admin-paper, #fff) !important;
	border: 1px solid var(--admin-line, #e5edf2);
	border-radius: 16px !important;
	box-shadow: 0 3px 12px rgba(36, 73, 94, 0.025) !important;
}
.user-header,
.record-header {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-start;
	gap: 20px;
}
.user-info,
.record-info {
	flex: 1;
	min-width: 0;
	overflow-wrap: anywhere;
}
.user-actions,
.record-actions {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	flex-wrap: wrap;
	gap: 8px;
}
.user-details,
.record-details {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 10px 24px;
	margin-top: 18px;
	padding-top: 16px;
	border-top: 1px solid var(--admin-line, #e5edf2);
	overflow-wrap: anywhere;
}
.user-details .mt-8,
.record-details .mt-8 {
	margin-top: 0 !important;
}
.user-details :deep(text),
.record-details :deep(text),
.record-info .mt-8 :deep(text) {
	color: var(--admin-body, #50677b) !important;
	font-size: 13px !important;
	line-height: 1.7 !important;
}
.user-info > :first-child :deep(text),
.record-info > :first-child :deep(text) {
	color: var(--admin-ink, #20374a) !important;
	font-size: 16px !important;
	line-height: 1.5 !important;
}
.admin-action-secondary {
	background: var(--admin-paper, #fff) !important;
	border: 1px solid var(--admin-line, #e5edf2) !important;
	box-shadow: none !important;
}
.admin-action-secondary :deep(.button) {
	background: var(--admin-paper, #fff) !important;
	border: 0 !important;
	box-shadow: none !important;
}
.admin-action-secondary :deep(.button text) {
	color: var(--admin-body, #50677b) !important;
}
.admin-action-danger {
	background: #fff5f3 !important;
	border: 1px solid #f5dcd6 !important;
	box-shadow: none !important;
}
.admin-action-danger :deep(.button) {
	background: #fff5f3 !important;
	border: 0 !important;
	box-shadow: none !important;
}
.admin-action-danger :deep(.button text) {
	color: #bd655a !important;
}
.empty-text {
	width: 100%;
	box-sizing: border-box;
	justify-content: center;
	padding: 64px 16px;
	border: 1px dashed var(--admin-line, #e5edf2);
	border-radius: 16px;
	background: var(--admin-soft, #f5fafb);
	text-align: center;
}
.empty-text :deep(text) {
	color: var(--admin-muted, #788c9d) !important;
	font-size: 14px !important;
	line-height: 1.8 !important;
}
.pagination {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
