<template>
	<tm-app>
		<view class="page-wrapper theme-page-bg admin-workbench admin-page-liuyao-records">
			<yx-nav-header></yx-nav-header>

			<view class="page-content theme-container" :style="pageContentStyle">
				<view class="page-heading">
					<text class="page-eyebrow">六爻档案</text>
					<h1 class="page-title">六爻记录</h1>
					<text class="page-description">查询六爻排盘资料，查看详情并维护记录。</text>
				</view>
				<view class="theme-card theme-card-glass">
					<!-- 顶部操作栏 -->
					<view class="filter-panel">
						<view class="top-bar">
							<view class="search-bar">
								<text class="field-label">姓名 / 邮箱 / 用户名</text>
								<yx-admin-input
:height="88"
									v-model="searchKeyword"
									placeholder="搜索姓名、邮箱或用户名"
									prefix="search"
									clearable
									@input="handleSearch"
								></yx-admin-input>
							</view>
							<view class="top-bar-buttons">
								<yx-teal-button
									class="admin-action-secondary"
									size="small"
									label="返回主页"
									icon="tmicon-md-home"
									@tap="goToHome"
									:margin="[0, 12, 0, 0]"
								></yx-teal-button>
								<yx-teal-button
									size="small"
									label="创建记录"
									@tap="handleCreateRecord"
									:margin="[0, 0, 0, 0]"
								></yx-teal-button>
							</view>
						</view>

						<!-- 记录列表 -->
					</view>
					<view class="list-heading">
						<text class="list-title">记录列表</text>
						<text class="list-caption">六爻资料 · 所属用户 · 起卦时间</text>
					</view>
					<view class="responsive-list-container" style="margin-bottom: 40rpx">
						<tm-sheet
							v-for="record in recordList"
							:key="record.id"
							:round="4"
							:shadow="2"
							:padding="[20, 20]"
							:margin="[0, 0, 0, 0]"
							class="responsive-list-item"
						>
							<view class="record-header">
								<view class="record-info">
									<tm-text :font-size="28" :bold="true" :label="record.name || '未命名排盘'"></tm-text>
									<tm-text
										class="mt-8"
										:font-size="22"
										color="#666"
										:label="'用户：' + (record.userUsername || record.userEmail)"
									></tm-text>
								</view>
								<view class="record-actions">
									<yx-teal-button
										size="mini"
										label="详情"
										:margin="[0, 10, 0, 0]"
										@tap="() => handleViewDetail(record.id)"
									></yx-teal-button>
									<yx-teal-button
										class="admin-action-secondary"
										size="mini"
										label="编辑"
										:margin="[0, 10, 0, 0]"
										@tap="() => handleEditRecord(record)"
									></yx-teal-button>
									<yx-teal-button
										class="admin-action-danger"
										size="mini"
										label="删除"
										@tap="() => handleDeleteRecord(record.id)"
									></yx-teal-button>
								</view>
							</view>

							<view class="record-details">
								<tm-text
									:font-size="22"
									color="#666"
									:label="'性别：' + (record.gender === '0' || record.gender === 0 ? '男' : record.gender === '1' || record.gender === 1 ? '女' : '未知')"
								></tm-text>
								<tm-text
									class="mt-8"
									:font-size="22"
									color="#666"
									:label="'出生时间：' + record.birthDatetime"
								></tm-text>
								<tm-text
									class="mt-8"
									:font-size="22"
									color="#666"
									:label="'历法：' + (record.calendarType === 'solar' ? '阳历' : '阴历')"
								></tm-text>
								<tm-text
									class="mt-8"
									:font-size="22"
									color="#666"
									:label="'创建时间：' + formatDate(record.createdAt)"
								></tm-text>
							</view>
						</tm-sheet>

						<tm-text
							v-if="recordList.length === 0 && !loading"
							class="empty-text"
							:font-size="24"
							color="#999"
							label="暂无六爻记录数据"
						></tm-text>
					</view>

					<!-- 分页 -->
					<view class="pagination" v-if="totalPages > 1">
						<yx-teal-button
							class="admin-action-secondary"
							size="small"
							:disabled="currentPage === 1"
							label="上一页"
							@tap="handlePrevPage"
						></yx-teal-button>
						<tm-text :margin="[0, 20]" :label="`${currentPage} / ${totalPages}`"></tm-text>
						<yx-teal-button
							class="admin-action-secondary"
							size="small"
							:disabled="currentPage === totalPages"
							label="下一页"
							@tap="handleNextPage"
						></yx-teal-button>
					</view>
				</view>
			</view>

			<!-- 创建/编辑记录弹窗 -->
			<yx-admin-dialog v-model:show="showRecordDialog" :title="editingRecord ? '编辑六爻记录' : '创建六爻记录'" eyebrow="排盘档案" description="请核对填写的信息后保存。" wide>
				<view class="record-form">
					<yx-admin-input
:height="88"
						v-model.number="recordForm.userId"
						label="用户ID"
						placeholder="请输入用户ID"
						type="number"
						:margin="[0, 0, 20, 0]"
						required
					></yx-admin-input>

					<yx-admin-input
:height="88"
						v-model="recordForm.name"
						label="姓名（可选）"
						placeholder="请输入姓名"
						:margin="[0, 0, 20, 0]"
					></yx-admin-input>

					<view class="form-item">
						<tm-text :font-size="24" :margin="[0, 0, 10, 0]" label="性别"></tm-text>
						<tm-radio-group class="admin-choice-group" v-model="recordForm.gender" model="button">
							<tm-radio class="admin-choice" :class="{ 'is-selected': String(recordForm.gender) === '0' }" label="男" value="0"></tm-radio>
							<tm-radio class="admin-choice" :class="{ 'is-selected': String(recordForm.gender) === '1' }" label="女" value="1"></tm-radio>
						</tm-radio-group>
					</view>

					<yx-admin-input
:height="88"
						v-model="recordForm.birthDatetime"
						label="起卦时间"
						placeholder="格式：YYYY-MM-DD HH:mm:ss"
						:margin="[0, 0, 20, 0]"
						required
					></yx-admin-input>

					<view class="form-item">
						<tm-text :font-size="24" :margin="[0, 0, 10, 0]" label="历法类型"></tm-text>
						<tm-radio-group class="admin-choice-group" v-model="recordForm.calendarType" model="button">
							<tm-radio class="admin-choice" :class="{ 'is-selected': String(recordForm.calendarType) === 'solar' }" label="阳历" value="solar"></tm-radio>
							<tm-radio class="admin-choice" :class="{ 'is-selected': String(recordForm.calendarType) === 'lunar' }" label="阴历" value="lunar"></tm-radio>
						</tm-radio-group>
					</view>

					<view v-if="recordFormError" class="error-text">
						<tm-text :label="recordFormError" color="#ff4d4f"></tm-text>
					</view>


				</view>

<template #footer>
<tm-button class="admin-control admin-secondary" block type="default" label="取消" @tap="handleCancelRecord" :margin="[20, 0, 0, 0]"></tm-button>
<tm-button
class="admin-control"
							block
							type="primary"
							:loading="recordFormLoading"
							:label="editingRecord ? '保存' : '创建'"
							@tap="handleSubmitRecord"
							:margin="[20, 0, 0, 0]"
						></tm-button>
</template>
</yx-admin-dialog>

			<!-- 记录详情弹窗 -->
			<yx-admin-dialog v-model:show="showDetailDialog" title="六爻记录详情" eyebrow="排盘档案" description="查看记录资料与原始排盘数据。" wide>
				<view class="record-detail" v-if="recordDetail">
					<view class="detail-item">
						<tm-text :font-size="24" color="#666" label="ID"></tm-text>
						<tm-text :label="recordDetail.id.toString()"></tm-text>
					</view>
					<view class="detail-item">
						<tm-text :font-size="24" color="#666" label="姓名"></tm-text>
						<tm-text :label="recordDetail.name || '未命名'"></tm-text>
					</view>
					<view class="detail-item">
						<tm-text :font-size="24" color="#666" label="性别"></tm-text>
						<tm-text
							:label="recordDetail.gender === '0' || recordDetail.gender === 0 ? '男' : recordDetail.gender === '1' || recordDetail.gender === 1 ? '女' : '未知'"
						></tm-text>
					</view>
					<view class="detail-item">
						<tm-text :font-size="24" color="#666" label="起卦时间"></tm-text>
						<tm-text :label="recordDetail.birthDatetime"></tm-text>
					</view>
					<view class="detail-item">
						<tm-text :font-size="24" color="#666" label="历法类型"></tm-text>
						<tm-text :label="recordDetail.calendarType === 'solar' ? '阳历' : '阴历'"></tm-text>
					</view>
					<view class="detail-item">
						<tm-text :font-size="24" color="#666" label="用户"></tm-text>
						<tm-text
							:label="(recordDetail.userUsername || recordDetail.userEmail) + ' (ID: ' + recordDetail.userId + ')'"
						></tm-text>
					</view>
					<view class="detail-item">
						<tm-text :font-size="24" color="#666" label="创建时间"></tm-text>
						<tm-text :label="formatDate(recordDetail.createdAt)"></tm-text>
					</view>
					<view class="detail-item" v-if="recordDetail.rawPayload">
						<tm-text :font-size="24" color="#666" label="原始数据"></tm-text>
						<view class="raw-payload">
							<tm-text :label="JSON.stringify(recordDetail.rawPayload, null, 2)" :font-size="20"></tm-text>
						</view>
					</view>
				</view>
			</yx-admin-dialog>
		</view>
	</tm-app>
</template>

<script setup lang="ts">
import { ref, onMounted, computed } from 'vue';
import { useUserStore } from '@/store/user';
import { 
	getLiuyaoRecordList, 
	deleteLiuyaoRecord, 
	createLiuyaoRecord, 
	updateLiuyaoRecord, 
	getLiuyaoRecordDetail, 
	type LiuyaoRecordInfo 
} from '@/services/api/liuyao';

const userStore = useUserStore();
const recordList = ref<LiuyaoRecordInfo[]>([]);
const searchKeyword = ref('');
const currentPage = ref(1);
const pageSize = ref(20);
const total = ref(0);
const totalPages = ref(0);
const loading = ref(false);

// navbar 高度（rpx），与 yx-nav-header 中的 navbarHeight 保持一致
const navbarHeight = 40;

// 计算页面内容的 padding-top，避免被 fixed 的 header 遮挡
const pageContentStyle = computed(() => {
	return {
		paddingTop: `${navbarHeight + 20}rpx` // navbar高度 + 原有padding
	};
});

// 记录表单相关
const showRecordDialog = ref(false);
const editingRecord = ref<LiuyaoRecordInfo | null>(null);
const recordForm = ref({
	userId: null as number | null,
	name: '',
	gender: '0',
	birthDatetime: '',
	calendarType: 'solar'
});
const recordFormError = ref('');
const recordFormLoading = ref(false);

// 记录详情相关
const showDetailDialog = ref(false);
const recordDetail = ref<any>(null);

onMounted(() => {
	if (!userStore.isAdmin) {
		uni.reLaunch({
			url: '/pages/auth/auth'
		});
		return;
	}
	
	loadRecords();
});

async function loadRecords() {
	loading.value = true;
	try {
		const res = await getLiuyaoRecordList({
			page: currentPage.value,
			pageSize: pageSize.value,
			search: searchKeyword.value || undefined
		});
		
		if (res.success && res.data) {
			recordList.value = res.data.list;
			total.value = res.data.total;
			totalPages.value = res.data.totalPages;
		}
	} catch (err) {
		console.error('加载记录列表失败:', err);
		uni.showToast({
			title: '加载失败',
			icon: 'none'
		});
	} finally {
		loading.value = false;
	}
}

function handleSearch() {
	currentPage.value = 1;
	loadRecords();
}

function handlePrevPage() {
	if (currentPage.value > 1) {
		currentPage.value--;
		loadRecords();
	}
}

function handleNextPage() {
	if (currentPage.value < totalPages.value) {
		currentPage.value++;
		loadRecords();
	}
}

async function handleDeleteRecord(recordId: number) {
	uni.showModal({
		title: '确认删除',
		content: '确定要删除这条六爻记录吗？此操作不可恢复。',
		success: async (res) => {
			if (res.confirm) {
				try {
					const result = await deleteLiuyaoRecord(recordId);
					if (result.success) {
						uni.showToast({
							title: '删除成功',
							icon: 'success'
						});
						loadRecords();
					} else {
						uni.showToast({
							title: result.error || '删除失败',
							icon: 'none'
						});
					}
				} catch (err: any) {
					uni.showToast({
						title: err.error || '删除失败',
						icon: 'none'
					});
				}
			}
		}
	});
}

function goToHome() {
	uni.reLaunch({
		url: '/pages/admin/dashboard'
	});
}

function formatDate(dateStr: string) {
	if (!dateStr) return '';
	const date = new Date(dateStr);
	return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

function handleCreateRecord() {
	editingRecord.value = null;
	recordForm.value = {
		userId: null,
		name: '',
		gender: '0',
		birthDatetime: '',
		calendarType: 'solar'
	};
	recordFormError.value = '';
	showRecordDialog.value = true;
}

function handleEditRecord(record: LiuyaoRecordInfo) {
	editingRecord.value = record;
	recordForm.value = {
		userId: record.userId,
		name: record.name || '',
		gender: record.gender || '0',
		birthDatetime: record.birthDatetime || '',
		calendarType: record.calendarType || 'solar'
	};
	recordFormError.value = '';
	showRecordDialog.value = true;
}

function handleCancelRecord() {
	showRecordDialog.value = false;
	editingRecord.value = null;
	recordFormError.value = '';
}

async function handleSubmitRecord() {
	recordFormError.value = '';
	
	if (!recordForm.value.userId) {
		recordFormError.value = '请输入用户ID';
		return;
	}
	
	if (!recordForm.value.birthDatetime) {
		recordFormError.value = '请输入起卦时间';
		return;
	}
	
	recordFormLoading.value = true;
	try {
		if (editingRecord.value) {
			// 编辑记录
			// 检查是否修改了会影响排盘计算的字段
			const birthDatetimeChanged = editingRecord.value.birthDatetime !== recordForm.value.birthDatetime;
			const genderChanged = editingRecord.value.gender !== recordForm.value.gender;
			const calendarTypeChanged = editingRecord.value.calendarType !== recordForm.value.calendarType;
			
			// 如果修改了关键字段，需要清除 rawPayload，让历史页面重新计算
			const shouldClearRawPayload = birthDatetimeChanged || genderChanged || calendarTypeChanged;
			
			const result = await updateLiuyaoRecord(editingRecord.value.id, {
				userId: recordForm.value.userId,
				name: recordForm.value.name || null,
				gender: recordForm.value.gender,
				birthDatetime: recordForm.value.birthDatetime,
				calendarType: recordForm.value.calendarType || null,
				// 如果关键字段被修改，清除 rawPayload
				rawPayload: shouldClearRawPayload ? null : undefined
			});
			if (result.success) {
				uni.showToast({
					title: '保存成功',
					icon: 'success'
				});
				showRecordDialog.value = false;
				loadRecords();
			} else {
				recordFormError.value = result.error || '保存失败';
			}
		} else {
			// 创建记录
			const result = await createLiuyaoRecord({
				userId: recordForm.value.userId,
				name: recordForm.value.name || undefined,
				gender: recordForm.value.gender,
				birthDatetime: recordForm.value.birthDatetime,
				calendarType: recordForm.value.calendarType
			});
			if (result.success) {
				uni.showToast({
					title: '创建成功',
					icon: 'success'
				});
				showRecordDialog.value = false;
				loadRecords();
			} else {
				recordFormError.value = result.error || '创建失败';
			}
		}
	} catch (err: any) {
		recordFormError.value = err.error || '操作失败';
	} finally {
		recordFormLoading.value = false;
	}
}

async function handleViewDetail(recordId: number) {
	try {
		const res = await getLiuyaoRecordDetail(recordId);
		if (res.success && res.data) {
			recordDetail.value = res.data;
			showDetailDialog.value = true;
		} else {
			uni.showToast({
				title: res.error || '加载失败',
				icon: 'none'
			});
		}
	} catch (err: any) {
		uni.showToast({
			title: err.error || '加载失败',
			icon: 'none'
		});
	}
}
</script>

<style scoped>
.page-heading {
	display: flex;
	flex-direction: column;
	gap: 8px;
	margin-bottom: 24px;
}
.page-eyebrow {
	color: var(--admin-accent, #169e9a);
	font-size: 11px;
	font-weight: 700;
	letter-spacing: 3px;
}
.page-title {
	margin: 0;
	color: var(--admin-ink, #20374a);
	font-family: 'Noto Serif SC', 'Songti SC', 'SimSun', serif;
	font-size: 30px;
	font-weight: 600;
	line-height: 1.4;
}
.page-description {
	color: var(--admin-muted, #788c9d);
	font-size: 13px;
	line-height: 1.8;
}
.filter-panel {
	padding: 18px;
	margin-bottom: 24px;
	border: 1px solid var(--admin-line, #e5edf2);
	border-radius: 14px;
	background: var(--admin-soft, #f5fafb);
}
.top-bar,
.top-bar-buttons {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: flex-end;
	gap: 10px;
}
.search-bar {
	flex: 1;
	min-width: 220px;
}
.field-label {
	display: block;
	margin-bottom: 8px;
	color: var(--admin-body, #50677b);
	font-size: 12px;
	font-weight: 600;
}
.list-heading {
	display: flex;
	align-items: baseline;
	flex-wrap: wrap;
	gap: 12px;
	margin-bottom: 16px;
}
.list-title {
	color: var(--admin-ink, #20374a);
	font-size: 16px;
	font-weight: 600;
}
.list-caption {
	color: var(--admin-muted, #788c9d);
	font-size: 12px;
}
.responsive-list-container {
	display: flex;
	flex-direction: column;
	gap: 14px;
	margin-bottom: 20px !important;
}
.responsive-list-item {
	width: 100% !important;
	min-width: 0;
	box-sizing: border-box;
	padding: 20px !important;
	background: var(--admin-paper, #fff) !important;
	border: 1px solid var(--admin-line, #e5edf2);
	border-radius: 16px !important;
	box-shadow: 0 3px 12px rgba(36, 73, 94, 0.025) !important;
}
.user-header,
.record-header {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-start;
	gap: 20px;
}
.user-info,
.record-info {
	flex: 1;
	min-width: 0;
	overflow-wrap: anywhere;
}
.user-actions,
.record-actions {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	flex-wrap: wrap;
	gap: 8px;
}
.user-details,
.record-details {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 10px 24px;
	margin-top: 18px;
	padding-top: 16px;
	border-top: 1px solid var(--admin-line, #e5edf2);
	overflow-wrap: anywhere;
}
.user-details .mt-8,
.record-details .mt-8 {
	margin-top: 0 !important;
}
.user-details :deep(text),
.record-details :deep(text),
.record-info .mt-8 :deep(text) {
	color: var(--admin-body, #50677b) !important;
	font-size: 13px !important;
	line-height: 1.7 !important;
}
.user-info > :first-child :deep(text),
.record-info > :first-child :deep(text) {
	color: var(--admin-ink, #20374a) !important;
	font-size: 16px !important;
	line-height: 1.5 !important;
}
.admin-action-secondary {
	background: var(--admin-paper, #fff) !important;
	border: 1px solid var(--admin-line, #e5edf2) !important;
	box-shadow: none !important;
}
.admin-action-secondary :deep(.button) {
	background: var(--admin-paper, #fff) !important;
	border: 0 !important;
	box-shadow: none !important;
}
.admin-action-secondary :deep(.button text) {
	color: var(--admin-body, #50677b) !important;
}
.admin-action-danger {
	background: #fff5f3 !important;
	border: 1px solid #f5dcd6 !important;
	box-shadow: none !important;
}
.admin-action-danger :deep(.button) {
	background: #fff5f3 !important;
	border: 0 !important;
	box-shadow: none !important;
}
.admin-action-danger :deep(.button text) {
	color: #bd655a !important;
}
.empty-text {
	width: 100%;
	box-sizing: border-box;
	justify-content: center;
	padding: 64px 16px;
	border: 1px dashed var(--admin-line, #e5edf2);
	border-radius: 16px;
	background: var(--admin-soft, #f5fafb);
	text-align: center;
}
.empty-text :deep(text) {
