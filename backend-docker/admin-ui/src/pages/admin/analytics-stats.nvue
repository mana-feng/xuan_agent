<template>
	<tm-app>
		<view class="page-wrapper theme-page-bg admin-workbench admin-page-analytics-stats">
			<yx-nav-header></yx-nav-header>

			<view class="page-content theme-container" :style="pageContentStyle">
				<!-- 页面标题 -->
				<view class="page-header">
					<view class="page-heading">
						<text class="page-eyebrow">行为洞察</text>
						<h1 class="page-title">访问统计</h1>
						<text class="page-description">累计指标与近 30 天趋势；日期按北京时间统计，页面显示时每 30 秒自动更新。</text>
					</view>

					<tm-button
						class="btn-gradient admin-action-secondary"
						size="small"
						color="teal"
						linear="right"
						:round="12"
						:padding="[20, 24]"
						label="返回后台"
						@tap="goBack"
					></tm-button>
				</view>

				<view class="analytics-feedback">
					<view class="analytics-refresh-row">
						<view class="page-btn analytics-refresh" aria-label="刷新访问统计" v-bind="h5Button(refreshStats)" @click="refreshStats">
							<text>手动刷新</text>
						</view>
						<text class="analytics-updated">{{ lastUpdated ? '最后更新：' + formatTime(lastUpdated) + '（北京时间）' : '尚未成功更新' }}</text>
					</view>
					<text v-if="loading" role="status" aria-live="polite">{{ lastUpdated ? '正在刷新统计…' : '正在加载统计…' }}</text>
					<text v-if="error" role="alert">{{ error }}</text>
				</view>

				<!-- 核心指标卡片 - 使用响应式 Grid 布局 -->
				<tm-sheet
					:round="16"
					:shadow="4"
					:padding="[28, 24]"
					class="stats-card responsive-padding-md"
					:follow-dark="true"
				>
					<view class="metrics-grid">
						<view class="metric-item">
							<tm-text :font-size="20" color="#718096" label="今日 PV"></tm-text>
							<tm-text :font-size="48" :bold="true" color="#599cde" :label="formatNum(stats.todayPageviews)"></tm-text>
							<tm-text
								:font-size="16"
								:color="stats.todayPageviews >= stats.yesterdayPageviews ? '#48bb78' : '#fc8181'"
								:label="diffLabel(stats.todayPageviews, stats.yesterdayPageviews)"
							></tm-text>
						</view>
						<view class="metric-divider"></view>
						<view class="metric-item">
							<tm-text :font-size="20" color="#718096" label="总浏览量"></tm-text>
							<tm-text :font-size="48" :bold="true" color="#2d3748" :label="formatNum(stats.totalPageviews)"></tm-text>
						</view>
						<view class="metric-divider"></view>
						<view class="metric-item">
							<tm-text :font-size="20" color="#718096" label="累计独立访客"></tm-text>
							<tm-text :font-size="48" :bold="true" color="#32b4a9" :label="formatNum(stats.uniqueVisitors)"></tm-text>
						</view>
						<view class="metric-divider"></view>
						<view class="metric-item">
							<tm-text :font-size="20" color="#718096" label="累计会话数"></tm-text>
							<tm-text :font-size="48" :bold="true" color="#ed8936" :label="formatNum(stats.totalSessions)"></tm-text>
						</view>
					</view>
				</tm-sheet>

				<!-- 次要指标 - 响应式布局 -->
				<tm-sheet
					:round="16"
					:shadow="4"
					:padding="[24, 20]"
					class="stats-card responsive-padding-md"
					:follow-dark="true"
				>
					<view class="sub-metrics">
						<view class="sub-metric">
							<tm-text :font-size="18" color="#718096" label="7 天"></tm-text>
							<tm-text :font-size="32" :bold="true" color="#599cde" :label="formatNum(stats.weeklyPageviews)"></tm-text>
						</view>
						<view class="sub-metric">
							<tm-text :font-size="18" color="#718096" label="30 天"></tm-text>
							<tm-text
								:font-size="32"
								:bold="true"
								color="#49b6be"
								:label="formatNum(stats.monthlyPageviews)"
							></tm-text>
						</view>
						<view class="sub-metric">
							<tm-text :font-size="18" color="#718096" label="跳出率"></tm-text>
							<tm-text
								:font-size="32"
								:bold="true"
								:color="stats.bounceRate > 60 ? '#fc8181' : stats.bounceRate > 40 ? '#ed8936' : '#48bb78'"
								:label="stats.bounceRate.toFixed(1) + '%'"
							></tm-text>
						</view>
						<view class="sub-metric">
							<tm-text :font-size="18" color="#718096" label="近 30 天新访客 / 回访客"></tm-text>
							<tm-text
								:font-size="26"
								:bold="true"
								color="#38b2ac"
								:label="formatNum(stats.newVisitorCount) + ' / ' + formatNum(stats.returningVisitorCount)"
							></tm-text>
						</view>
					</view>
				</tm-sheet>

				<text class="analytics-definition">{{ visitorDefinition }} 跳出率为近30天开启会话中的单页会话占比。</text>

				<!-- 每日趋势 -->
				<tm-sheet :round="16" :shadow="4" :padding="[24, 20]" class="stats-card" :follow-dark="true">
					<view class="card-header">
						<tm-icon name="tmicon-md-trending-up" :font-size="28" color="#599cde"></tm-icon>
						<tm-text :font-size="28" :bold="true" color="#2d3748" label="每日趋势 (近 30 天)"></tm-text>
					</view>
					<scroll-view scroll-x class="trend-scroll">
						<view class="trend-chart">
							<!-- Y 轴刻度 -->
							<view class="y-axis">
								<view v-for="(tick, idx) in yTicks" :key="idx" class="y-tick">
									<tm-text :font-size="14" color="#a0aec0" :label="tick + ''"></tm-text>
								</view>
							</view>
							<!-- 柱状图区域 -->
							<view class="trend-bars">
								<view v-for="(item, idx) in recentTrend" :key="idx" class="trend-bar-wrap">
									<view class="trend-bar-col">
										<view class="trend-bar pv-bar" :style="{ height: barHeight(item.pv, maxPv) }"></view>
										<view class="trend-bar uv-bar" :style="{ height: barHeight(item.uv, maxPv) }"></view>
									</view>
									<tm-text :font-size="22" color="#a0aec0" :label="formatDate(item.date)"></tm-text>
								</view>
							</view>
						</view>
					</scroll-view>
					<view class="legend-row">
						<view class="legend-item">
							<view class="dot pv-dot"></view>
							<tm-text :font-size="18" color="#718096" label="PV"></tm-text>
						</view>
						<view class="legend-item">
							<view class="dot uv-dot"></view>
							<tm-text :font-size="18" color="#718096" label="UV"></tm-text>
						</view>
					</view>
				</tm-sheet>

				<!-- 24 小时分布 - 优化布局和对齐 -->
				<tm-sheet
					:round="16"
					:shadow="4"
					:padding="[24, 20]"
					class="stats-card responsive-padding-md"
					:follow-dark="true"
				>
					<view class="card-header">
						<tm-icon name="tmicon-md-time" :font-size="28" color="#ed8936"></tm-icon>
						<tm-text :font-size="28" :bold="true" color="#2d3748" label="近 30 天各时段分布（北京时间）"></tm-text>
					</view>
					<scroll-view :scroll-x="true" class="hourly-scroll" :show-scrollbar="true">
						<view class="hourly-chart">
							<!-- Y 轴刻度 -->
							<view class="y-axis">
								<view v-for="(tick, idx) in hourYTicks" :key="idx" class="y-tick">
									<tm-text :font-size="16" color="#a0aec0" :label="tick + ''"></tm-text>
								</view>
							</view>
							<!-- 柱状图区域 -->
							<view class="hourly-bars">
								<view v-for="h in stats.hourlyData" :key="h.hour" class="hour-bar-wrap">
									<view class="hour-bar" :style="{ height: barHeight(h.count, maxHour) }">
										<!-- 悬停提示 -->
										<view class="hour-tooltip">
											<tm-text :font-size="14" color="#fff" :label="h.count + ''"></tm-text>
										</view>
									</view>
									<tm-text :font-size="18" color="#a0aec0" :label="h.hour + ''"></tm-text>
								</view>
							</view>
						</view>
					</scroll-view>
				</tm-sheet>

				<!-- 访问记录总览 -->
				<tm-sheet :round="16" :shadow="4" :padding="[28, 24]" class="stats-card records-card" :follow-dark="true">
					<view class="card-header records-header">
						<view class="records-title-wrap">
							<tm-icon name="tmicon-md-eye-outline" :font-size="28" color="#e53e3e"></tm-icon>
							<tm-text :font-size="42" :bold="true" color="#2d3748" label="访问记录总览"></tm-text>
							<tm-text
								:font-size="26"
								color="#718096"
								:label="recentRecordSummary"
							></tm-text>
						</view>
						<tm-text :font-size="24" color="#a0aec0" :label="'按访问时间倒序显示'"></tm-text>
					</view>
					<view class="rt-list">
						<view v-for="(item, index) in stats.recentVisitors" :key="index" class="rt-item">
							<view class="rt-left">
								<view class="rt-device-icon">
									<text v-if="item.deviceType && item.deviceType.toLowerCase() === 'mobile'" class="device-emoji">
										📱
									</text>
									<text v-else-if="item.deviceType && item.deviceType.toLowerCase() === 'tablet'" class="device-emoji">
										📟
									</text>
									<text v-else class="device-emoji">💻</text>
								</view>
								<view class="rt-dot" :style="{ background: rtDotColor(item.referrerType) }"></view>
								<view class="rt-detail">
									<view class="rt-title-row">
										<tm-text
											:font-size="34"
											:bold="true"
											color="#2d3748"
											:label="item.title || item.pathname"
											:lines="1"
										></tm-text>
										<tm-text :font-size="24" color="#94a3b8" :label="formatTime(item.time)"></tm-text>
									</view>
									<tm-text :font-size="24" color="#4a5568" :label="item.pathname"></tm-text>
									<view class="rt-device-details rt-device-details-inline">
										<view class="rt-device-info-row rt-device-info-chip">
											<tm-text :font-size="24" color="#94a3b8" :label="sourceTypeLabel(item.referrerType)"></tm-text>
										</view>
										<view class="rt-device-info-row rt-device-info-chip" v-if="item.isLoggedIn && item.username">
											<tm-text :font-size="24" color="#32b4a9" :label="'👤 ' + item.username"></tm-text>
										</view>
										<view class="rt-device-info-row rt-device-info-chip" v-else>
											<tm-text :font-size="24" color="#a0aec0" :label="'👤 游客'"></tm-text>
										</view>
										<view class="rt-device-info-row rt-device-info-chip">
											<tm-text
												:font-size="24"
												color="#94a3b8"
												:label="'📱 ' + (item.screenWidth || '?') + '×' + (item.screenHeight || '?') + (item.pixelRatio ? ' (' + item.pixelRatio + 'x)' : '')"
											></tm-text>
										</view>
										<view class="rt-device-info-row rt-device-info-chip">
											<tm-text
												:font-size="24"
												color="#94a3b8"
												:label="'🌐 ' + (item.browser || '未知') + (item.browserVersion ? ' ' + item.browserVersion : '')"
											></tm-text>
										</view>
										<view class="rt-device-info-row rt-device-info-chip">
											<tm-text
												:font-size="24"
												color="#94a3b8"
												:label="'💻 ' + (item.os || '未知') + (item.osVersion ? ' ' + item.osVersion : '')"
											></tm-text>
										</view>
										<view class="rt-device-info-row rt-device-info-chip">
											<tm-text :font-size="24" color="#94a3b8" :label="'📍 ' + (item.ip || '未知')"></tm-text>
										</view>
									</view>
								</view>
							</view>
						</view>
						<view v-if="lastUpdated && !loading && stats.recentVisitors.length === 0" class="empty-tip">
							<tm-text :font-size="30" color="#999" label="暂无访问记录"></tm-text>
						</view>
					</view>
					<!-- 分页控制 -->
					<view v-if="totalPages > 1" class="pagination">
						<view class="page-btn" aria-label="上一页访问记录" v-bind="h5Button(prevPage, loading || currentPage <= 1)" :class="{ 'page-btn-disabled': loading || currentPage <= 1 }" @click="prevPage">
							<tm-icon name="tmicon-angle-left" :font-size="32" color="#4a5568" :follow-theme="false"></tm-icon>
						</view>
						<tm-text :font-size="28" color="#4a5568" :label="currentPage + ' / ' + totalPages"></tm-text>
						<view class="page-btn" aria-label="下一页访问记录" v-bind="h5Button(nextPage, loading || currentPage >= totalPages)" :class="{ 'page-btn-disabled': loading || currentPage >= totalPages }" @click="nextPage">
							<tm-icon name="tmicon-angle-right" :font-size="32" color="#4a5568" :follow-theme="false"></tm-icon>
						</view>
					</view>
				</tm-sheet>
			</view>
		</view>
	</tm-app>
</template>

<script setup lang="ts">
import { computed, onMounted, onUnmounted, reactive, ref } from 'vue';
import { onShow, onHide } from '@dcloudio/uni-app';
import { h5Button } from '@/utils/keyboard';
import { getAdminAnalyticsStats, AnalyticsStats } from '@/services/api/admin';

const defaultStats: AnalyticsStats = {
	todayPageviews: 0,
	yesterdayPageviews: 0,
	totalPageviews: 0,
	uniqueVisitors: 0,
	totalSessions: 0,
	weeklyPageviews: 0,
	monthlyPageviews: 0,
	deviceStats: { mobile: 0, tablet: 0, desktop: 0 },
	topBrowsers: [],
	topOs: [],
	topPages: [],
	topReferrers: [],
	connectionStats: [],
	geoCountries: [],
	ispStats: [],
	referrerTypeStats: [],
	searchEngineStats: [],
	searchKeywords: [],
	screenResolutions: [],
	hourlyData: Array.from({ length: 24 }, (_, i) => ({ hour: i, count: 0 })),
	dailyTrend: [],
	dowData: [
		{ day: '周日', dayIndex: 0, count: 0 },
		{ day: '周一', dayIndex: 1, count: 0 },
		{ day: '周二', dayIndex: 2, count: 0 },
		{ day: '周三', dayIndex: 3, count: 0 },
		{ day: '周四', dayIndex: 4, count: 0 },
		{ day: '周五', dayIndex: 5, count: 0 },
		{ day: '周六', dayIndex: 6, count: 0 },
	],
	newVisitorCount: 0,
	returningVisitorCount: 0,
	bounceRate: 0,
	entryPages: [],
	exitPages: [],
	performanceStats: { avgLoadTime: 0, minLoadTime: 0, maxLoadTime: 0, avgFCP: 0, avgDCL: 0 },
	languageStats: [],
	timezoneStats: [],
	utmCampaigns: [],
	recentVisitors: [],
	recentTotal: undefined,
	recentPage: undefined,
	recentPageSize: undefined,
	recentPageCount: undefined,
	statisticsTimeZone: undefined,
	generatedAt: undefined,
	visitorPeriod: undefined,
	visitorDefinitions: undefined,
};

const stats = reactive<AnalyticsStats>({ ...defaultStats });
const loading = ref(false);
const error = ref('');
const lastUpdated = ref('');

const pageContentStyle = computed(() => {
	try {
		const systemInfo = uni.getSystemInfoSync();
		const statusBarHeight = systemInfo.statusBarHeight || 0;
		const headerHeight = 64;
		const padding = 24;
		return {
			paddingTop: `${statusBarHeight + headerHeight + padding}px`,
		};
	} catch (e) {
		return {
			paddingTop: '88px',
		};
	}
});

// 访问记录由服务端分页，页码只在请求成功后切换。
const ITEMS_PER_PAGE = 20;
const currentPage = ref(1);
const totalPages = computed(() => stats.recentPageCount ?? (stats.recentTotal !== undefined ? Math.max(1, Math.ceil(stats.recentTotal / (stats.recentPageSize || ITEMS_PER_PAGE))) : 1));
const recentRecordSummary = computed(() => stats.recentTotal !== undefined
	? '共 ' + stats.recentTotal + ' 条记录，每页 ' + (stats.recentPageSize || ITEMS_PER_PAGE) + ' 条'
	: '本次返回 ' + stats.recentVisitors.length + ' 条记录（总量暂不可用）');
const visitorDefinition = computed(() => stats.visitorDefinitions
	? stats.visitorDefinitions.new + '；' + stats.visitorDefinitions.returning
	: '近30天首次访问的去重访客 / 近30天再次开启会话的去重访客，两类可重叠。');
const prevPage = () => {
	if (!loading.value && currentPage.value > 1) void loadStats(currentPage.value - 1);
};
const nextPage = () => {
	if (!loading.value && currentPage.value < totalPages.value) void loadStats(currentPage.value + 1);
};

const maxPv = computed(() => {
	const recent30 = stats.dailyTrend.slice(-30);
	if (recent30.length === 0) return 100;
	return Math.max(...recent30.map((d) => Math.max(d.pv, d.uv)), 100);
});

const recentTrend = computed(() => stats.dailyTrend.slice(-30));

const yTicks = computed(() => {
	const max = maxPv.value;
	return [
		max,
		Math.round(max * 0.75),
		Math.round(max * 0.5),
		Math.round(max * 0.25),
		0,
	];
});

const hourYTicks = computed(() => {
	const max = maxHour.value;
	return [
		max,
		Math.round(max * 0.75),
		Math.round(max * 0.5),
		Math.round(max * 0.25),
		0,
	];
});

const maxHour = computed(() => {
	if (stats.hourlyData.length === 0) return 100;
	return Math.max(...stats.hourlyData.map((h) => h.count), 100);
});

const formatNum = (num: number) => {
	if (num >= 1000000) return (num / 1000000).toFixed(1) + 'M';
	if (num >= 10000) return (num / 10000).toFixed(1) + 'w';
	if (num >= 1000) return (num / 1000).toFixed(1) + 'k';
	return num.toString();
};

const diffLabel = (curr: number, prev: number) => {
	if (prev === 0) return curr === 0 ? '与昨日持平' : '较昨日新增 ' + formatNum(curr);
	const diff = curr - prev;
	const pct = Math.round((Math.abs(diff) / prev) * 100);
	return diff >= 0 ? `↑${pct}%` : `↓${pct}%`;
};

const CHART_HEIGHT = 200; // 柱状图可用高度（像素）- 与 Y 轴高度匹配

const barHeight = (val: number, max: number) => {
	if (val <= 0 || max <= 0) return '0px';
	const pct = val / max;
	// 预留底部 margin(8px) 和标签空间 (24px)
	const availableHeight = CHART_HEIGHT - 8 - 24;
	return Math.max(pct * availableHeight, 4) + 'px';
};

// YYYY-MM-DD 已是统计时区的自然日，不能再按浏览器时区解析。
const formatDate = (dateStr: string) => {
	const parts = /^(\d{4})-(\d{2})-(\d{2})$/.exec(dateStr);
	return parts ? `${Number(parts[2])}/${Number(parts[3])}` : '';
};

const sourceColor = (type: string) => {
	const map: Record<string, string> = {
		direct: '#667eea',
		search: '#48bb78',
		social: '#ed64a6',
		referral: '#ed8936',
		external: '#ed8936',
		internal: '#32b4a9',
		email: '#49b6be',
		unknown: '#cbd5e0',
	};
	return map[type] || '#cbd5e0';
};

const sourceTypeLabel = (type: string) => {
	const map: Record<string, string> = {
		direct: '直接访问',
		search: '搜索引擎',
		social: '社交媒体',
		referral: '外部链接',
		external: '外部链接',
		internal: '站内链接',
		email: '邮件链接',
		unknown: '未知来源',
	};
	return map[type] || type || '未知来源';
};

const rtDotColor = (type: string) => sourceColor(type);

const formatTime = (ts: string | number) => {
	const date = new Date(ts);
	if (!Number.isFinite(date.getTime())) return '时间未知';
	const parts = new Intl.DateTimeFormat('en-CA', {
		timeZone: stats.statisticsTimeZone || 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit',
		hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
	}).formatToParts(date);
	const part = (name: string) => parts.find(item => item.type === name)?.value || '';
	return `${part('year')}-${part('month')}-${part('day')} ${part('hour')}:${part('minute')}`;
};

const getConnLabel = (type: string) => {
	const map: Record<string, string> = {
		wifi: 'WiFi',
		cellular: '移动网络',
		ethernet: '有线网络',
		unknown: '未知',
	};
	return map[type] || type;
};

const formatReferrer = (ref: string) => {
	if (!ref || ref === 'direct') return '直接访问';
	try {
		const u = new URL(ref);
		return u.hostname.replace('www.', '');
	} catch {
		return ref;
	}
};

const goBack = () => {
	uni.navigateBack();
};

// 只有当前可见页面的最新请求可以更新数据或反馈。
let refreshTimer: ReturnType<typeof setInterval> | null = null;
let visible = false;
let disposed = false;
let requestVersion = 0;
const loadStats = async (page = currentPage.value, replace = false) => {
	if (!visible || disposed || (loading.value && !replace)) return;
	const version = ++requestVersion;
	loading.value = true;
	error.value = '';
	try {
		const res = await getAdminAnalyticsStats(page, ITEMS_PER_PAGE);
		if (version !== requestVersion || !visible || disposed) return;
		if (!res?.success || !res.data) throw new Error('统计响应不可用');
		Object.assign(stats, defaultStats, res.data);
		currentPage.value = res.data.recentPage ?? page;
		lastUpdated.value = res.data.generatedAt || new Date().toISOString();
	} catch {
		if (version !== requestVersion || !visible || disposed) return;
		error.value = lastUpdated.value ? '刷新失败，已保留上次成功的数据，请手动刷新重试。' : '统计加载失败，请手动刷新重试。';
	} finally {
		if (version === requestVersion && visible && !disposed) loading.value = false;
	}
};
const refreshStats = () => { void loadStats(currentPage.value, true); };
const startRefresh = () => {
	if (visible || disposed) return;
	visible = true;
	void loadStats();
	refreshTimer = setInterval(() => { void loadStats(); }, 30000);
};
const stopRefresh = () => {
	visible = false;
	requestVersion++;
	loading.value = false;
	if (refreshTimer !== null) clearInterval(refreshTimer);
	refreshTimer = null;
};
onMounted(startRefresh);
onShow(startRefresh);
onHide(stopRefresh);
onUnmounted(() => { disposed = true; stopRefresh(); });
</script>

