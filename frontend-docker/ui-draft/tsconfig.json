{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"lib": ["ES2020", "DOM"],
		"types": ["@dcloudio/types", "node"]
	},
	"include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
