<template>
	<tm-app>
		<PageScaffold
			class="page-bazi-detail"
			title="八字命盘"
			subtitle="从四柱结构出发，认识自己的节奏。"
			card-class="detail-card"
		>
			<template #header-extra>
				<view class="result-actions">
					<button v-bind="h5Button(editBazi)" class="result-button" @tap="editBazi">
						修改信息
					</button>
					<button v-bind="h5Button(exportToon)" class="result-button" @tap="exportToon">
						导出 TOON
					</button>
					<button
						v-bind="h5Button(saveToAccount, saving)"
						class="result-button primary"
						:disabled="saving"
						@tap="saveToAccount"
					>
						{{ saving ? '保存中…' : bazi_store.input.recordId ? '更新账号记录' : '保存到账号' }}
					</button>
				</view>
			</template>
			<view class="section info-summary">
				<header class="section__header">
					<tm-icon name="tmicon-md-person" :font-size="26" color="#1672b1"></tm-icon>
					<h2 class="section__title">基本信息</h2>
				</header>
				<view class="section__body info-grid">
					<view class="info-tile">
						<tm-text :font-size="24" color="#718096" label="姓名"></tm-text>
						<tm-text
							:font-size="30"
							:bold="true"
							color="#2d3748"
							:label="(bazi_store.input.realname || '').trim() || '佚名'"
						></tm-text>
					</view>
					<view class="info-tile">
						<tm-text :font-size="24" color="#718096" label="性别"></tm-text>
						<tm-text
							:font-size="30"
							:bold="true"
							color="#2d3748"
							:label="getGenderLabel()"
						></tm-text>
					</view>
					<view class="info-tile">
						<tm-text :font-size="24" color="#718096" label="生肖"></tm-text>
						<tm-text
							:font-size="30"
							:bold="true"
							color="#2d3748"
							:label="GetChineseZodiac(bazi_store.solar.year)"
						></tm-text>
					</view>
					<view class="info-tile">
						<tm-text :font-size="24" color="#718096" label="星座"></tm-text>
						<tm-text
							:font-size="30"
							:bold="true"
							color="#2d3748"
							:label="bazi_store.xinzuo + '座'"
						></tm-text>
					</view>
					<view class="info-tile full-width">
						<tm-text :font-size="24" color="#718096" label="阳历"></tm-text>
						<tm-text
							:font-size="30"
							:bold="true"
							color="#2d3748"
							:label="bazi_store.yangli || utils.HideSecond(bazi_store.input.timestamp)"
						></tm-text>
					</view>
					<view class="info-tile full-width">
						<tm-text :font-size="24" color="#718096" label="阴历"></tm-text>
						<tm-text
							:font-size="30"
							:bold="true"
							color="#2d3748"
							:label="bazi_store.yinli"
						></tm-text>
					</view>
				</view>

				<text v-if="bazi_store.input.calculation" class="calendar-rule-summary">{{ calendarRuleLabel(bazi_store.input.calculation) }}</text>
				<button v-if="bazi_store.legacyNeedsTimeZone" class="calendar-rule-summary" v-bind="h5Button(() => legacyDialogDismissed = false)" @tap="legacyDialogDismissed = false">旧缓存未记录时区，请先补充原排盘时区。</button>
				<view v-if="saveError" class="mt-12 error-message">
					<tm-text :label="saveError" color="#f56565" :font-size="24"></tm-text>
				</view>
				<view v-if="exportError" class="mt-12 error-message" role="alert">
					<tm-text :label="exportError" color="#f56565" :font-size="24"></tm-text>
				</view>
			</view>

			<view class="result-layout">
				<view class="section table-section">
					<header class="section__header">
						<tm-icon name="tmicon-md-grid" :font-size="26" color="#1672b1"></tm-icon>
						<h2 class="section__title">四柱总览</h2>
					</header>
					<view class="section__body">
						<view ref="tableWrapperRef" class="table-wrapper draggable-scroll">
							<yx-detail-table></yx-detail-table>
						</view>
						<view class="start-yun">
							<view class="info-item">
								<tm-text :font-size="24" color="#718096" label="起运"></tm-text>
								<tm-text
									:font-size="28"
									:bold="true"
									color="#2d3748"
									:label="GetStartYunLabel()"
								></tm-text>
							</view>
							<view class="info-item">
								<tm-text :font-size="24" color="#718096" label="起运公历"></tm-text>
								<tm-text
									:font-size="28"
									:bold="true"
									color="#2d3748"
									:label="bazi_store.start_yun.solar"
								></tm-text>
							</view>
						</view>
					</view>
				</view>

				<view class="result-reading">
					<text class="result-eyebrow">EXPLORE A LITTLE DEEPER</text>
					<h2>看见结构，再聊细节。</h2>
					<p>把盘面与自己的生活经验放在一起，从一个关心的问题开始。当前命盘会随对话一起带入。</p>
					<button v-bind="h5Button(goToChat)" class="result-button primary" @tap="goToChat">
						带着这张盘，问问 AI ↗
					</button>
					<text class="result-note">传统文化探索 · 供交流与参考</text>
				</view>
			</view>
			<view v-if="bazi_store.enhanced" class="section analysis-card">
				<header class="section__header">
					<tm-icon name="tmicon-md-stats" :font-size="26" color="#1672b1"></tm-icon>
					<h2 class="section__title">结构与关系</h2>
				</header>
				<view class="section__body">
					<view class="analysis-block" style="margin-bottom: 14px">
						<tm-text :font-size="24" color="#718096" label="干支关系图"></tm-text>
						<gan-zhi-relationship
							v-if="bazi_store.sizhu.year"
							:ganzhi-list="baziRelationData.list"
							:labels="baziRelationData.labels"
						/>
					</view>
					<view class="analysis-grid">
						<view class="analysis-block">
							<tm-text :font-size="24" color="#718096" label="格局"></tm-text>
							<tm-text
								:label="bazi_store.enhanced.geju.type"
								:font-size="28"
								color="#2d3748"
								:bold="true"
							></tm-text>
							<tm-text
								v-if="bazi_store.enhanced.geju.description"
								:label="bazi_store.enhanced.geju.description"
								:font-size="24"
								color="#718096"
								class="mt-4"
							></tm-text>
						</view>
						<view class="analysis-block">
							<tm-text :font-size="24" color="#718096" label="日主强弱"></tm-text>
							<tm-text
								:label="bazi_store.enhanced.rizhuQiangruo.level"
								:font-size="28"
								color="#2d3748"
								:bold="true"
							></tm-text>
							<tm-text
								v-if="bazi_store.enhanced.rizhuQiangruo.description"
								:label="bazi_store.enhanced.rizhuQiangruo.description"
								:font-size="24"
								color="#718096"
								class="mt-4"
							></tm-text>
						</view>
						<view class="analysis-block">
							<tm-text label="五行旺衰" :font-size="24" color="#718096"></tm-text>
							<view class="wuxing-tags">
								<view
									v-for="(value, key) in bazi_store.enhanced.wuxingWangshuai"
									:key="key"
									class="wuxing-tag"
								>
									<tm-text
										:label="key + '：' + value"
										:font-size="24"
										color="#2d3748"
										:bold="true"
									></tm-text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>

			<view class="section flow-section">
				<header class="section__header">
					<tm-icon name="tmicon-md-time" :font-size="26" color="#1672b1"></tm-icon>
					<h2 class="section__title">大运流年</h2>
				</header>
				<view ref="flowWrapperRef" class="section__body flow-section__body draggable-scroll">
					<yx-yun-scroll-list></yx-yun-scroll-list>
				</view>
			</view>
		</PageScaffold>
		<LegacyZoneDialog v-if="bazi_store.legacyNeedsTimeZone && !legacyDialogDismissed" @close="legacyDialogDismissed = true" @confirm="confirmLegacyBaziZone" />
	</tm-app>
</template>

<script lang="ts" setup>
import { h5Button } from '@/utils/keyboard';
import { calendarRuleLabel, legacyCalendar } from '@/utils/calendarContext';
import LegacyZoneDialog from '@/components/form/LegacyZoneDialog.vue';
import PageScaffold from '@/components/layout/PageScaffold.vue';
import { ref, computed, onMounted, onUnmounted, nextTick } from 'vue';
import { onShow } from '@dcloudio/uni-app';
import { useBaziStore } from '@/store/bazi';
import { useYunStore } from '@/store/yun';
import GanZhiRelationship from '@/components/ganzhi-relationship/ganzhi-relationship.vue';
import { useUserStore } from '@/store/user';
import { calculateGanZhiRelationsForList, buildGanZhiDiagram } from '@/libs/utils/bazi-enhanced';
import utils from '@/libs/utils/utils';
import { API_BASE_URL } from '@/config/config';
import { request } from '@/services/api/index';

const bazi_store = useBaziStore();
const yun_store = useYunStore();
const user_store = useUserStore();
const tableWrapperRef = ref<any>(null);
const flowWrapperRef = ref<any>(null);

const baziRelationData = computed(() => {
  const list = [
    bazi_store.sizhu.year,
    bazi_store.sizhu.month,
    bazi_store.sizhu.day,
    bazi_store.sizhu.time
  ];
  const labels = ['年柱', '月柱', '日柱', '时柱'];

  // Add Dayun
  if (yun_store.dayun_list && yun_store.dayun_list.length > yun_store.current_index && yun_store.dayun_list[yun_store.current_index]) {
    list.push(yun_store.dayun_list[yun_store.current_index].ganzhi);
    labels.push('大运');
  }

  // Add LiuNian
  if (yun_store.year_list && yun_store.year_list.length > yun_store.year_index && yun_store.year_list[yun_store.year_index]) {
    list.push(yun_store.year_list[yun_store.year_index].ganzhi);
    labels.push('流年');
  }

  // Add LiuYue
  if (yun_store.month_list && yun_store.month_list.length > yun_store.month_index && yun_store.month_list[yun_store.month_index]) {
    list.push(yun_store.month_list[yun_store.month_index].ganzhi);
    labels.push('流月');
  }

  return { list, labels };
});

function restoreBaziContext() {
	bazi_store.restoreInput();
}
const legacyDialogDismissed = ref(false);
function confirmLegacyBaziZone(zone: string) {
	const input = bazi_store.input;
	if (input.timestamp === null) return;
	const calculation = legacyCalendar(input.timestamp, 'bazi', {user:input}, zone);
	if (calculation) bazi_store.pull({...input, timestamp:input.timestamp, calculation});
}

function ensureBaziComputed() {
	bazi_store.ensureComputed();
}

function persistBaziContext() {
	bazi_store.persistInput();
}

restoreBaziContext();
ensureBaziComputed();
persistBaziContext();



const saving = ref(false);
const saveError = ref('');
const exportError = ref('');
const LOCAL_CACHE_KEY = 'local_saved_bazi';
const LOCAL_CACHE_TTL = 15 * 24 * 60 * 60 * 1000; // 15天
const LOCAL_BIRTH_KEY = 'local_birth_payload'; // 可选：缓存当前八字原始数据

import { getPersistentItem, setPersistentItem } from '@/utils/persistentStorage';
import { buildBaziExportPayload } from '@/utils/baziExport';
import { encodeTOON } from '@/utils/toon';

function readLocalCache(): Array<{ name: string; birthDatetime: number | null }> {
	try {
		const cache = getPersistentItem<Array<{ name: string; birthDatetime: number | null }>>(LOCAL_CACHE_KEY);
		if (cache && Array.isArray(cache)) return cache;
	} catch (e) {
		console.warn('读取本地缓存失败', e);
	}
	return [];
}

function writeLocalCache(entry: { name: string; birthDatetime: number | null }) {
	try {
		const cache = readLocalCache();
		cache.unshift(entry);
		// 限制长度，避免无限增长
		const limited = cache.slice(0, 200);
		setPersistentItem(LOCAL_CACHE_KEY, limited, LOCAL_CACHE_TTL);
	} catch (e) {
		console.warn('写入本地缓存失败', e);
	}
}

function isLocalDuplicate(entry: { name: string | null; birthDatetime: number | null }) {
	const cache = readLocalCache();
	const normalizedName = (entry.name || '').trim();
	return cache.some((item) => {
		const itemName = (item.name || '').trim();
		return item.birthDatetime === entry.birthDatetime && itemName === normalizedName;
	});
}

if (bazi_store.input.timestamp === null) {
	restoreBaziContext();
	if (!bazi_store.input.timestamp) {
		uni.redirectTo({
			url: '/pages/index/index'
		});
	}
}

onShow(() => {
	restoreBaziContext();
	ensureBaziComputed();
	persistBaziContext();
});

function getGenderLabel() {
	// 统一标准：0=男，1=女
	// 需要严格比较，因为可能是数字或字符串
	const gender = bazi_store.input.gender;
	if (gender === 0 || gender === '0') {
		return '男';
	} else if (gender === 1 || gender === '1') {
		return '女';
	} else {
		// 默认返回男
		console.warn('[WARN] 未知的 gender 值:', gender);
		return '男';
	}
}

function saveToAccount() {
	if (bazi_store.legacyNeedsTimeZone) { legacyDialogDismissed.value = false; return; }
	if (!user_store.isLoggedIn) {
		uni.showToast({
			title: '请先登录账号后再保存',
			icon: 'none',
			duration: 2000
		});
		return;
	}

	if (!bazi_store.input.timestamp) {
		uni.showToast({
			title: '缺少出生时间，无法保存',
			icon: 'none',
			duration: 2000
		});
		return;
	}

	saving.value = true;
	saveError.value = '';
	const savingInput = bazi_store.input;

	// 注意：排盘计算完全在前端完成，后端只存储必要数据
	// rawPayload 是可选的，主要用于前端恢复数据，不包含敏感信息
	let rawPayload = null;
	try {
		// Lite mode: 只保存用于重新计算的必要信息
		// 前端根据 timestamp 和 gender 即可完全恢复 bazi_store 的状态
		rawPayload = {
			lite: true,
			user: {
				...bazi_store.input,
				realname: bazi_store.input.realname,
				gender: bazi_store.input.gender,
				timestamp: bazi_store.input.timestamp
			}
		};
	} catch (e) {
		console.warn('构造精简数据失败，降级为完整数据', e);
		// 如果序列化失败，使用最小数据集
		rawPayload = {
			user: {
				...bazi_store.input,
				realname: bazi_store.input.realname,
				gender: bazi_store.input.gender,
				timestamp: bazi_store.input.timestamp
			},
			bazi: {
				solar: bazi_store.solar,
				lunar: bazi_store.lunar,
				sizhu: bazi_store.sizhu
			}
		};
	}

	const requestData = {
		name: (bazi_store.input.realname || '').trim() || '佚名',
		gender: bazi_store.input.gender !== undefined && bazi_store.input.gender !== null ? String(bazi_store.input.gender) : null,
		birthDatetime: bazi_store.input.timestamp !== undefined && bazi_store.input.timestamp !== null ? Number(bazi_store.input.timestamp) : null,
		calendarType: 'solar',
		rawPayload: rawPayload
	};

	// 验证数据格式
	try {
		JSON.stringify(requestData);
	} catch (e: any) {
			saveError.value = '数据格式错误，无法保存: ' + e.message;
		saving.value = false;
		return;
	}

	// 根据是否有 recordId 决定是更新还是新建
	const recordId = bazi_store.input.recordId;
	const isUpdate = !!recordId;
	const apiUrl = isUpdate ? `/api/bazi/${recordId}` : '/api/bazi';
	const method = isUpdate ? 'PUT' : 'POST';

	request(apiUrl, {
		method: method,
		needAuth: true,
		data: requestData,
	}).then((res: any) => {
		if (res?.success === false) {
			if (res.error === '登录已失效，请重新登录') {
				uni.showToast({
					title: '登录已失效，请重新登录',
					icon: 'none',
					duration: 2000,
				});
				saveError.value = '';
				return;
			}
			const errorMsg = res.error || '保存失败';
			saveError.value = errorMsg;
			uni.showToast({
				title: errorMsg,
				icon: 'none',
				duration: 2000,
			});
			return;
		}

		// 检查是否是更新操作
		// 后端返回格式：{success: true, data: {id, updated: true/false}}
		// 或者直接返回：{id, updated: true/false}
		const responseData = res?.data || res;
		const recordId = responseData?.id;
		const isUpdate = responseData?.updated === true || !!savingInput.recordId;
		
		// 保存记录ID到store
		if (recordId && bazi_store.input === savingInput) {
			bazi_store.input.recordId = recordId;
			persistBaziContext();
		}
		
		const successMsg = isUpdate ? '记录已更新' : '已保存到账号';
		
		uni.showToast({
			title: successMsg,
			icon: 'success',
			duration: 1500,
		});
		saveError.value = '';
		writeLocalCache({
			name: requestData.name,
			birthDatetime: requestData.birthDatetime,
		});
	}).catch((err: any) => {
		// 处理409错误（记录已存在，但后端可能未自动更新）
		if (err?.error?.includes('已存在') || err?.error?.includes('重复')) {
			// 如果后端返回了已存在记录的 ID，保存到 store
			if (err?.id && bazi_store.input === savingInput) {
				bazi_store.input.recordId = err.id;
				persistBaziContext();
			}
			uni.showToast({
				title: '记录已存在，已自动更新',
				icon: 'success',
				duration: 1500,
			});
			saveError.value = '';
			writeLocalCache({
				name: requestData.name,
				birthDatetime: requestData.birthDatetime,
			});
			return;
		}
		
		// Only a confirmed missing record permits creating a new one on retry.
		if (isUpdate && err?.code === 'NOT_FOUND' && bazi_store.input === savingInput) {
			bazi_store.input.recordId = null;
			persistBaziContext();
		}
		
		const msg = err?.error || err?.message || '网络错误，请检查后端是否已启动';
		saveError.value = msg;
		uni.showToast({
			title: msg,
			icon: 'none',
			duration: 2000,
		});
	}).finally(() => {
		saving.value = false;
	});
}

function buildExportPayload() {
	return buildBaziExportPayload(bazi_store.input, bazi_store, yun_store);
}

function exportToon() {
	exportError.value = '';
	const timestamp = bazi_store.input.timestamp;
	if (typeof timestamp !== 'number' || !Number.isFinite(timestamp) || !Number.isFinite(new Date(timestamp).getTime())) {
		exportError.value = '出生时间无效，请先确认出生时间';
		return;
	}

	let payload;
	try {
		payload = buildExportPayload();
	} catch (e: any) {
		exportError.value = '生成导出数据失败：' + (e?.message || e);
		return;
	}
	if (!payload) {
		exportError.value = bazi_store.legacyNeedsTimeZone ? '请先确认出生时区后再导出' : '导出数据为空，请先完成排盘';
		return;
	}

	let toonStr = '';
	try {
		toonStr = encodeTOON(payload);
	} catch (e: any) {
		exportError.value = 'TOON 序列化失败：' + (e?.message || e);
		return;
	}

	const date = new Date(timestamp), pad = (value: number) => String(value).padStart(2, '0');
	const filename = `bazi-${date.getFullYear()}${pad(date.getMonth() + 1)}${pad(date.getDate())}${pad(date.getHours())}${pad(date.getMinutes())}.toon`;

	// #ifdef H5
	let url: string | null = null;
	try {
		const blob = new Blob([toonStr], { type: 'text/plain;charset=utf-8' });
		url = URL.createObjectURL(blob);
		const link = document.createElement('a');
		link.href = url;
		link.download = filename;
		link.click();
		uni.showToast({
			title: '已请求浏览器下载 TOON 文件',
			icon: 'none',
			duration: 2000
		});
	} catch (error: any) {
		exportError.value = `导出失败：${error?.message || '浏览器下载不可用，请重试'}`;
	} finally {
		if (url) setTimeout(() => URL.revokeObjectURL(url!), 0);
	}
	return;
	// #endif
	// #ifndef H5
	exportError.value = '当前平台不支持下载 TOON 文件';
	// #endif
}

function goToChat() {
	uni.navigateTo({
		url: '/pages/chat/index?from=bazi'
	});
}

function goToHome() {
	uni.reLaunch({
		url: '/pages/agent/index'
	});
}

function editBazi() {
	// 将当前数据保存到缓存，供主页读取
	// 统一标准：0=男，1=女（数字）
	// bazi_store.input.gender 和表单 gender 都使用统一标准，无需转换
	const formGender = bazi_store.input.gender !== undefined && bazi_store.input.gender !== null
		? bazi_store.input.gender
		: 0;
	
	const editData = {
		...bazi_store.input,
		realname: bazi_store.input.realname || '',
		gender: formGender,
		timestamp: bazi_store.input.timestamp,
		recordId: bazi_store.input.recordId, // 传递记录ID
		// 标记为编辑模式
		isEdit: true
	};
	
	try {
		// 保存编辑数据到缓存
		uni.setStorageSync('edit_bazi_data', JSON.stringify(editData));
		
		// 验证保存是否成功
		const saved = uni.getStorageSync('edit_bazi_data');
		
		if (!saved) {
			throw new Error('数据保存失败');
		}
		
		// 显示提示
		uni.showToast({
			title: '正在加载数据...',
			icon: 'loading',
			duration: 1000
		});
		
		// 延迟跳转，确保数据保存完成
		setTimeout(() => {
			// 跳转到八字输入页，读取 edit_bazi_data 回填。
			uni.reLaunch({
				url: '/pages/index/index'
			});
		}, 500);
	} catch (err) {
		console.error('保存编辑数据失败:', err);
		uni.showToast({
			title: '加载数据失败，请重试',
			icon: 'none',
			duration: 2000
		});
	}
}

function GetStartYunLabel() {
	let str = '出生后';
	const { start_yun } = bazi_store;
	if (start_yun.year) str += start_yun.year + '年';
	if (start_yun.month) str += start_yun.month + '月';
	if (start_yun.day) str += start_yun.day + '日';
	if (start_yun.hour) str += start_yun.hour + '时';
	str += '后起运';
	return str;
}

const GetChineseZodiac = year => utils.GetChineseZodiac(year);
</script>

