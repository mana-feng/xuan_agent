	align-items: center;
	justify-content: center;
	width: 27px;
	height: 27px;
	border-radius: 8px;
	background: var(--x-tint, #e7f4fc);
	color: var(--x-accent, #1672b1);
	font-size: 15px;
}
.form-section-title {
	font-family: var(--x-serif, 'Noto Serif SC', 'Songti SC', SimSun, serif);
	font-size: 21px;
