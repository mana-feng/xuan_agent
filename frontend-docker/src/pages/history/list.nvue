<template>
	<tm-app>
		<PageScaffold
			class="page-history"
			title="每一次探索，都有迹可循"
			subtitle="回到曾经的问题，也许会有新的理解。查看并管理保存在账号中的命盘。"
			card-class="history-card"
		>
			<template #header-extra>
				<button
					v-bind="h5Button(fetchCharts, loading)"
					class="history-button"
					:disabled="loading"
					@tap="fetchCharts"
				>
					{{ loading ? '正在刷新…' : '刷新记录' }}
				</button>
			</template>
			<view v-if="!isLoggedIn" class="history-state">
				<text class="state-symbol">◷</text>
				<h2>把每次探索，留给未来的自己</h2>
				<p>登录后可查看和管理您保存的排盘记录。</p>
				<button v-bind="h5Button(goLogin)" class="history-button primary" @tap="goLogin">
					登录账号
				</button>
			</view>
			<template v-else>
				<view class="history-toolbar">
					<view class="search-box">
						<text class="search-symbol" aria-hidden="true">⌕</text>
						<input
							v-model="searchKeyword"
							class="history-search-field"
							aria-label="搜索姓名或主题"
							placeholder="搜索姓名或起卦主题"
							@input="onSearchInput"
						/>
						<button
							v-bind="
								h5Button(() => {
									searchKeyword = '';
									onSearchInput();
								})
							"
							v-if="searchKeyword"
							class="search-clear"
							aria-label="清除搜索"
							@tap="
								searchKeyword = '';
								onSearchInput();
							"
						>
							×
						</button>
					</view>
					<view class="sort-controls">
						<button
							v-bind="h5Button(() => (sortByIndex = sortByIndex === 0 ? 1 : 0))"
							class="history-button"
							@tap="sortByIndex = sortByIndex === 0 ? 1 : 0"
						>
							{{ sortByIndex === 0 ? '按保存时间' : '按姓名主题' }}
						</button>
						<button
							v-bind="h5Button(toggleSortOrder)"
							class="history-button"
							@tap="toggleSortOrder"
						>
							{{ sortOrder === 'DESC' ? '↓ 降序' : '↑ 升序' }}
						</button>
					</view>
				</view>
				<view class="filter-toolbar">
					<view class="history-filters" role="group" aria-label="排盘类型">
						<button
							v-bind="h5Button(() => selectType('all'))"
							class="filter"
							:class="{ active: typeFilter === 'all' }"
							:aria-pressed="typeFilter === 'all'"
							@tap="selectType('all')"
						>
							全部
						</button>
						<button
							v-bind="h5Button(() => selectType(type))"
							v-for="type in chartTypes"
							:key="type"
							class="filter"
							:class="{ active: typeFilter === type }"
							:aria-pressed="typeFilter === type"
							@tap="selectType(type)"
						>
							{{ chartTypeLabels[type] }}
						</button>
					</view>
					<view v-if="typeFilter !== 'qimen'" class="gender-filters" role="group" aria-label="性别筛选">
						<text class="gender-label">性别</text>
						<button
							v-bind="h5Button(() => (genderFilter = ''))"
							class="filter small"
							:class="{ active: genderFilter === '' }"
							:aria-pressed="genderFilter === ''"
							@tap="genderFilter = ''"
						>
							全部
						</button>
						<button
							v-bind="h5Button(() => (genderFilter = '0'))"
							class="filter small"
							:class="{ active: genderFilter === '0' }"
							:aria-pressed="genderFilter === '0'"
							@tap="genderFilter = '0'"
						>
							男
						</button>
						<button
							v-bind="h5Button(() => (genderFilter = '1'))"
							class="filter small"
							:class="{ active: genderFilter === '1' }"
							:aria-pressed="genderFilter === '1'"
							@tap="genderFilter = '1'"
						>
							女
						</button>
					</view>
				</view>
				<view class="history-panel" :aria-busy="loading">
					<view v-if="loading" class="history-state compact" role="status">
						<text class="state-symbol">◌</text>
						<p>正在读取保存记录…</p>
					</view>
					<view v-else-if="error && !charts.length" class="history-state compact" role="alert">
						<h2>暂时无法读取记录</h2>
						<p>{{ error }}</p>
						<button v-bind="h5Button(fetchCharts)" class="history-button" @tap="fetchCharts">
							重新加载
						</button>
					</view>
					<view v-else-if="!charts.length" class="history-state compact">
						<text class="state-symbol">◇</text>
						<h2>
							{{
								searchKeyword || genderFilter || typeFilter !== 'all'
									? '没有找到相关记录'
									: '你的探索，从这里开始'
							}}
						</h2>
						<p>
							{{
								searchKeyword || genderFilter || typeFilter !== 'all'
									? '试试其他关键词、性别或排盘类型。'
									: '完成排盘后，点击「保存到账号」，就能在这里再次打开。'
							}}
						</p>
						<button
							v-bind="h5Button(clearFilters)"
							v-if="searchKeyword || genderFilter || typeFilter !== 'all'"
							class="history-button"
							@tap="clearFilters"
						>
							清除筛选
						</button>
						<button
							v-bind="h5Button(goToHome)"
							v-else
							class="history-button primary"
							@tap="goToHome"
						>
							开始探索
						</button>
					</view>
					<view v-else class="records-list">
						<view v-for="item in visibleCharts" :key="item.type + ':' + item.id" class="record-row">
							<button
								v-bind="h5Button(() => openChart(item))"
								class="record-open"
								:aria-label="'查看' + (item.title || '未命名命盘')"
								@tap="openChart(item)"
							>
								<text class="record-symbol" aria-hidden="true">
									{{ item.type === 'qimen' ? '▦' : item.type === 'liuyao' ? '☷' : item.type === 'ziwei' ? '✦' : '八' }}
								</text>
								<view class="record-main">
									<text class="record-name">{{ item.title || '未命名命盘' }}</text>
									<text class="record-subtitle">
										{{ formatBirth(item)
										}}{{ item.gender != null ? ' · ' + getGenderDisplayLabel(item.gender) : '' }}
									</text>
								</view>
								<text class="record-type">{{ chartTypeLabels[item.type || 'bazi'] }}</text>
								<text class="record-date">
									{{ item.createdAtLabel || formatDateTime(item.createdAt) }}
								</text>
								<text class="record-arrow" aria-hidden="true">›</text>
							</button>
							<button
								v-bind="h5Button(() => removeChart(item))"
								class="record-delete"
								:aria-label="'删除' + (item.title || '未命名命盘')"
								@tap="removeChart(item)"
							>
								删除
							</button>
						</view>
					</view>
				</view>
				<view v-if="error && charts.length" class="history-error" role="alert">{{ error }}</view>
				<view v-if="!loading && charts.length" class="history-bottom">
					<text class="history-count" aria-live="polite">
						共 {{ totalCount }} 条记录 · 第 {{ currentPage }} / {{ totalPages }} 页
					</text>
					<view class="pagination">
						<button
							v-bind="h5Button(() => changePage(currentPage - 1), currentPage <= 1)"
							class="history-button"
							:disabled="currentPage <= 1"
							@tap="changePage(currentPage - 1)"
						>
							上一页
						</button>
						<button
							v-bind="h5Button(() => changePage(currentPage + 1), currentPage >= totalPages)"
							class="history-button"
							:disabled="currentPage >= totalPages"
							@tap="changePage(currentPage + 1)"
						>
							下一页
						</button>
					</view>
				</view>
				<button
					v-bind="h5Button(clearFilters)"
					v-if="charts.length && (searchKeyword || genderFilter || typeFilter !== 'all')"
					class="clear-filters"
					@tap="clearFilters"
				>
					清除筛选
				</button>
			</template>
		</PageScaffold>
		<LegacyZoneDialog v-if="pendingLegacyChart" @close="pendingLegacyChart = null" @confirm="confirmLegacyZone" />
	</tm-app>
</template>

<script lang="ts" setup>
import { h5Button } from '@/utils/keyboard';
import { ref, computed, onMounted, watch } from 'vue';
import { onLoad } from '@dcloudio/uni-app';
import PageScaffold from '@/components/layout/PageScaffold.vue';
import { openSavedChart, chartTypes, chartTypeLabels, type ChartType, type ChartItem } from '@/features/history/savedCharts';
import LegacyZoneDialog from '@/components/form/LegacyZoneDialog.vue';
import { formatCalendarHistoryTime } from '@/features/history/formatCalendarHistoryTime';
const pendingLegacyChart = ref<ChartItem | null>(null);
function confirmLegacyZone(zone: string) {
	const item = pendingLegacyChart.value;
	if (!item) return;
	const result = openSavedChart(item, zone);
	if (!result?.needsTimeZone) pendingLegacyChart.value = null;
}
import { formatQimenHistoryTime } from '@/features/history/formatQimenHistoryTime';
import { useUserStore } from '@/store/user';
import { request } from '@/services/api/index';
import { getAccessToken } from '@/utils/tokenStore';
import utils from '@/libs/utils/utils';

const user_store = useUserStore();

const charts = ref<ChartItem[]>([]);
const loading = ref(false);
const error = ref('');
const totalCount = ref(0);
const typeFilter = ref<ChartType | 'all'>('all');
const currentPage = ref(1);
const pageSize = 12;
const totalPages = computed(() => Math.max(1, Math.ceil(charts.value.length / pageSize)));
const visibleCharts = computed(() => charts.value.slice((currentPage.value - 1) * pageSize, currentPage.value * pageSize));
let latestRequest = 0;

const searchKeyword = ref('');
const genderFilter = ref('');
const sortByIndex = ref(0); // 0: 时间, 1: 姓名
const sortBy = computed(() => (sortByIndex.value === 0 ? 'created_at' : 'name'));
const sortOrder = ref<'ASC' | 'DESC'>('DESC');

let searchTimer: any = null;

const isLoggedIn = computed(() => user_store.isLoggedIn);

function getGenderDisplayLabel(gender: any): string {
	// 数据库存储：'0'=男，'1'=女
	// 前端显示：0=男，1=女
	if (gender === '0' || gender === 0) {
		return '男';
	} else if (gender === '1' || gender === 1) {
		return '女';
	} else {
		console.warn('[WARN] 未知的 gender 值:', gender);
		return '未知';
	}
}

watch([genderFilter, sortByIndex, sortOrder], () => {
	if (user_store.isLoggedIn) {
		// 延迟一下，确保 token 已刷新
		setTimeout(() => {
			fetchCharts();
		}, 100);
	}
});

onMounted(() => {
	user_store.restoreAuth();
	// 延迟一下，确保 token 已恢复
	setTimeout(() => {
		if (user_store.isLoggedIn) {
			fetchCharts();
		}
	}, 100);
});

onLoad((options: any) => {
});

function onSearchInput() {
	if (searchTimer) {
		clearTimeout(searchTimer);
	}
	searchTimer = setTimeout(() => {
		fetchCharts();
	}, 500);
}

function toggleSortOrder() {
	sortOrder.value = sortOrder.value === 'DESC' ? 'ASC' : 'DESC';
}

function selectType(type: ChartType | 'all') {
	typeFilter.value = type;
	if (type === 'qimen') genderFilter.value = '';
	return fetchCharts();
}

function changePage(page: number) {
	currentPage.value = Math.max(1, Math.min(totalPages.value, page));
}

function clearFilters() {
	searchKeyword.value = '';
	genderFilter.value = '';
	typeFilter.value = 'all';
	sortByIndex.value = 0;
	sortOrder.value = 'DESC';
	fetchCharts();
}

async function fetchCharts() {
	if (!user_store.isLoggedIn) {
		return;
	}
	
	// 确保有有效的 token
	const token = getAccessToken();
	if (!token) {
		return;
	}
	
	loading.value = true;
	error.value = '';
	currentPage.value = 1;
	const requestId = ++latestRequest;

	try {
		const params: Record<string, string> = {};
		if (searchKeyword.value) {
			params.keyword = searchKeyword.value;
		}
		if (genderFilter.value) {
			params.gender = genderFilter.value;
		}
		if (sortBy.value) {
			params.sortBy = sortBy.value as string;
		}
		if (sortOrder.value) {
			params.sortOrder = sortOrder.value;
		}

		const queryString = Object.keys(params)
			.map(key => `${encodeURIComponent(key)}=${encodeURIComponent(params[key])}`)
			.join('&');

		const requestedTypes = typeFilter.value === 'all' ? chartTypes : [typeFilter.value];
		const results = await Promise.all(requestedTypes.map(async type => {
			const res = await request(`/api/charts?type=${type}` + (queryString ? '&' + queryString : ''), {
				method: 'GET',
				needAuth: true
			});
			if (res.success === false) throw new Error(res.error || '获取失败，请稍后重试');
			const data = res.data || res;
			const list = Array.isArray(data) ? data : data.list || [];
			return list.map((item: ChartItem) => ({
				...item,
				type,
				createdAtLabel: formatDateTime(item.createdAt || '')
			}));
		}));
		if (requestId !== latestRequest) return;
		const direction = sortOrder.value === 'ASC' ? 1 : -1;
		charts.value = results.flat().sort((a: ChartItem, b: ChartItem) => {
			const comparison = sortBy.value === 'name'
				? (a.title || '').localeCompare(b.title || '', 'zh-CN')
				: (new Date(a.createdAt).getTime() || 0) - (new Date(b.createdAt).getTime() || 0);
			return comparison * direction;
		});
		totalCount.value = charts.value.length;
	} catch (e: any) {
		if (requestId !== latestRequest) return;
		console.error('获取历史记录失败:', e);
		error.value = e?.error || e?.message || '网络错误，请检查后端是否已启动';
		charts.value = [];
		totalCount.value = 0;
	} finally {
		if (requestId === latestRequest) loading.value = false;
	}
}

/**
 * 公告缓存与拉取
 */
function formatDateTime(iso: string) {
	if (!iso) return '';
	try {
		const d = new Date(iso);
		if (isNaN(d.getTime())) {
			return '';
		}
		return utils.HideSecond(d.getTime()) || '';
	} catch (e) {
		return '';
	}
}

function formatBirth(item: ChartItem) {
	if (!item || !item.birthDatetime) return '';
	if (item.type === 'qimen') return formatQimenHistoryTime(item.birthDatetime);
	try {
		const d = new Date(item.birthDatetime);
		if (isNaN(d.getTime())) {
			return '';
		}
		const savedTime = formatCalendarHistoryTime(item);
		if (savedTime !== null) return (item.type === 'liuyao' ? '起卦：' : '出生：') + savedTime;
		const result = utils.HideSecond(d.getTime());
		return result ? (item.type === 'liuyao' ? '起卦：' : '出生：') + result : '';
	} catch (e) {
		return '';
	}
}

function openChart(item: ChartItem) {
	if (openSavedChart(item)?.needsTimeZone) pendingLegacyChart.value = item;
}

function removeChart(item: ChartItem) {
	uni.showModal({
		title: '删除确认',
		content: '确定要删除这条排盘记录吗？',
		success(res) {
			if (res.confirm) {
				doRemove(item);
			}
		}
	});
}

async function doRemove(item: ChartItem) {
	if (!user_store.isLoggedIn) return;

	try {
		const res = await request(`/api/charts/${item.id}?type=${item.type || 'bazi'}`, {
			method: 'DELETE',
			needAuth: true
		});

		if (res.success !== false) {
			charts.value = charts.value.filter(c => c.id !== item.id || (c.type || 'bazi') !== (item.type || 'bazi'));
			totalCount.value = charts.value.length;
			changePage(currentPage.value);
			uni.showToast({
				title: '已删除',
				icon: 'none',
				duration: 1500
			});
		} else {
			error.value = res.error || '删除失败，请稍后重试';
		}
	} catch (e: any) {
		console.error('删除失败:', e);
		error.value = e?.error || '网络错误，请检查后端是否已启动';
	}
}

function goToHome() {
	uni.reLaunch({
		url: '/pages/agent/index'
	});
}

function goLogin() {
	uni.navigateTo({
		url: '/pages/auth/auth?mode=login'
	});
}
</script>

<style scoped>
.page-history {
	color: var(--x-body);
	font-family: var(--x-sans);
}
.history-button,
.filter,
.record-open,
.record-delete,
.search-clear,
.clear-filters {
	margin: 0;
	padding: 0;
	font: inherit;
	line-height: 1.5;
	border: 0;
	border-radius: 0;
	background: transparent;
	color: inherit;
	cursor: pointer;
}
button::after {
	border: 0;
}
button:focus-visible {
	outline: 2px solid var(--x-accent);
	outline-offset: 3px;
}
.history-button {
	display: inline-flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	min-height: 40px;
	padding: 9px 17px;
	border: 1px solid var(--x-line);
	border-radius: 8px;
	background: var(--x-paper);
	color: var(--x-body);
	font-size: 12px;
	white-space: nowrap;
}
.history-button.primary {
	color: white;
	border-color: transparent;
	background: var(--x-gradient);
}
.history-button:disabled {
	opacity: 0.45;
	cursor: default;
}
.history-toolbar,
.filter-toolbar,
.history-bottom {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	gap: 16px;
}
.search-box {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 10px;
	max-width: 580px;
	flex: 1;
	padding: 0 16px;
	min-height: 46px;
	border: 1px solid var(--x-line);
	border-radius: 9px;
	background: var(--x-paper);
}
.search-box:focus-within {
	border-color: var(--x-accent);
}
.search-symbol {
	color: var(--x-muted);
	font-size: 24px;
}
.history-search-field {
	flex: 1;
	min-width: 0;
	font-size: 13px;
	color: var(--x-ink);
}
.search-clear {
	padding: 8px 4px;
	font-size: 20px;
	color: var(--x-muted);
}
.sort-controls,
.pagination {
	display: flex;
	flex-direction: row;
	gap: 8px;
}
.filter-toolbar {
	flex-wrap: wrap;
	margin: 3px 0 8px;
}
.history-filters,
.gender-filters {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 4px;
}
.gender-label {
	margin-right: 5px;
	color: var(--x-muted);
	font-size: 11px;
}
.filter {
	padding: 8px 17px;
	border-radius: 7px;
	color: var(--x-muted);
	font-size: 12px;
}
.filter.active {
	color: var(--x-accent);
	background: var(--x-tint);
	font-weight: 600;
}
.filter.small {
	padding: 6px 10px;
	font-size: 11px;
}
.history-panel {
	display: block;
	padding: 0 24px;
	background: var(--x-paper);
	border: 1px solid var(--x-line);
	border-radius: 14px;
	min-width: 0;
}
.record-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 18px;
	border-bottom: 1px solid var(--x-line);
}
.records-list {
	display: block;
}
.record-row:last-child {
	border-bottom: 0;
}
.record-open {
	display: grid;
	grid-template-columns: 42px minmax(0, 1fr) 64px 120px 12px;
	align-items: center;
	flex: 1;
	min-width: 0;
	gap: 16px;
	text-align: left;
	padding: 22px 0;
}
.record-open:hover .record-name {
	color: var(--x-accent);
}
.record-symbol {
	display: grid;
	place-items: center;
	width: 38px;
	height: 38px;
	border: 1px solid var(--x-line);
	border-radius: 10px;
	color: var(--x-accent);
	background: var(--x-gradient-soft);
	font-size: 19px;
}
.record-main {
	display: flex;
	flex-direction: column;
	gap: 5px;
	min-width: 0;
}
.record-name {
	color: var(--x-ink);
	font-size: 14px;
	font-weight: 600;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.record-subtitle,
.record-type,
.record-date {
	font-size: 11px;
	color: var(--x-muted);
}
.record-subtitle {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.record-date {
	text-align: right;
	font-variant-numeric: tabular-nums;
}
.record-arrow {
	color: var(--x-muted);
	font-size: 20px;
}
.record-delete {
	font-size: 11px;
	color: var(--x-muted);
	padding: 10px 2px;
}
.record-delete:hover {
	color: #b54831;
}
.history-bottom {
	padding: 4px 2px;
}
.history-count {
	font-size: 11px;
	color: var(--x-muted);
}
.clear-filters {
	align-self: flex-start;
	font-size: 12px;
	color: var(--x-accent);
}
.history-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 16px;
	min-height: 360px;
	text-align: center;
	padding: 32px 18px;
	background: var(--x-gradient-soft);
	border-radius: 14px;
}
.history-state.compact {
	min-height: 260px;
	background: transparent;
}
.state-symbol {
	color: var(--x-accent);
