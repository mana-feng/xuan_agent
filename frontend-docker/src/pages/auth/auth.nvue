<template>
	<tm-app>
		<view class="page-wrapper x-workbench" :data-palette="palette">
			<view class="top-status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
			<view class="top-nav-bar">
				<button class="nav-back-btn" v-bind="h5Button(goHome)" @tap="goHome">
					<text aria-hidden="true">←</text>
					<text>{{ activeProtocol ? '返回注册' : '返回工作台' }}</text>
				</button>
			</view>

			<ProtocolReader v-if="activeProtocol" :type="activeProtocol" :height="protocolHeight" @close="activeProtocol = null" />
			<view v-else class="page-content-scale">
				<view class="login-container">
					<view class="header-section">
						<text class="logo-wrapper" aria-hidden="true">☯</text>
						<h1 class="auth-brand">玄学 · AI</h1>
						<text class="auth-intro">让每一次探索，更了解自己</text>
					</view>

					<view v-if="isLoggedIn" class="user-info-card">
						<view class="user-header">
							<text class="auth-heading">你好，{{ user_store.username || user_store.email || '已登录用户' }}</text>
							<text class="auth-description">探索记录已与账号关联，可在不同设备继续查看。</text>
						</view>
						<view class="user-actions">
							<button class="auth-button auth-submit" v-bind="h5Button(goBack)" @tap="goBack">返回上一页</button>
							<button class="auth-button auth-secondary" v-bind="h5Button(logout)" @tap="logout">退出登录</button>
						</view>
					</view>

					<view v-else class="login-card">
						<view class="tab-switcher" role="group" aria-label="账号操作">
							<button class="tab-item" :class="{ active: currentTab === 'login' }" :aria-pressed="currentTab === 'login'" v-bind="h5Button(() => currentTab = 'login')" @tap="currentTab = 'login'">登录</button>
							<button class="tab-item" :class="{ active: currentTab === 'register' }" :aria-pressed="currentTab === 'register'" v-bind="h5Button(() => currentTab = 'register')" @tap="currentTab = 'register'">注册</button>
						</view>

						<view v-if="currentTab === 'login'" class="form-content" role="form" aria-label="登录账号" @keyup.enter.stop.prevent="submitLogin">
							<text class="auth-heading">欢迎回来</text>
							<text class="auth-description">登录后同步查看你的命盘与探索历史。</text>
							<view class="input-wrapper">
								<text id="login-identifier-label" class="field-label">邮箱或用户名</text>
								<input v-model="loginIdentifier" v-auth-input="{ labelledBy: 'login-identifier-label', autocomplete: 'username', describedBy: loginError ? 'login-error' : '' }" class="auth-input" placeholder="输入邮箱或用户名" :maxlength="255" confirm-type="go" @confirm="loginIdentifier = $event.detail.value; submitLogin()" @input="loginError = ''" />
							</view>
							<view class="input-wrapper">
								<text id="login-password-label" class="field-label">密码</text>
								<input v-model="loginPassword" v-auth-input="{ labelledBy: 'login-password-label', autocomplete: 'current-password', describedBy: loginError ? 'login-error' : '' }" class="auth-input" type="password" :password="true" placeholder="输入密码" :maxlength="128" confirm-type="go" @confirm="loginPassword = $event.detail.value; submitLogin()" @input="loginError = ''" />
							</view>
							<view v-if="loginError" id="login-error" class="error-message" role="alert">
								<text>{{ loginError }}</text>
								<button v-if="loginCanRetry" class="inline-retry" v-bind="h5Button(submitLogin, loginLoading)" @tap="submitLogin">重试登录</button>
							</view>
							<button class="auth-button auth-submit" :disabled="loginLoading" :aria-busy="loginLoading" v-bind="h5Button(submitLogin, loginLoading)" @tap="submitLogin">{{ loginLoading ? '正在登录…' : '登录并继续探索' }}</button>
						</view>

						<view v-else class="form-content" role="form" aria-label="注册账号" @keyup.enter.stop.prevent="submitRegister">
							<text class="auth-heading">开始你的探索</text>
							<text class="auth-description">使用邮箱注册，保存每一次探索的收获。</text>
							<view class="input-wrapper">
								<text id="register-username-label" class="field-label">用户名</text>
								<input v-model="registerUsername" v-auth-input="{ labelledBy: 'register-username-label', autocomplete: 'username', describedBy: registerError ? 'register-error' : '' }" class="auth-input" placeholder="2–20 个字符" :maxlength="20" confirm-type="go" @confirm="registerUsername = $event.detail.value; submitRegister()" @input="registerError = ''" />
							</view>
							<view class="input-wrapper">
								<text id="register-email-label" class="field-label">邮箱</text>
								<input v-model="registerEmail" v-auth-input="{ labelledBy: 'register-email-label', autocomplete: 'email', inputmode: 'email', describedBy: registerError ? 'register-error' : '' }" class="auth-input" placeholder="输入常用邮箱" :maxlength="255" confirm-type="go" @confirm="registerEmail = $event.detail.value; submitRegister()" @input="registerError = ''; codeMessage = ''" />
							</view>
							<view class="input-wrapper">
								<text id="register-code-label" class="field-label">邮箱验证码</text>
								<view class="verification-code-container">
									<input v-model="registerVerificationCode" v-auth-input="{ labelledBy: 'register-code-label', autocomplete: 'one-time-code', inputmode: 'numeric', describedBy: registerError ? 'register-error' : 'code-hint' }" class="auth-input code-input" placeholder="输入验证码" :maxlength="10" confirm-type="go" @confirm="registerVerificationCode = $event.detail.value; submitRegister()" @input="registerError = ''" />
									<button class="code-button" :disabled="codeCountdown > 0 || sendCodeLoading" v-bind="h5Button(sendVerificationCode, codeCountdown > 0 || sendCodeLoading)" @tap="sendVerificationCode">{{ sendCodeLoading ? '正在发送…' : codeCountdown > 0 ? codeCountdown + ' 秒后重发' : '发送验证码' }}</button>
								</view>
								<text id="code-hint" class="field-hint" role="status" aria-live="polite">{{ codeMessage || '验证码会发送到上方邮箱，请留意收件箱。' }}</text>
							</view>
							<view class="input-wrapper">
								<text id="register-password-label" class="field-label">密码</text>
								<input v-model="registerPassword" v-auth-input="{ labelledBy: 'register-password-label', autocomplete: 'new-password', describedBy: registerError ? 'register-error' : '' }" class="auth-input" type="password" :password="true" placeholder="至少 6 位" :maxlength="128" confirm-type="go" @confirm="registerPassword = $event.detail.value; submitRegister()" @input="registerError = ''" />
							</view>
							<view class="input-wrapper">
								<text id="register-confirm-label" class="field-label">确认密码</text>
								<input v-model="registerPasswordConfirm" v-auth-input="{ labelledBy: 'register-confirm-label', autocomplete: 'new-password', describedBy: registerError ? 'register-error' : '' }" class="auth-input" type="password" :password="true" placeholder="再次输入密码" :maxlength="128" confirm-type="go" @confirm="registerPasswordConfirm = $event.detail.value; submitRegister()" @input="registerError = ''" />
							</view>
							<view class="protocol-hint">
								<view class="protocol-text-wrapper">
									<text>注册即表示同意</text>
									<button class="protocol-link" v-bind="h5Button(() => openProtocol('user'))" @tap="openProtocol('user')">《用户服务协议》</button>
									<text>和</text>
									<button class="protocol-link" v-bind="h5Button(() => openProtocol('privacy'))" @tap="openProtocol('privacy')">《隐私权政策》</button>
								</view>
							</view>
							<view v-if="registerError" id="register-error" class="error-message" role="alert">
								<text>{{ registerError }}</text>
								<button v-if="registerRetry" class="inline-retry" v-bind="h5Button(retryRegistration, registerLoading || sendCodeLoading)" @tap="retryRegistration">{{ registerRetry === 'code' ? '重试发送' : '重试注册' }}</button>
							</view>
							<button class="auth-button auth-submit" :disabled="registerLoading" :aria-busy="registerLoading" v-bind="h5Button(submitRegister, registerLoading)" @tap="submitRegister">{{ registerLoading ? '正在注册…' : '注册并登录' }}</button>
						</view>
					</view>
					<text class="footer-hint">以古老智慧，观当下生活</text>
				</view>
			</view>
		</view>
	</tm-app>
</template>

<script lang="ts" setup>
import { ref, computed, onMounted, onUnmounted } from 'vue';
import { onLoad } from '@dcloudio/uni-app';
import { useUserStore } from '@/store/user';
import { request } from '@/services/api/index';
import { sendEmailVerificationCode } from '@/config/emailVerification';
import { getDeviceId } from '@/utils/device';
import { sanitizeInput } from '@/utils/sanitize';
import { getSystemInfo } from '@/utils/platform';
import ProtocolReader from '@/components/auth/ProtocolReader.vue';
import type { ProtocolType } from '@/features/auth/protocols';
import { h5Button } from '@/utils/keyboard';
import { useWorkbenchTheme } from '@/features/workbench/theme';
import pagesConfig from '@/pages.json';

const { palette } = useWorkbenchTheme();

// Uni H5 puts arbitrary attributes on its outer wrapper, so name the editable input itself.
const vAuthInput = {
	mounted(element: HTMLElement, binding: Parameters<typeof setInputAccessibility>[1]) {
		setInputAccessibility(element, binding);
		// #ifdef H5
		const input = element.matches('input') ? element : element.querySelector('input');
		if (!input) return;
		let composing = false;
		let composingEnter = false;
		input.addEventListener('compositionstart', () => { composing = true; });
		input.addEventListener('compositionend', () => { composing = false; });
		input.addEventListener('keydown', (event) => {
			if (event.key === 'Enter') composingEnter = composing || event.isComposing;
		}, true);
		input.addEventListener('keyup', (event) => {
			if (event.key !== 'Enter') return;
			// Uni emits confirm without isComposing. Stop the candidate key before that emitter,
			// including IMEs that dispatch compositionend between Enter keydown and keyup.
			const confirmsCandidate = composing || event.isComposing || composingEnter;
			composingEnter = false;
			if (confirmsCandidate) {
				event.preventDefault();
				event.stopImmediatePropagation();
			}
		}, true);
		// #endif
	},
	updated: setInputAccessibility,
};
function setInputAccessibility(element: HTMLElement, binding: { value: { labelledBy: string; autocomplete: string; describedBy?: string; inputmode?: string } }) {
	// #ifdef H5
	const input = element.matches('input') ? element : element.querySelector('input');
	if (!input) return;
	input.setAttribute('aria-labelledby', binding.value.labelledBy);
	input.setAttribute('autocomplete', binding.value.autocomplete);
	if (binding.value.describedBy) input.setAttribute('aria-describedby', binding.value.describedBy);
	else input.removeAttribute('aria-describedby');
	if (binding.value.inputmode) input.setAttribute('inputmode', binding.value.inputmode);
	// #endif
}

const user_store = useUserStore();
const returnPath = ref('/pages/agent/index');
const returnRoutes = new Set(pagesConfig.pages.map(page => `/${page.path}`).filter(path => path !== '/pages/auth/auth'));

function resolveReturnPath(value: unknown): string {
	const fallback = '/pages/agent/index';
	if (typeof value !== 'string') return fallback;
	try {
		// Uni-app targets may pass decoded or still-encoded page query values.
		// Decode once, then accept only registered routes and known local options.
		const [path, query, extra] = decodeURIComponent(value).split('?');
		if (!returnRoutes.has(path) || extra !== undefined) return fallback;
		if (query === undefined) return path;
		if (path === '/pages/chat/index' && /^from=(bazi|ziwei|liuyao|qimen)$/.test(query)) return `${path}?${query}`;
		if (['/pages/index/index', '/pages/ziwei/index', '/pages/qimen/index'].includes(path) && query === 'edit=1') return `${path}?${query}`;
	} catch { /* Malformed paths use the normal home destination. */ }
	return fallback;
}

onLoad((options: Record<string, unknown>) => {
	returnPath.value = resolveReturnPath(options?.returnTo);
});

// 获取系统信息用于适配顶部安全区
const sysInfo = getSystemInfo();
const statusBarHeight = sysInfo.statusBarHeight || 20;
const protocolHeight = Math.max(180, (sysInfo.windowHeight || 700) - statusBarHeight - 210);
const activeProtocol = ref<ProtocolType | null>(null);

function goHome() {
	if (activeProtocol.value) {
		activeProtocol.value = null;
		return;
	}
	uni.reLaunch({
		url: '/pages/agent/index'
	});
}

const isLoggedIn = computed(() => user_store.isLoggedIn);

// 标签页切换
const currentTab = ref<'login' | 'register'>('login');

// 登录表单（支持邮箱或用户名）
const loginIdentifier = ref('');
const loginPassword = ref('');
const loginLoading = ref(false);
const loginError = ref('');
const loginCanRetry = ref(false);
// 移除记住密码功能


// 注册表单
const registerUsername = ref('');
const registerEmail = ref('');
const registerVerificationCode = ref('');
const registerPassword = ref('');
const registerPasswordConfirm = ref('');
const registerLoading = ref(false);
const registerError = ref('');
const registerRetry = ref<'register' | 'code' | null>(null);

// 验证码相关
const sendCodeLoading = ref(false);
const codeCountdown = ref(0);
const codeMessage = ref('');
let countdownTimer: any = null;

onMounted(() => {
	user_store.restoreAuth();
	
	// 如果已经登录了管理员账号，直接跳转到后台
	if (user_store.isAdmin) {
		uni.reLaunch({
			url: returnPath.value
		});
		return;
	}
});

function openProtocol(type: ProtocolType) {
	activeProtocol.value = type;
}

async function submitLogin(event?: { isComposing?: boolean; repeat?: boolean }) {
	if (loginLoading.value || event?.isComposing || event?.repeat) return;
	loginCanRetry.value = false;
	if (!loginIdentifier.value.trim() || !loginPassword.value) {
		loginError.value = '请输入账号和密码';
		return;
	}
	loginLoading.value = true;
	loginError.value = '';

	// 获取设备ID
	const deviceId = getDeviceId();
	const safeIdentifier = sanitizeInput(loginIdentifier.value, 255);
	// Passwords are opaque credentials; keep the same characters as registration.
	const safePassword = loginPassword.value.slice(0, 128);

	try {
		const res = await request('/api/auth/login', {
			method: 'POST',
			data: {
				identifier: safeIdentifier,
				password: safePassword,
				device_id: deviceId
			},
			sanitizeData: false
		});

		if (!res.success) {
			loginError.value = res.message || res.error || '登录失败，请稍后重试';
			loginCanRetry.value = true;
			return;
		}

		const payload: any = res.data || {};
		if (!payload.access_token) {
			loginError.value = res.message || '登录失败，请稍后重试';
			loginCanRetry.value = true;
			return;
		}

		const user = payload.user || {};
		user_store.setAuth({
			username: user?.username || null,
			email: user?.email,
			access_token: payload.access_token,
			refresh_token: payload.refresh_token,
			role: user?.role || 'user'
		});

		uni.showToast({
			title: '登录成功',
			icon: 'success',
			duration: 1500
		});
		setTimeout(() => {
			uni.reLaunch({
				url: returnPath.value
			});
		}, 600);
	} catch (err: any) {
		loginError.value = err?.message || '暂时无法连接，请检查网络后重试';
		loginCanRetry.value = true;
	} finally {
		loginLoading.value = false;
	}
}

// 发送验证码
async function sendVerificationCode() {
	if (sendCodeLoading.value || codeCountdown.value > 0) return;
	registerRetry.value = null;
	if (!registerEmail.value) {
		registerError.value = '请先输入邮箱地址';
		return;
	}
	
	// 简单的邮箱格式验证
	const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
	if (!emailRegex.test(registerEmail.value.trim())) {
		registerError.value = '邮箱格式不正确';
		return;
	}
	
	sendCodeLoading.value = true;
	registerError.value = '';
	codeMessage.value = '';
	
	try {
		const result = await sendEmailVerificationCode(registerEmail.value, 'register');
		if (result.success) {
			codeMessage.value = result.message || '验证码已发送到您的邮箱';
			uni.showToast({
				title: result.message || '验证码已发送到您的邮箱',
				icon: 'success',
				duration: 2000
			});
			
			// 开始倒计时（60秒）
			codeCountdown.value = 60;
			if (countdownTimer) clearInterval(countdownTimer);
			countdownTimer = setInterval(() => {
				codeCountdown.value--;
				if (codeCountdown.value <= 0) {
					clearInterval(countdownTimer);
					countdownTimer = null;
				}
			}, 1000);
		}
	} catch (error: any) {
		registerError.value = error.message || '发送验证码失败，请稍后重试';
		registerRetry.value = 'code';
		uni.showToast({
			title: error.message || '发送失败',
			icon: 'none',
			duration: 2000
		});
	} finally {
		sendCodeLoading.value = false;
	}
}

function retryRegistration() {
	if (registerRetry.value === 'code') void sendVerificationCode();
	else if (registerRetry.value === 'register') void submitRegister();
}

async function submitRegister(event?: { isComposing?: boolean; repeat?: boolean }) {
	if (registerLoading.value || event?.isComposing || event?.repeat) return;
	registerRetry.value = null;
	const safeUsername = sanitizeInput(registerUsername.value, 50);
	const safeEmail = sanitizeInput(registerEmail.value, 255);
	// 密码不应进行字符清理，只做长度截取
	const safePassword = registerPassword.value.slice(0, 128);
	const safePasswordConfirm = registerPasswordConfirm.value.slice(0, 128);
	const safeCode = sanitizeInput(registerVerificationCode.value, 10);

	if (!safeUsername || !safeEmail || !safePassword) {
		registerError.value = '请输入用户名、邮箱和密码';
		return;
	}
	if (!safeCode) {
		registerError.value = '请输入邮箱验证码';
		return;
	}
	if (safeUsername.length < 2) {
		registerError.value = '用户名长度不能少于 2 个字符';
		return;
	}
	if (safePassword.length < 6) {
		registerError.value = '密码长度不能少于 6 位';
		return;
	}
	if (safePasswordConfirm !== safePassword) {
		registerError.value = '两次输入的密码不一致';
		return;
	}
	
	// 注册接口在同一事务内验证验证码并创建账号。
	registerLoading.value = true;
	registerError.value = '';
	const deviceId = getDeviceId();
	try {
		const res = await request('/api/auth/register', {
			method: 'POST',
			data: {
				username: safeUsername,
				email: safeEmail,
				verification_code: safeCode,
				password: safePassword,
				device_id: deviceId
			},
			sanitizeData: false
		});

		if (!res.success) {
			registerError.value = res.message || res.error || '注册失败，请稍后重试';
			registerRetry.value = 'register';
			return;
		}

		const payload: any = res.data || {};
		if (!payload.access_token) {
			registerError.value = res.message || '注册失败，请稍后重试';
			registerRetry.value = 'register';
			return;
		}

		const user = payload.user || {};
		user_store.setAuth({
			username: user?.username || registerUsername.value,
			email: user?.email || registerEmail.value,
			access_token: payload.access_token,
			refresh_token: payload.refresh_token,
			role: user?.role || 'user'
		});
		uni.showToast({
			title: '注册并登录成功',
			icon: 'success',
			duration: 1500
		});
		setTimeout(() => {
			uni.reLaunch({
				url: returnPath.value
			});
		}, 600);
	} catch (err: any) {
		registerError.value = err?.message || '暂时无法连接，请检查网络后重试';
		registerRetry.value = 'register';
	} finally {
		registerLoading.value = false;
	}
}

function goBack() {
	uni.navigateBack();
}



async function logout() {
	await user_store.logout();
	uni.showToast({
		title: '已退出登录',
		icon: 'none',
		duration: 1200
	});
}

// 清理倒计时定时器
onUnmounted(() => {
	if (countdownTimer) {
		clearInterval(countdownTimer);
		countdownTimer = null;
	}
});
</script>

<style scoped>
.page-wrapper { min-height: 100dvh; background: var(--x-bg); color: var(--x-ink); }
.top-status-bar { width: 100%; }
.top-nav-bar { max-width: 1120px; margin: 0 auto; padding: 12px 24px; }
.nav-back-btn { display: inline-flex; flex-direction: row; align-items: center; gap: 8px; padding: 8px 2px; background: transparent; color: var(--x-body); font-size: 14px; border: 0; cursor: pointer; }
.page-content-scale { padding: 12px 20px 40px; }
.login-container { width: 100%; max-width: 440px; margin: 0 auto; }
.header-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 28px; text-align: center; }
.logo-wrapper { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; border-radius: 18px; background: var(--x-gradient); color: #fff; font-size: 36px; }
.auth-brand { margin: 14px 0 6px; color: var(--x-ink); font: 600 28px/1.5 var(--x-serif); letter-spacing: 2px; }
.auth-intro, .auth-description, .footer-hint { color: var(--x-muted); font-size: 13px; line-height: 1.8; }
.login-card, .user-info-card { width: 100%; box-sizing: border-box; padding: 28px; border: 1px solid var(--x-line); border-radius: 18px; background: var(--x-paper); box-shadow: 0 12px 40px #233e4908; }
.tab-switcher { display: flex; flex-direction: row; gap: 6px; padding: 4px; margin-bottom: 26px; background: var(--x-bg); border-radius: 10px; }
.tab-item { flex: 1; padding: 10px; border: 0; border-radius: 8px; background: transparent; color: var(--x-muted); font-size: 14px; cursor: pointer; }
.tab-item.active { background: var(--x-paper); color: var(--x-accent); font-weight: 600; box-shadow: 0 2px 7px #233e490a; }
.auth-heading { display: block; color: var(--x-ink); font-size: 19px; font-weight: 600; line-height: 1.6; }
.auth-description { display: block; margin-top: 5px; }
.input-wrapper { display: flex; flex-direction: column; gap: 8px; width: 100%; margin-top: 20px; }
.field-label { display: block; color: var(--x-body); font-size: 13px; font-weight: 600; line-height: 1.5; }
.auth-input { display: block; box-sizing: border-box; width: 100%; height: 46px; min-height: 46px; padding: 0 13px; border: 1px solid var(--x-line); border-radius: 9px; background: var(--x-paper); color: var(--x-ink); font-size: 14px; line-height: 46px; }
.auth-input:focus-within { border-color: var(--x-accent); outline: 2px solid var(--x-tint); outline-offset: 1px; }
.auth-input :deep(input) { font: inherit; color: inherit; }
.verification-code-container { display: flex; flex-direction: row; align-items: center; gap: 10px; min-width: 0; }
.code-input { flex: 1; min-width: 0; width: 0; }
.code-button { display: flex; align-items: center; justify-content: center; min-width: 114px; height: 46px; padding: 0 10px; border: 1px solid var(--x-line); border-radius: 9px; background: var(--x-tint); color: var(--x-accent); font-size: 12px; white-space: nowrap; cursor: pointer; }
.field-hint { color: var(--x-muted); font-size: 12px; line-height: 1.7; }
.auth-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 46px; padding: 12px 16px; border: 0; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; }
.auth-submit { margin-top: 24px !important; background: var(--x-gradient); color: #fff; }
.auth-secondary { margin-top: 12px !important; background: var(--x-bg); color: var(--x-body); border: 1px solid var(--x-line); }
.auth-button[aria-disabled='true'], .code-button[aria-disabled='true'] { opacity: .65; cursor: wait; }
.error-message { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-top: 18px; padding: 12px 14px; border: 1px solid #eccbcb; border-radius: 9px; background: #fff5f5; color: #a53232; font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }
.inline-retry { padding: 3px 0; border: 0; background: transparent; color: #a53232; font-size: 13px; font-weight: 600; text-decoration: underline; cursor: pointer; }
.protocol-hint { margin-top: 20px; }
.protocol-text-wrapper { display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 4px; color: var(--x-muted); font-size: 12px; line-height: 1.8; }
.protocol-link { display: inline-flex; padding: 4px 0; border: 0; background: transparent; color: var(--x-accent); font-size: 12px; cursor: pointer; }
.footer-hint { display: block; margin-top: 22px; text-align: center; font-size: 12px; }
.user-header { text-align: center; }
.page-wrapper [role='button']:focus-visible { outline: 2px solid var(--x-accent); outline-offset: 3px; }
@media (max-width: 480px) { .top-nav-bar { padding: 8px 20px; } .page-content-scale { padding-top: 4px; } .header-section { margin-bottom: 22px; } .login-card, .user-info-card { padding: 22px 20px; } }
@media (max-width: 360px) { .page-content-scale { padding-inline: 12px; } .login-card, .user-info-card { padding-inline: 16px; } .code-button { min-width: 102px; padding-inline: 7px; } }
</style>
