<template>
	<view class="palace-content" :class="{ expanded, 'highlight-bg': isHighlighted }">
		<view class="palace-heading"><text class="palace-name">{{ displayPalaceName(palace.name) }}</text><text class="palace-branch">{{ palace.heavenlyStem }}{{ palace.earthlyBranch }}</text></view>
		<view class="major-stars">
			<view v-for="star in palace.majorStars" :key="star.name" class="star-row">
				<text class="major-star">{{ star.name }}</text><text v-if="star.brightness" class="brightness">{{ star.brightness }}</text><text v-if="star.mutagen" class="mutagen" :class="{ caution: star.mutagen === '忌' }">{{ star.mutagen }}</text>
				<text v-for="tag in scopeMutagenTags(star.name)" :key="tag.label" class="scope-tag">{{ tag.label }}</text>
			</view>
			<text v-if="!palace.majorStars?.length" class="no-major">无主星</text>
		</view>
		<view v-if="dynamicLabels?.length" class="dynamic-labels"><text v-for="label in visibleLabels" :key="label.type" class="scope-tag">{{ label.text }}</text></view>
		<view class="palace-footer"><text>{{ palace.decadal?.range?.join('–') }} 岁</text><text v-if="palace.isBodyPalace" class="body-tag">身宫</text><text v-else>{{ palace.changsheng12 }}</text></view>
		<view v-if="flyMutagenTags.length" class="fly-tags"><text v-for="tag in flyMutagenTags" :key="tag">{{ tag }}</text></view>
		<template v-if="expanded">
			<view class="detail-section"><text class="detail-label">辅星</text><view class="detail-stars"><view v-for="star in palace.minorStars" :key="star.name" class="star-row"><text>{{ star.name }}</text><text v-if="star.brightness" class="brightness">{{ star.brightness }}</text><text v-if="star.mutagen" class="mutagen">{{ star.mutagen }}</text><text v-for="tag in scopeMutagenTags(star.name)" :key="tag.label" class="scope-tag">{{ tag.label }}</text></view><text v-if="!palace.minorStars?.length" class="empty-copy">无</text></view></view>
			<view class="detail-section"><text class="detail-label">杂曜</text><view class="detail-stars"><text v-for="star in palace.adjectiveStars" :key="star.name" class="minor-chip">{{ star.name }}</text><text v-if="!palace.adjectiveStars?.length" class="empty-copy">无</text></view></view>
			<view v-if="dynamicStars?.length" class="detail-section"><text class="detail-label">运限星曜</text><view class="detail-stars"><text v-for="star in dynamicStars" :key="star" class="minor-chip">{{ star }}</text></view></view>
			<view class="detail-section detail-meta"><text class="detail-label">长生十二神</text><text>{{ palace.changsheng12 || '—' }}</text><text class="detail-label">博士十二神</text><text>{{ palace.boshi12 || '—' }}</text><text class="detail-label">将前 / 岁前</text><text>{{ displayJiangqian12 }} / {{ displaySuiqian12 }}</text><text class="detail-label">小限年龄</text><text class="ages">{{ palace.ages?.join('、') || '—' }}</text></view>
		</template>
		<view v-else class="palace-expand" v-bind="h5Button(() => emit('expand'))" :aria-label="'放大查看' + displayPalaceName(palace.name)" @tap.stop="emit('expand')">详情 <text aria-hidden="true">↗</text></view>
	</view>
</template>
<script lang="ts" setup>
import { computed } from 'vue';
import { h5Button } from '@/utils/keyboard';
const props = defineProps<{ palace: any; displayJiangqian12?: string; displaySuiqian12?: string; dynamicLabels?: Array<{ text: string; type: string }>; activeScope?: string; dynamicStars?: string[]; flyMutagens?: string[]; scopeMutagens?: Record<string, Array<{ scope: string; label: string }>>; isHighlighted?: boolean; expanded?: boolean }>();
const emit = defineEmits<{ (event: 'expand'): void }>();
const displayPalaceName = (name: string | undefined) => name === '仆役' ? '交友' : name || '';
const displayJiangqian12 = computed(() => props.displayJiangqian12 || props.palace?.jiangqian12 || '—');
const displaySuiqian12 = computed(() => props.displaySuiqian12 || props.palace?.suiqian12 || '—');
const scopeMutagenTags = (name: string) => props.scopeMutagens?.[name] || [];
const visibleLabels = computed(() => props.expanded ? props.dynamicLabels : props.dynamicLabels?.filter(label => label.type === props.activeScope));
const flyMutagenTags = computed(() => (props.flyMutagens || []).filter(Boolean));
</script>
<style scoped>
.palace-content { width: 100%; height: 100%; box-sizing: border-box; min-width: 0; padding: 12px; display: flex; flex-direction: column; gap: 8px; position: relative; color: var(--x-ink,#233e49); font-size: 13px; line-height: 1.5; }
.palace-heading,.palace-footer { display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 4px; min-width: 0; }
.palace-name { font-size: 12px; font-weight: 600; white-space: nowrap; }
.palace-branch,.palace-footer { color: var(--x-muted,#6b7f87); font-size: 10px; }
.major-stars { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
.star-row { display: flex; flex-direction: row; align-items: baseline; flex-wrap: wrap; gap: 4px; }
.major-star { font-family: var(--x-serif,serif); font-size: 17px; line-height: 1.6; font-weight: 500; }
.brightness { color: var(--x-muted,#6b7f87); font-size: 10px; }
.mutagen { display: inline-flex; padding: 0 4px; border-radius: 4px; background: #e8f4ee; color: #377356; font-size: 10px; line-height: 17px; }
.mutagen.caution { color: #986036; background: #fff2e7; }
.no-major,.empty-copy { color: var(--x-muted,#6b7f87); font-size: 12px; }
.dynamic-labels,.fly-tags,.detail-stars { display: flex; flex-direction: row; flex-wrap: wrap; gap: 5px; }
.scope-tag,.body-tag { color: var(--x-accent,#167c8d); font-size: 10px; }
.fly-tags { font-size: 10px; color: #966f38; }
.palace-expand { align-self: flex-end; display: inline-flex; flex-direction: row; align-items: center; gap: 6px; padding: 3px 0 1px 8px; min-height: 24px; font-size: 10px; color: var(--x-muted,#6b7f87); cursor: pointer; }
.palace-expand:focus-visible { outline: 2px solid var(--x-accent,#167c8d); outline-offset: 3px; border-radius: 4px; }
.expanded { height: auto; padding: 0; gap: 18px; font-size: 13px; }
.expanded .palace-heading { padding-bottom: 14px; border-bottom: 1px solid var(--x-line,#dbe9ed); }
.expanded .palace-name { font-size: 20px; font-family: var(--x-serif,serif); }
.expanded .palace-branch { font-size: 12px; }
.expanded .major-stars { flex-direction: row; flex-wrap: wrap; gap: 18px; }
.expanded .major-star { font-size: 19px; }
.expanded .palace-footer { justify-content: flex-start; gap: 16px; font-size: 12px; }
.detail-section { display: flex; flex-direction: column; gap: 10px; padding-top: 16px; border-top: 1px solid var(--x-line,#dbe9ed); }
.detail-label { font-size: 11px; color: var(--x-muted,#6b7f87); }
.detail-stars { gap: 8px 12px; }
.minor-chip { background: var(--x-tint,#f0f7f8); border-radius: 5px; padding: 2px 6px; font-size: 12px; }
.detail-meta { display: grid; grid-template-columns: 76px minmax(0,1fr); gap: 10px 12px; align-items: baseline; }
.ages { font-size: 12px; line-height: 1.9; overflow-wrap: anywhere; }
@media(max-width:600px) { .palace-content:not(.expanded) { padding: 8px 5px; gap: 7px; } .palace-content:not(.expanded) .palace-heading { flex-wrap: wrap; } .palace-content:not(.expanded) .major-star { font-size: 14px; } .palace-content:not(.expanded) .star-row { gap: 2px; } .palace-content:not(.expanded) .palace-name { font-size: 11px; } .palace-content:not(.expanded) .palace-branch { font-size: 9px; } .palace-content:not(.expanded) .palace-footer { flex-wrap: wrap; font-size: 9px; } }
</style>
