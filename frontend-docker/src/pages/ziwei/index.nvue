<template>
	<tm-app>
		<PageScaffold
			class="page-ziwei-input"
			title="紫微排盘"
			subtitle="以出生时刻安星定宫，探索命宫、星曜与人生的不同面向。"
			tag="ZIWEI · STAR CHART"
		>
			<view class="form-steps" aria-label="排盘流程">
				<view class="form-step current"
					><text class="step-number">1</text><text>填写信息</text></view
				>
				<view class="form-step"><text class="step-number">2</text><text>查看命盘</text></view>
				<view class="form-step"><text class="step-number">3</text><text>深入解读</text></view>
			</view>
			<view class="birth-form-layout">
				<view class="birth-form-panel">
					<view class="form-section">
						<view class="form-section-heading"
							><text class="section-mark">人</text
							><text class="form-section-title">基本信息</text></view
						>
						<view class="birth-field-grid">
							<view class="birth-field">
								<text class="field-label">称呼<text class="field-optional">选填</text></text>
								<input
									v-model="realname"
									class="birth-name-input"
									placeholder="怎么称呼你？"
									:maxlength="30"
									aria-label="称呼"
								/>
							</view>
							<view class="birth-field">
								<text class="field-label">性别</text>
								<view class="birth-segmented" role="group" aria-label="性别">
									<button
										v-bind="h5Button(() => (gender = 0))"
										class="birth-segment"
										:class="{ selected: Number(gender) === 0 }"
										:aria-pressed="Number(gender) === 0"
										@tap="gender = 0"
									>
										男
									</button>
									<button
										v-bind="h5Button(() => (gender = 1))"
										class="birth-segment"
										:class="{ selected: Number(gender) === 1 }"
										:aria-pressed="Number(gender) === 1"
										@tap="gender = 1"
									>
										女
									</button>
								</view>
							</view>
						</view>
					</view>
					<view class="form-section">
						<view class="form-section-heading"
							><text class="section-mark">时</text
							><text class="form-section-title">出生时间</text></view
						>
						<view class="birth-field-grid">
							<view class="birth-field full">
								<text class="field-label">历法</text>
								<view class="birth-segmented" role="group" aria-label="出生日期历法">
									<button
										v-bind="h5Button(() => (model = 0))"
										class="birth-segment"
										:class="{ selected: model === 0 }"
										:aria-pressed="model === 0"
										@tap="model = 0"
									>
										阳历（公历）
									</button>
									<button
										v-bind="h5Button(() => (model = 1))"
										class="birth-segment"
										:class="{ selected: model === 1 }"
										:aria-pressed="model === 1"
										@tap="model = 1"
									>
										阴历（农历）
									</button>
								</view>
							</view>
							<view class="birth-field full">
								<text class="field-label"
									>出生日期与时间<text class="field-optional">{{
										model === 0 ? '精确到分钟' : '农历日期、闰月与钟点'
									}}</text></text
								>
								<button v-bind="h5Button(SelectTime)" class="birth-time-control" @tap="SelectTime">
									<text class="birth-selected-time">{{
										datetime_label || '请选择出生日期与时间'
									}}</text>
									<text class="birth-edit-label">修改 ›</text>
								</button>
								<text class="birth-time-hint">{{
									model === 0
										? '按出生地当时的钟表时间填写。'
										: '请区分普通月与闰月，并核对对应公历。'
								}}</text>
							</view>
						</view>
						<view v-if="lunar_label" class="birth-summary">
							<view class="birth-summary-row"
								><text class="birth-summary-label">{{ model === 0 ? '对应农历' : '对应公历' }}</text
								><text class="birth-summary-value">{{ lunar_label }}</text></view
							>
						</view>
						<view class="time-settings">
							<button
								class="time-settings-toggle"
								v-bind="h5Button(() => (timeSettingsOpen = !timeSettingsOpen))"
								:aria-expanded="timeSettingsOpen"
								aria-controls="birth-time-settings"
								@tap="timeSettingsOpen = !timeSettingsOpen"
							>
								<view class="time-settings-label"
									><text>时间设置</text
									><text class="time-settings-summary"
										>{{ timeZoneLabel
										}}<text v-if="overlapChoice !== 'reject'">
											· {{ overlapChoice === 'earlier' ? '较早的一次' : '较晚的一次' }}</text
										></text
									></view
								>
								<text class="time-settings-action">{{
									timeSettingsOpen ? '收起 −' : '调整 ＋'
								}}</text>
							</button>
							<view v-if="timeSettingsOpen" id="birth-time-settings" class="time-settings-body">
								<view class="birth-field">
									<text class="field-label">出生地时区</text>
									<picker
										ref="timeZonePicker"
										:range="timeZoneOptions"
										:value="timeZones.indexOf(timeZone)"
										@change="changeTimeZone"
									>
										<view
											class="time-zone-control"
											v-bind="h5Button(openTimeZonePicker)"
											:aria-label="'选择出生地时区，当前' + timeZoneLabel"
											aria-haspopup="dialog"
											><view class="time-zone-value"
												><text>{{ timeZoneLabel }}</text
												><text class="time-zone-id">{{ timeZone }}</text></view
											><text>⌄</text></view
										>
									</picker>
								</view>
								<view class="birth-field">
									<text class="field-label">夏令时重复时刻</text>
									<view class="birth-segmented" role="group" aria-label="夏令时重复时间选择">
										<button
											v-for="(label, index) in ['遇到时提醒', '较早的一次', '较晚的一次']"
											:key="label"
											class="birth-segment"
											:class="{ selected: overlapChoice === overlapChoices[index] }"
											:aria-pressed="overlapChoice === overlapChoices[index]"
											v-bind="h5Button(() => changeOverlapChoice(overlapChoices[index]))"
											@tap="changeOverlapChoice(overlapChoices[index])"
										>
											{{ label }}
										</button>
									</view>
								</view>
								<text class="birth-time-hint"
									>自动处理历史夏令时；钟表拨回造成时间重复时，请确认是哪一次。不校正真太阳时。</text
								>
							</view>
						</view>
					</view>
					<view class="birth-form-bottom">
						<text class="birth-time-hint">确认后生成命盘，继续查看星曜与解读。</text>
						<button
							v-bind="h5Button(Submit, !canSubmit)"
							class="birth-submit"
							:disabled="!canSubmit"
							@tap="Submit"
						>
							开始排盘　→
						</button>
					</view>
				</view>
				<view class="form-help">
					<text class="help-title">填写小贴士</text>
					<text class="help-copy">准确的出生时间，是排盘的起点。</text>
					<view class="help-list">
						<text class="help-item">核对历法：阳历或阴历，农历留意闰月。</text>
						<text class="help-item">核对钟点：可查出生证明，或向家人确认。</text>
						<text class="help-item">海外出生：在“时间设置”选择出生地时区。</text>
					</view>
					<navigator class="help-link" url="/pages/agent/index">不确定怎么填？问问 AI　→</navigator>
				</view>
			</view>
		</PageScaffold>
		<view v-if="birthEditorOpen" class="birth-editor-mask">
			<view
				id="ziwei-birth-editor"
				ref="birthEditorRoot"
				class="birth-editor"
				role="dialog"
				aria-modal="true"
				aria-labelledby="birth-editor-title"
			>
				<view class="birth-editor-heading"
					><text id="birth-editor-title" class="form-section-title"
						>{{ model === 0 ? '公历' : '农历' }}出生时间</text
					><text class="birth-time-hint">{{ timeZoneLabel }} · 按出生地钟表时间填写</text></view
				>
				<view class="birth-editor-fields">
					<view class="birth-field"
						><text class="field-label">日期 · 年-月-日</text
						><input
							v-model="birthDateDraft"
							class="birth-name-input"
							aria-label="出生日期 年月日"
							:aria-invalid="!!birthEditorError"
							aria-describedby="birth-editor-hint birth-editor-error"
							placeholder="例如 2023-02-15"
							:maxlength="10"
					/></view>
					<view class="birth-field"
						><text class="field-label">时间 · 24 小时制</text
						><input
							v-model="birthClockDraft"
							class="birth-name-input"
							aria-label="出生钟表时间"
							:aria-invalid="!!birthEditorError"
							aria-describedby="birth-editor-hint birth-editor-error"
							placeholder="例如 23:00"
							:maxlength="5"
					/></view>
				</view>
				<view v-if="model === 1" class="birth-field"
					><text class="field-label">农历月份类型</text
					><view class="birth-segmented" role="group" aria-label="农历月份类型">
						<button
							class="birth-segment"
							:class="{ selected: !birthLeapDraft }"
							:aria-pressed="!birthLeapDraft"
							v-bind="h5Button(() => (birthLeapDraft = false))"
							@tap="birthLeapDraft = false"
						>
							普通月
						</button>
						<button
							class="birth-segment"
							:class="{ selected: birthLeapDraft }"
							:aria-pressed="birthLeapDraft"
							v-bind="h5Button(() => (birthLeapDraft = true))"
							@tap="birthLeapDraft = true"
						>
							闰月
						</button>
					</view></view
				>
				<text id="birth-editor-hint" class="birth-time-hint"
					>23:00—23:59 为晚子时，按次日排盘。</text
				>
				<text
					v-if="birthEditorError"
					id="birth-editor-error"
					class="birth-editor-error"
					role="alert"
					>{{ birthEditorError }}</text
				>
				<view class="birth-editor-actions"
					><button
						class="birth-segment"
						v-bind="h5Button(closeBirthEditor)"
						@tap="closeBirthEditor"
					>
						取消</button
					><button class="birth-submit" v-bind="h5Button(applyBirthEditor)" @tap="applyBirthEditor">
						确认时间
					</button></view
				>
			</view>
		</view>
	</tm-app>
</template>
<script lang="ts" setup>
import { h5Button } from '@/utils/keyboard';
import { ref, computed, watch, nextTick } from 'vue';
import { onLoad, onShow } from '@dcloudio/uni-app';
import { Solar } from 'lunar-javascript';
import PageScaffold from '@/components/layout/PageScaffold.vue';

import { useUserStore } from '@/store/user';
import { civilToTimestamp, civilString, deviceTimeZone, zonedParts } from '@/utils/chartTime';
import type { Disambiguation } from '@/utils/chartTime';
import { lunarCivilToSolar } from '@/utils/ziweiCalendarInput';
import { useModalFocus } from '@/utils/useModalFocus';
import { useZiweiStore } from '@/store/ziwei';

const realname = ref('');
const gender = ref(0);
const model = ref(0);
const timeZone = ref('Asia/Shanghai');
const timeZones = [
	...new Set([
		'Asia/Shanghai',
		'Asia/Singapore',
		'Asia/Taipei',
		'Asia/Hong_Kong',
		'Asia/Tokyo',
		'America/New_York',
		'America/Los_Angeles',
		'Europe/London',
		'Australia/Sydney',
		'UTC',
		deviceTimeZone(),
	]),
];
const timeZoneNames: Record<string, string> = {
	'Asia/Shanghai': '北京',
	'Asia/Singapore': '新加坡',
	'Asia/Taipei': '台北',
	'Asia/Hong_Kong': '香港',
	'Asia/Tokyo': '东京',
	'America/New_York': '纽约',
	'America/Los_Angeles': '洛杉矶',
	'Europe/London': '伦敦',
	'Australia/Sydney': '悉尼',
	UTC: '协调世界时',
};
const timeZoneLabel = computed(() => timeZoneNames[timeZone.value] || timeZone.value);
const timeZoneOptions = timeZones.map((zone) =>
	timeZoneNames[zone] ? `${timeZoneNames[zone]} · ${zone}` : zone
);
const timeSettingsOpen = ref(false);
const timeZonePicker = ref<any>(null);
function openTimeZonePicker() {
	// #ifdef H5
	const target = timeZonePicker.value?.$el || timeZonePicker.value;
	target?.click?.();
	// #endif
}
const overlapChoices: Disambiguation[] = ['reject', 'earlier', 'later'];
const overlapChoice = ref<Disambiguation>('reject');
const birthEditorOpen = ref(false);
const birthDateDraft = ref('');
const birthClockDraft = ref('');
const birthLeapDraft = ref(false);
const birthEditorError = ref('');
const closeBirthEditor = () => {
	birthEditorOpen.value = false;
};
const birthEditorRoot = ref<any>(null);
useModalFocus(birthEditorOpen, birthEditorRoot, closeBirthEditor);
const timestamp = ref<number | null>(null);
const datetime_label = ref('');
const lunar_label = ref<string | null>(null);

const user_store = useUserStore();
const ziwei_store = useZiweiStore();
const recordId = ref<number | null>(null);

const canSubmit = computed(() => timestamp.value !== null);

watch(model, PullDatatimeLabel);
watch(timestamp, PullDatatimeLabel);
watch(timeZone, PullDatatimeLabel);

function changeOverlapChoice(choice: Disambiguation) {
	try {
		const civil =
			timestamp.value === null ? null : civilString(zonedParts(timestamp.value, timeZone.value));
		const nextTimestamp = civil ? civilToTimestamp(civil, timeZone.value, choice) : null;
		timestamp.value = nextTimestamp;
		overlapChoice.value = choice;
	} catch (error: any) {
		uni.showToast({ title: error.message, icon: 'none', duration: 3500 });
	}
}

function changeTimeZone(event: any) {
	const next = timeZones[Number(event.detail.value)];
	if (!next) return;
	try {
		const civil =
			timestamp.value === null ? null : civilString(zonedParts(timestamp.value, timeZone.value));
		const nextTimestamp = civil ? civilToTimestamp(civil, next, overlapChoice.value) : null;
		timeZone.value = next;
		timestamp.value = nextTimestamp;
	} catch (error: any) {
		uni.showToast({ title: error.message, icon: 'none', duration: 3500 });
	}
}

function initCurrentTime() {
	timestamp.value = new Date().getTime();
	PullDatatimeLabel();
}

let editDataProcessed = false;

onLoad((options: any) => {
	user_store.restoreAuth();

	const editDataStr = uni.getStorageSync('edit_ziwei_data');
	if (editDataStr) {
		try {
			const editData = JSON.parse(editDataStr);
			if (editData.isEdit && editData.timestamp) {
				realname.value = editData.realname || '';
				gender.value =
					editData.gender !== undefined && editData.gender !== null ? editData.gender : 0;
				timestamp.value = editData.timestamp;
				timeZone.value = editData.timeZone || deviceTimeZone();
				recordId.value = editData.recordId ?? null;
				editDataProcessed = true;
				uni.removeStorageSync('edit_ziwei_data');
				nextTick(() => {
					PullDatatimeLabel();
					uni.showToast({
						title:
							'\u5DF2\u52A0\u8F7D\u5F85\u7F16\u8F91\u4FE1\u606F\uFF0C\u8BF7\u786E\u8BA4\u540E\u91CD\u65B0\u6392\u76D8',
						icon: 'success',
						duration: 2000,
					});
				});
				return;
			}
		} catch (e) {
			console.warn('读取紫微排盘编辑数据失败', e);
			uni.removeStorageSync('edit_ziwei_data');
		}
	}

	realname.value = '';
	gender.value = 0;
	recordId.value = null;
	initCurrentTime();
});

onShow(() => {
	if (editDataProcessed) {
		editDataProcessed = false;
		return;
	}

	const editDataStr = uni.getStorageSync('edit_ziwei_data');
	if (editDataStr) {
		try {
			const editData = JSON.parse(editDataStr);
			if (editData.isEdit && editData.timestamp) {
				realname.value = editData.realname || '';
				gender.value =
					editData.gender !== undefined && editData.gender !== null ? editData.gender : 0;
				timestamp.value = editData.timestamp;
				timeZone.value = editData.timeZone || deviceTimeZone();
				recordId.value = editData.recordId ?? null;
				uni.removeStorageSync('edit_ziwei_data');
				nextTick(() => {
					PullDatatimeLabel();
				});
				return;
			}
		} catch (e) {
			console.warn('读取紫微排盘编辑数据失败', e);
			uni.removeStorageSync('edit_ziwei_data');
		}
	}
});

function SelectTime() {
	uni.hideKeyboard();
	const parts = zonedParts(timestamp.value ?? Date.now(), timeZone.value);
	const lunar = Solar.fromYmd(parts.year, parts.month, parts.day).getLunar();
	const pad = (n: number) => String(n).padStart(2, '0');
	birthDateDraft.value =
		model.value === 1
			? `${lunar.getYear()}-${pad(Math.abs(lunar.getMonth()))}-${pad(lunar.getDay())}`
			: civilString(parts).slice(0, 10);
	birthClockDraft.value = `${pad(parts.hour)}:${pad(parts.minute)}`;
	birthLeapDraft.value = lunar.getMonth() < 0;
	birthEditorError.value = '';
	birthEditorOpen.value = true;
}

function applyBirthEditor() {
	try {
		const civil =
			model.value === 1
				? lunarCivilToSolar(birthDateDraft.value, birthClockDraft.value, birthLeapDraft.value)
				: `${birthDateDraft.value} ${birthClockDraft.value}`;
		timestamp.value = civilToTimestamp(civil, timeZone.value, overlapChoice.value);
		birthEditorOpen.value = false;
	} catch (error: any) {
		birthEditorError.value = error.message;
	}
}

function PullDatatimeLabel() {
	const time = timestamp.value;
	if (time === null) return;
	const index = model.value;
	const parts = zonedParts(time, timeZone.value);
	const solar = Solar.fromYmdHms(
		parts.year,
		parts.month,
		parts.day,
		parts.hour,
		parts.minute,
		parts.second
	);
	const lunar = solar.getLunar();

	if (index === 0) {
		const date = civilString(parts).slice(0, 16).replace(/-/g, '/');
		datetime_label.value = date;
		lunar_label.value = `${lunar.toString()} ${lunar.getTimeZhi()}\u65F6`;
	} else {
		const lunarStr = `${lunar.toString()} ${lunar.getTimeZhi()}\u65F6`;
		datetime_label.value = lunarStr;
		const date = civilString(parts).slice(0, 16).replace(/-/g, '/');
		lunar_label.value = date;
	}
}

function Submit() {
	const datetime = timestamp.value;
	if (datetime === null) {
		uni.showToast({
			title: '\u8BF7\u5148\u9009\u62E9\u51FA\u751F\u65E5\u671F\u548C\u65F6\u95F4',
			icon: 'none',
			duration: 2000,
		});
		SelectTime();
		return;
	}

	const params = {
		realname: (realname.value || '').trim(),
		timestamp: datetime,
		gender: Number(gender.value),
		timeZone: timeZone.value,
		recordId: recordId.value,
	};

	uni.showLoading({
		title: '\u6392\u76D8\u4E2D\uFF0C\u8BF7\u7A0D\u540E',
	});

	try {
		ziwei_store.pull(params);

		setTimeout(() => {
			uni.hideLoading();

			if (!ziwei_store.astrolabe) {
				uni.showToast({
					title: '\u6392\u76D8\u6570\u636E\u4E0D\u5B8C\u6574\uFF0C\u8BF7\u91CD\u8BD5',
					icon: 'none',
					duration: 2000,
				});
				return;
			}

			uni.navigateTo({
				url: '/pages/ziwei/result',
				fail: (err) => {
					console.error('\u8DF3\u8F6C\u5931\u8D25:', err);
					uni.showToast({
						title: '\u8DF3\u8F6C\u5931\u8D25\uFF0C\u8BF7\u91CD\u8BD5',
						icon: 'none',
						duration: 2000,
					});
				},
			});
		}, 200);
	} catch (error: any) {
		uni.hideLoading();
		console.error('\u6392\u76D8\u5931\u8D25:', error);
		uni.showToast({
			title:
				'\u6392\u76D8\u8BA1\u7B97\u5931\u8D25\uFF1A' +
				(error?.message || '\u672A\u77E5\u9519\u8BEF'),
			icon: 'none',
			duration: 2000,
		});
	}
}
</script>
<style scoped>
.birth-editor-mask {
	position: fixed;
	inset: 0;
	z-index: 1100;
	background: #18333f66;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 18px;
	box-sizing: border-box;
}
.birth-editor {
	display: flex;
	flex-direction: column;
	gap: 18px;
	background: var(--x-paper, #fff);
	border: 1px solid var(--x-line, #dbe9ed);
	border-radius: 16px;
	padding: 24px;
	width: 440px;
	max-width: 100%;
	max-height: 85vh;
	box-sizing: border-box;
	overflow-y: auto;
	box-shadow: 0 16px 50px #18333f22;
}
.birth-editor-heading {
	display: flex;
	flex-direction: column;
	gap: 6px;
}
.birth-editor-fields {
	display: grid;
	grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
	gap: 12px;
}
.birth-editor-actions {
	display: flex;
	flex-direction: row;
	gap: 12px;
	padding-top: 16px;
	border-top: 1px solid var(--x-line, #dbe9ed);
}
.birth-editor-actions .birth-submit,
.birth-editor-actions .birth-segment {
	width: auto;
	min-width: 0;
	flex: 1 1 0;
	margin: 0;
}
.birth-editor-actions .birth-segment {
