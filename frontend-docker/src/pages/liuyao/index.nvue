<template>
	<tm-app>
		<PageScaffold
			class="page-liuyao-input"
			title="六爻起卦"
			subtitle="聚焦此刻的一件事，让问题更清晰，让选择更从容。"
			tag="LIUYAO · I CHING"
		>
			<view class="casting-steps" aria-label="排盘流程">
				<view class="casting-step current"
					><text class="casting-step-number">1</text><text>填写信息</text></view
				>
				<view class="casting-step"
					><text class="casting-step-number">2</text><text>查看卦象</text></view
				>
				<view class="casting-step"
					><text class="casting-step-number">3</text><text>深入解读</text></view
				>
			</view>
			<view class="casting-layout">
				<view class="casting-form-panel">
					<LiuyaoBasicInfo
						:title="form.title"
						:time-label="form.timeLabel"
						:time-source="timeSource"
						:gender="form.gender"
						@update:title="(val) => (form.title = val)"
						@update:gender="(val) => (form.gender = val)"
						@open-time-picker="openTimePicker"
						@use-now-time="useNowTime"
					/>
					<view class="method-section">
						<view class="method-heading"
							><text class="method-title">起卦方式</text
							><text class="method-caption">选择你熟悉的一种方式</text></view
						>
						<view class="method-options" role="group" aria-label="起卦方式">
							<MethodCard
								v-for="(method, index) in methodTabs"
								:key="method.key"
								:text="method.text"
								:icon="methodInfo[method.key]?.icon"
								:desc="methodInfo[method.key]?.desc"
								:active="methodIndex === index"
								@select="setMethod(index)"
							/>
						</view>
						<text class="method-description">{{ methodDesc }}</text>
						<view v-if="currentMethod.key === 'computer'" class="method-panel">
							<view class="method-action-row"
								><text class="method-guide">心中想好所问之事，生成本次卦象。</text
								><button
									v-bind="h5Button(generateAuto)"
									class="casting-button secondary"
									@tap="generateAuto"
								>
									{{ form.autoParams.length ? '重新生成' : '生成卦象' }}
								</button></view
							>
							<ParamPreview v-if="form.autoParams.length" :params="form.autoParams" />
						</view>
						<view v-else-if="currentMethod.key === 'online'" class="method-panel">
							<view class="online-casting" :class="{ 'online-active': onlineActive }">
								<text class="online-symbol">☷</text
								><text class="method-guide">专注所问之事，分六次摇出每一爻。</text>
								<button
									v-bind="h5Button(startOnlineShake, onlineActive || form.autoParams.length >= 6)"
									class="casting-button secondary"
									:disabled="onlineActive || form.autoParams.length >= 6"
									@tap="startOnlineShake"
								>
									{{ form.autoParams.length >= 6 ? '六爻已齐' : '开始在线摇卦' }}
								</button>
								<text class="casting-progress"
									>{{ onlineMsg || '等待第一次摇卦' }} · {{ form.autoParams.length }}/6</text
								>
							</view>
							<ParamPreview v-if="form.autoParams.length" :params="form.autoParams" />
						</view>
						<view v-else-if="currentMethod.key === 'manual'" class="method-panel">
							<text class="method-guide">按原始卦象选择六爻；初爻位于最下方。</text>
							<view class="manual-yao-list"
								><YaoSelector
									v-for="i in 6"
									:key="6 - i"
									v-model="form.manualParams[6 - i]"
									:options="yaoOptions"
									:label="getYaoLabel(6 - i)"
							/></view>
						</view>
						<view v-else-if="currentMethod.key === 'time'" class="method-panel">
							<view class="method-action-row"
								><text class="method-guide">按照上方选定的起卦时间生成卦象。</text
								><button
									v-bind="h5Button(generateTime)"
									class="casting-button secondary"
									@tap="generateTime"
								>
									生成参数
								</button></view
							>
							<ParamPreview v-if="form.timeParams.length" :params="form.timeParams" />
						</view>
						<view v-else-if="currentMethod.key === 'single'" class="method-panel">
							<view class="method-field"
								><text class="method-label">一组数字</text
								><input
									class="method-input"
									v-model="form.singleInput"
									type="number"
									:maxlength="12"
									placeholder="例如 2652"
									aria-label="单数起卦数字"
							/></view>
							<button
								v-bind="h5Button(generateSingle)"
								class="casting-button secondary method-generate"
								@tap="generateSingle"
							>
								生成参数
							</button>
							<ParamPreview v-if="form.singleParams.length" :params="form.singleParams" />
						</view>
						<view v-else-if="currentMethod.key === 'double'" class="method-panel">
							<view class="method-two-fields">
								<view class="method-field"
									><text class="method-label">第一组数字</text
									><input
										class="method-input"
										v-model="form.double1"
										type="number"
										:maxlength="12"
										placeholder="例如 26"
										aria-label="第一组数字"
								/></view>
								<view class="method-field"
									><text class="method-label">第二组数字</text
									><input
										class="method-input"
										v-model="form.double2"
										type="number"
										:maxlength="12"
										placeholder="例如 52"
										aria-label="第二组数字"
								/></view>
							</view>
							<button
								v-bind="h5Button(generateDouble)"
								class="casting-button secondary method-generate"
								@tap="generateDouble"
							>
								生成参数
							</button>
							<ParamPreview v-if="form.doubleParams.length" :params="form.doubleParams" />
						</view>
						<view v-else-if="currentMethod.key === 'chars'" class="method-panel">
							<view class="method-field"
								><text class="method-label">输入汉字</text
								><input
									class="method-input"
									v-model="form.charsInput"
									:maxlength="10"
									placeholder="请输入至少 2 个汉字，例如：合作"
									aria-label="汉字起卦文字"
							/></view>
							<button
								v-bind="h5Button(generateChars)"
								class="casting-button secondary method-generate"
								@tap="generateChars"
							>
								生成参数
							</button>
							<ParamPreview v-if="form.charsParams.length" :params="form.charsParams" />
						</view>
						<view v-else-if="currentMethod.key === 'gua'" class="method-panel">
							<view class="method-two-fields">
								<view class="method-field"
									><text class="method-label">本卦</text
									><picker
										mode="selector"
										:range="guaMarks"
										range-key="label"
										:value="guaMainIndex"
										ref="guaMainPicker"
										@change="onGuaMainChange"
										><view
											class="gua-picker"
											v-bind="h5Button(() => openGuaPicker(guaMainPicker))"
											:aria-label="'选择本卦，当前' + guaMainLabel"
											aria-haspopup="dialog"
											><text>{{ guaMainLabel || '请选择本卦' }}</text
											><text>⌄</text></view
										></picker
									></view
								>
								<view class="method-field"
									><text class="method-label">变卦 <text class="optional-hint">选填</text></text
									><picker
										mode="selector"
										:range="guaMarks"
										range-key="label"
										:value="guaBianIndex"
										ref="guaBianPicker"
										@change="onGuaBianChange"
										><view
											class="gua-picker"
											v-bind="h5Button(() => openGuaPicker(guaBianPicker))"
											:aria-label="'选择变卦，当前' + (guaBianLabel || '未指定')"
											aria-haspopup="dialog"
											><text>{{ guaBianLabel || '不指定变卦' }}</text
											><text>⌄</text></view
										></picker
									></view
								>
							</view>
							<button
								v-bind="h5Button(generateGua)"
								class="casting-button secondary method-generate"
								@tap="generateGua"
							>
								生成参数
							</button>
							<ParamPreview v-if="form.guaParams.length" :params="form.guaParams" />
						</view>
					</view>
					<view class="casting-form-bottom">
						<view class="casting-bottom-copy"
							><text class="casting-bottom-hint">{{
								canStart ? '卦象已准备好，可以开始排盘。' : '填写所问事项，并完成当前方式的起卦。'
							}}</text
							><button v-bind="h5Button(resetForm)" class="casting-reset-form" @tap="resetForm">
								重新填写
							</button></view
						>
						<button
							v-bind="h5Button(startLiuyao, !canStart)"
							class="casting-button primary"
							:disabled="!canStart"
							@tap="startLiuyao"
						>
							开始排盘　→
						</button>
					</view>
				</view>
				<view class="casting-help">
					<text class="help-decoration">✧</text><text class="help-title">把问题，问得更具体</text>
					<text class="help-copy"
						>六爻适合聚焦一件事。描述你正在面对的情况，以及你最想了解的部分。</text
					>
					<view class="help-list">
						<text class="help-item">01　一次只问一个具体问题。</text>
						<text class="help-item">02　起卦时间默认记录当前时刻，也可以修改为指定时间。</text>
						<text class="help-item">03　先完成六爻，再查看卦象与 AI 解读。</text>
					</view>
					<navigator class="help-link" url="/pages/agent/index">不确定怎么填？问问 AI　→</navigator>
				</view>
			</view>
		</PageScaffold>
		<DateTimeDialog v-if="timePickerShow" :date="timePickerDefault.split(' ')[0].replace(/\//g, '-')" :clock="timePickerDefault.split(' ')[1]?.slice(0,5) || '00:00'" title="起卦时间" subtitle="设备本地时间 · 精确到分钟" :allow-now="true" @now="useNowTime(); timePickerShow = false" @confirm="value => onTimeConfirm(value.date + ' ' + value.clock)" @close="timePickerShow = false" />
	</tm-app>
</template>
<script lang="ts" setup>
import { h5Button } from '@/utils/keyboard';
import { ref } from 'vue';
import { onLoad } from '@dcloudio/uni-app';
import PageScaffold from '@/components/layout/PageScaffold.vue';
import DateTimeDialog from '@/components/form/DateTimeDialog.vue';
import MethodCard from '@/components/liuyao/MethodCard.vue';
import ParamPreview from '@/components/liuyao/ParamPreview.vue';
import YaoSelector from '@/components/liuyao/YaoSelector.vue';
import LiuyaoBasicInfo from '@/components/liuyao/LiuyaoBasicInfo.vue';
import { useLiuyaoForm } from '@/features/liuyao/useLiuyaoForm';

const {
	form,
	timeSource,
	methodTabs,
	methodIndex,
	currentMethod,
	methodInfo,
	methodDesc,
	setMethod,
	yaoOptions,
	getYaoLabel,
	timePickerShow,
	timePickerDefault,
	openTimePicker,
	onTimeConfirm,
	useNowTime,
	generateAuto,
	generateTime,
	startOnlineShake,
	onlineActive,
	onlineMsg,
	generateSingle,
	generateDouble,
	generateChars,
	generateGua,
	startLiuyao,
	resetForm,
	canStart,
	guaMarks,
	guaMainIndex,
	guaBianIndex,
	guaMainLabel,
	guaBianLabel,
	onGuaMainChange,
	onGuaBianChange,
} = useLiuyaoForm();

const guaMainPicker = ref<any>(null);
const guaBianPicker = ref<any>(null);
function openGuaPicker(picker: any) {
	// #ifdef H5
	const target = picker?.$el || picker;
	target?.click?.();
	// #endif
}

onLoad(() => {
	useNowTime();
});
</script>
